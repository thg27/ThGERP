app MARCHLER-KUNDEN (
    name: Marchler – Kundenstammdaten
    version: 1.0.0
    logo {
        type: imageAndText
        imageUrl: #WORKSPACE_FILES#marchler-logo.svg
        text: Kundenstammdaten
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            js-defaultCollapsed
            js-navCollapsed--hidden
            t-TreeNav--classic
        ]
        list: @navigation-menu
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    authentication {
        scheme: @oracle-apex-accounts
    }
    authorization {
        sourceForRoleOrGroupSchemes: authenticationScheme
    }
    sessionManagement {
        maxSessionIdleTime: 3600
        maxSessionLength: 28800
    }
    sessionStateProtection {
        checksumSalt: 040F25C51E848B6E2D8EECB9159CE83364220686C554B9FC0E231ED5F7ED04C7
    }
    globalization {
        primaryLanguage: de
        documentDirection: leftToRight
    }
    runtime {
        allowFeedback: true
        compatibilityMode: 24.2
    }
)
