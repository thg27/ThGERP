    button cancel (
        buttonName: CANCEL
        label: Abbrechen
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button stammblatt (
        buttonName: STAMMBLATT
        label: Kundenstammblatt
        layout {
            sequence: 15
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-file-pdf-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 13
                items: {
                    P13_KUND_ID: &P11_KUND_ID.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_KUND_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Speichern
        layout {
            sequence: 20
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_KUND_ID
        }
    )

    button create (
        buttonName: CREATE
        label: Anlegen
        layout {
            sequence: 30
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P11_KUND_ID
        }
    )

    button up (
        buttonName: UP
        label: Zurück zur Kundenliste
        layout {
            sequence: 10
            region: @breadcrumb
            slot: up
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-arrow-up
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction typ-firma-privat (
        name: Felder je nach Typ ein-/ausblenden
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P11_KUND_TYP
        }
        clientSideCondition {
            type: item=value
            item: P11_KUND_TYP
            value: FIRMA
        }

        action firma-zeigen (
            action: show
            affectedElements {
                selectionType: items
                items: P11_KUND_FIRMENNAME,P11_KUND_RFRM_ID,P11_KUND_FIRMENBUCHNR
            }
            execution {
                sequence: 10
            }
        )

        action privat-verbergen (
            action: hide
            affectedElements {
                selectionType: items
                items: P11_KUND_ANREDE,P11_KUND_VORNAME,P11_KUND_NACHNAME
            }
            execution {
                sequence: 20
            }
        )

        action firma-verbergen (
            action: hide
            affectedElements {
                selectionType: items
                items: P11_KUND_FIRMENNAME,P11_KUND_RFRM_ID,P11_KUND_FIRMENBUCHNR
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
            }
        )

        action privat-zeigen (
            action: show
            affectedElements {
                selectionType: items
                items: P11_KUND_ANREDE,P11_KUND_VORNAME,P11_KUND_NACHNAME
            }
            execution {
                sequence: 40
                fireWhenEventResultIs: false
            }
        )

    )

    validation firmenname-pflicht (
        name: Firmenname bei Typ Firma
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P11_KUND_FIRMENNAME
        }
        error {
            errorMessage: Bitte den Firmennamen angeben.
            associatedItem: @P11_KUND_FIRMENNAME
        }
        serverSideCondition {
            type: item=value
            item: P11_KUND_TYP
            value: FIRMA
        }
    )

    validation nachname-pflicht (
        name: Nachname bei Typ Privat
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P11_KUND_NACHNAME
        }
        error {
            errorMessage: Bitte den Nachnamen angeben.
            associatedItem: @P11_KUND_NACHNAME
        }
        serverSideCondition {
            type: item=value
            item: P11_KUND_TYP
            value: PRIVAT
        }
    )


    validation konzernmutter-nicht-selbst (
        name: Konzernmutter nicht der Kunde selbst
        execution {
            sequence: 40
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 from dual where :P11_KUND_PARENT_KUND_ID = :P11_KUND_ID
                ```
        }
        error {
            errorMessage: Ein Kunde kann nicht seine eigene Konzernmutter sein.
            associatedItem: @P11_KUND_PARENT_KUND_ID
        }
    )

    process initialize-form-kunde (
        name: Formular Kunde initialisieren
        type: formInitialization
        formRegion: @kunde
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process titel-setzen (
        name: Seitentitel setzen
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P11_TITEL := case
                                  when :P11_KUND_ID is null then 'Neuer Kunde'
                                  else :P11_KUND_NUMMER || ' – ' ||
                                       case :P11_KUND_TYP
                                            when 'FIRMA' then :P11_KUND_FIRMENNAME
                                            else :P11_KUND_NACHNAME || nvl2(:P11_KUND_VORNAME, ' ' || :P11_KUND_VORNAME, null)
                                       end
                              end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
    )

    process process-form-kunde (
        name: Formular Kunde verarbeiten
        type: formAutoRowProcessing
        formRegion: @kunde
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Kunde gespeichert.
        }
    )

    branch zur-kundenliste (
        name: Zur Kundenliste
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 10
            }
        }
    )

)
