page 11 (
    name: Kunde
    alias: KUNDE
    title: Kunde
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: true
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        title: &P11_TITEL.
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region kunde (
        name: Kunde
        type: form
        source {
            location: localDatabase
            tableName: KUND_KUNDEN
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
        }
    )

    region stammdaten (
        name: Stammdaten
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @kunde
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
            cssClasses: [
                thg-kompakt
            ]
        }
    )

    region recht-konditionen (
        name: Rechtliches und Konditionen
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @kunde
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
            cssClasses: [
                thg-kompakt
            ]
        }
    )

    region konzern-sonstiges (
        name: Konzern und Sonstiges
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @kunde
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
            cssClasses: [
                thg-kompakt
            ]
        }
    )

    region audit (
        name: Änderungsinformationen
        type: staticContent
        layout {
            sequence: 40
            parentRegion: @kunde
            slot: regionBody
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
                t-Form--slimPadding
            ]
            cssClasses: [
                thg-kompakt
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_KUND_ID
        }
    )

    pageItem P11_TITEL (
        type: hidden
        layout {
            sequence: 5
            region: @kunde
            slot: regionBody
        }
    )

    pageItem P11_KUND_ID (
        type: hidden
        layout {
            sequence: 1
            region: @kunde
            slot: regionBody
        }
        source {
            formRegion: @kunde
            column: KUND_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P11_KUND_NUMMER (
        type: displayOnly
        label {
            label: Kundennummer
            alignment: left
        }
        layout {
            sequence: 10
            region: @stammdaten
            slot: regionBody
            alignment: left
            columnSpan: 2
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @kunde
            column: KUND_NUMMER
            dataType: varchar2
            queryOnly: true
        }
        default {
            type: static
            staticValue: wird beim Speichern vergeben
        }
    )

    pageItem P11_KUND_TYP (
        type: radioGroup
        label {
            label: Typ
            alignment: left
        }
        layout {
            sequence: 20
            region: @stammdaten
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            cssClasses: [
                thg-horizontal
            ]
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @kunde
            column: KUND_TYP
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @lov-kunden-typ
            displayNullValue: false
            displayExtraValues: false
        }
        default {
            type: static
            staticValue: FIRMA
        }
    )

    pageItem P11_KUND_STATUS (
        type: switch
        label {
            label: Aktiv
            alignment: left
        }
        layout {
            sequence: 30
            region: @stammdaten
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 1
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @kunde
            column: KUND_STATUS
            dataType: varchar2
        }
        settings {
            useDefaults: false
            onValue: AKTIV
            onLabel: Aktiv
            offValue: INAKTIV
            offLabel: Inaktiv
        }
        default {
            type: static
            staticValue: AKTIV
        }
    )

    pageItem P11_KUND_FIRMENNAME (
        type: textField
        label {
            label: Firmenname
            alignment: left
        }
        layout {
            sequence: 40
