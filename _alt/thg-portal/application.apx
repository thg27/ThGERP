app MARCHLER-PORTAL (
    name: Marchler Portal
    version: 1.0.0
    logo {
        type: imageAndText
        imageUrl: #WORKSPACE_FILES#marchler-logo.svg
        text: Portal
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            js-defaultCollapsed
            js-navCollapsed--hidden
            t-TreeNav--classic
        ]
        list: @navigation-menu
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    authentication {
        scheme: @oracle-apex-accounts
    }
    authorization {
        sourceForRoleOrGroupSchemes: authenticationScheme
    }
    sessionManagement {
        maxSessionIdleTime: 3600
        maxSessionLength: 28800
    }
    security {
        runtimeApiUsage: [
            modifyThisApp
            modifyOtherApps
        ]
    }
    sessionStateProtection {
        checksumSalt: 409269F6030B065120AAD219FB21E7F147F2229CC04B64096533503C5BD8B838
    }
    globalization {
        primaryLanguage: de
        documentDirection: leftToRight
    }
    runtime {
        allowFeedback: true
        compatibilityMode: 24.2
    }
)
