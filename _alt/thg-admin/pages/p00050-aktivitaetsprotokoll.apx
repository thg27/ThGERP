page 50 (
    name: Aktivitätsprotokoll
    alias: AKTIVITAETSPROTOKOLL
    title: Aktivitätsprotokoll
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        title: Aktivitätsprotokoll
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region aktivitaeten (
        name: Aktivitäten
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select l.VIEW_DATE,
                       l.APPLICATION_ID,
                       l.APPLICATION_NAME,
                       l.PAGE_ID,
                       l.PAGE_NAME,
                       lower(l.APEX_USER) as APEX_USER,
                       l.ELAPSED_TIME,
                       l.PAGE_VIEW_TYPE,
                       l.ERROR_MESSAGE
                  from APEX_WORKSPACE_ACTIVITY_LOG l
                 where l.APPLICATION_ID = :APP_ID
                    or l.APPLICATION_ID = 10000
                    or l.APPLICATION_ID in (select APPL_APEX_APP_ID from ADMIN_APPLIKATIONEN)
                 order by l.VIEW_DATE desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Keine Aktivitäten vorhanden.
        }

        column VIEW_DATE (
            type: plainText
            heading {
            heading: Zeitpunkt
            }
            layout {
            sequence: 10
            }
        appearance {
            formatMask: DD.MM.YYYY HH24:MI:SS
        }
            source {
                dataType: DATE
            }
        )

        column APPLICATION_ID (
            type: plainText
            heading {
            heading: App-ID
            alignment: end
            }
            layout {
            sequence: 20
            columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

        column APPLICATION_NAME (
            type: plainText
            heading {
            heading: Applikation
            }
            layout {
            sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column PAGE_ID (
            type: plainText
            heading {
            heading: Seite
            alignment: end
            }
            layout {
            sequence: 40
            columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

        column PAGE_NAME (
            type: plainText
            heading {
            heading: Seitenname
            }
            layout {
            sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column APEX_USER (
            type: plainText
            heading {
            heading: Benutzer
            }
            layout {
            sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column ELAPSED_TIME (
            type: plainText
            heading {
            heading: Dauer (s)
            alignment: end
            }
            layout {
            sequence: 70
            columnAlignment: end
            }
        appearance {
            formatMask: 999G990D0000
        }
            source {
                dataType: NUMBER
            }
        )

        column PAGE_VIEW_TYPE (
            type: plainText
            heading {
            heading: Aufruftyp
            }
            layout {
            sequence: 80
            }
            source {
                dataType: STRING
            }
        )

        column ERROR_MESSAGE (
            type: plainText
            heading {
            heading: Fehlermeldung
            }
            layout {
            sequence: 90
            }
            source {
                dataType: STRING
            }
        )

    )

    button up (
        buttonName: UP
        label: Zurück zur Administration
        layout {
            sequence: 10
            region: @breadcrumb
            slot: up
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-arrow-up
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset-report (
        buttonName: RESET_REPORT
        label: Zurücksetzen
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                t-Button--noUI
                t-Button--iconLeft
                t-Button--gapRight
            ]
            icon: fa-undo-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: &APP_PAGE_ID.
                clearCache: &APP_PAGE_ID.
                action: resetRegions
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)
