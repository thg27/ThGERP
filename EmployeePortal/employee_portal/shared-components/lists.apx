list navigation-bar (
    name: Navigation Bar

    entry --- (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select null as lvl,
                   'Home' as label,
                   'f?p=&APP_ID.:1:&APP_SESSION.::&DEBUG.:::' as target,
                   case when :APP_PAGE_ID = 1 then 'YES' else 'NO' end as is_current,
                   'fa-home' as icon_name,
                   null as icon_attrs,
                   null as icon_alt_text
              from dual
            union all
            select null as lvl,
                   'Person (' || (select count(*) from emp) || ')' as label,
                   'f?p=&APP_ID.:2:&APP_SESSION.::&DEBUG.:::' as target,
                   case when :APP_PAGE_ID = 2 then 'YES' else 'NO' end as is_current,
                   'fa-users' as icon_name,
                   null as icon_attrs,
                   null as icon_alt_text
              from dual
            ```
    }
)

