page 2 (
    name: Employee Directory
    alias: EMPLOYEE-DIRECTORY
    title: Employee Directory
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region EMP_DIR_RESULTS (
        name: Employees
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    e.empno as employee_id,
                    e.ename as employee_name,
                    e.job as job_title,
                    e.hiredate as hire_date,
                    to_char(e.hiredate, 'DD Mon YYYY') as hire_date_display,
                    d.deptno as department_id,
                    d.dname as department_name,
                    d.loc as location
                from emp e
                join dept d
                    on d.deptno = e.deptno
                ```
        }
        orderBy {
            type: staticValue
            orderByClause: department_name, employee_name
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            display: report
        }
        settings {
            overline: &DEPARTMENT_NAME.
            title: &EMPLOYEE_NAME.
            description: <strong>Location:</strong> &LOCATION.<br><strong>Hire Date:</strong> &HIRE_DATE_DISPLAY.
            displayAvatar: true
            displayBadge: true
        }
        plugin-avatar {
            type: icon
            icon: fa-user
            description: &EMPLOYEE_NAME.
            size: extraSmall
        }
        plugin-badge {
            label: Job
            value: JOB_TITLE
            shape: rounded
            size: medium
            style: subtle
            position: end
        }
        column EMPLOYEE_ID (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: EMPLOYEE_ID
                dataType: number
                primaryKey: true
            }
        )
        column EMPLOYEE_NAME (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: EMPLOYEE_NAME
                dataType: varchar2
            }
        )
        column JOB_TITLE (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: JOB_TITLE
                dataType: varchar2
            }
        )
        column HIRE_DATE (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: HIRE_DATE
                dataType: date
            }
        )
        column HIRE_DATE_DISPLAY (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: HIRE_DATE_DISPLAY
                dataType: varchar2
            }
        )
        column DEPARTMENT_ID (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: DEPARTMENT_ID
                dataType: number
            }
        )
        column DEPARTMENT_NAME (
            layout {
                sequence: 70
            }
            source {
                databaseColumn: DEPARTMENT_NAME
                dataType: varchar2
            }
        )
        column LOCATION (
            layout {
                sequence: 80
            }
            source {
                databaseColumn: LOCATION
                dataType: varchar2
            }
        )
    )

    region EMP_DIR_SEARCH (
        name: Search
        type: facetedSearch
        source {
            filteredRegion: @EMP_DIR_RESULTS
        }
        layout {
            sequence: 10
            slot: leftColumn
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        accessibility {
            landmarkLabel: Filters
        }
        settings {
            compactNosThreshold: 10000
            showCurrentFacets: true
            showTotalRowCount: true
        }
        facet P2_FACET_SEARCH (
            type: search
            label {
                label: Search
            }
            layout {
                sequence: 10
            }
            source {
                dbColumns: EMPLOYEE_NAME,JOB_TITLE
            }
        )
        facet P2_FACET_DEPARTMENT (
            type: checkboxGroup
            label {
                label: Department
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 20
            }
            listEntries {
                maxDisplayedEntries: 10
            }
            source {
                databaseColumn: DEPARTMENT_NAME
            }
        )
        facet P2_FACET_JOB (
            type: checkboxGroup
            label {
                label: Job
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 25
            }
            listEntries {
                maxDisplayedEntries: 10
            }
            source {
                databaseColumn: JOB_TITLE
            }
        )
        facet P2_FACET_HIRE_DATE (
            type: range
            label {
                label: Hire Date
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: HIRE_DATE
                dataType: date
            }
        )
    )

    region EMP_DIR_BREADCRUMB (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )
)
