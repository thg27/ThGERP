            label: MwSt. in %
            alignment: left
        }
        layout {
            sequence: 90
            region: @position
            slot: regionBody
            startNewRow: false
            columnSpan: 3
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @position
            column: RPOS_MWST_PROZENT
            dataType: number
        }
        validation {
