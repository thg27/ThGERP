        layout {
            sequence: 30
            region: @position
            slot: regionBody
            startNewRow: false
            columnSpan: 2
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @position
            column: RPOS_POSITION
            dataType: number
        }
    )

    pageItem P14_RPOS_NAME (
        type: textField
