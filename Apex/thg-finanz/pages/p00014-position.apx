        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @position
            column: RPOS_ARTI_ID
            dataType: number
        }
        lov {
            type: sharedComponent
            lov: @lov-artikel
            displayNullValue: true
            nullDisplayValue: - ohne Artikel -
        }
    )

    pageItem P14_RPOS_KAPITEL (
        type: textField
        label {
            label: Kapitel (gruppiert die Positionen)
            alignment: left
        }
        layout {
            sequence: 20
            region: @position
            slot: regionBody
            startNewRow: false
            columnSpan: 4
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @position
            column: RPOS_KAPITEL
            dataType: varchar2
