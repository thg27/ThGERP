page 14 (
    name: Position
    alias: POSITION
    title: Position
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1000
        chained: false
        resizable: true
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region position (
        name: Position
        type: form
        source {
            location: localDatabase
            tableName: FAKT_RECHNUNGSPOSITIONEN
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
        }
    )

    pageItem P14_RECH_ID (
        type: hidden
        layout {
            sequence: 3
            region: @position
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P14_RPOS_ID (
        type: hidden
        layout {
            sequence: 1
            region: @position
            slot: regionBody
        }
        source {
            formRegion: @position
            column: RPOS_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P14_RPOS_RECH_ID (
        type: hidden
        layout {
            sequence: 2
            region: @position
            slot: regionBody
        }
        source {
            formRegion: @position
            column: RPOS_RECH_ID
            dataType: number
        }
        default {
            type: item
            item: P14_RECH_ID
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P14_RPOS_ARTI_ID (
