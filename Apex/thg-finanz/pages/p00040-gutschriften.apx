page 40 (
    name: Gutschriften
    alias: GUTSCHRIFTEN
    title: Gutschriften
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        title: Gutschriften
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region facets (
        name: Facetten
        type: facetedSearch
        source {
            filteredRegion: @gutschriften
        }
        layout {
            sequence: 20
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            compactNosThreshold: 10000
            displayChartForTopNValues: 10
        }

        facet P40_SEARCH (
            type: search
            label {
                label: Suche
            }
            layout {
                sequence: 10
            }
        )

        facet P40_STATUS (
            type: checkboxGroup
            label {
                label: Status
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 20
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: STATUS
            }
        )

        facet P40_UEBERFAELLIG (
            type: checkboxGroup
            label {
                label: Überfällig
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 25
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: UEBERFAELLIG
            }
        )

        facet P40_JAHR (
            type: checkboxGroup
            label {
                label: Jahr
            }
            lov {
                type: distinctValues
                sortDirection: desc
            }
            layout {
                sequence: 30
            }
            listEntries {
                maxDisplayedEntries: 7
                sortByTopCounts: false
            }
            source {
                databaseColumn: JAHR
            }
        )

        facet P40_MONAT (
            type: checkboxGroup
            label {
                label: Monat
            }
            lov {
                type: distinctValues
                sortDirection: desc
            }
            layout {
                sequence: 35
            }
            listEntries {
                maxDisplayedEntries: 7
                sortByTopCounts: false
            }
            source {
                databaseColumn: MONAT
            }
            appearance {
                display: addFilterDialog
            }
        )

        facet P40_KUNDE (
            type: checkboxGroup
            label {
                label: Aussteller
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 40
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: AUSSTELLER
            }
        )

    )

    region gutschriften (
        name: Gutschriften
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.GUTS_ID,
                       coalesce(g.GUTS_INTERN_NUMMER, '(Entwurf)') as NUMMER,
                       g.GUTS_NUMMER as AUSSTELLER_NR,
                       g.GUTS_DATUM,
                       to_char(g.GUTS_DATUM, 'YYYY') as JAHR,
                       to_char(g.GUTS_DATUM, 'YYYY-MM') as MONAT,
                       FAKT_GUTSCHRIFT.status_text(g.GUTS_STATUS) as STATUS,
                       case when g.GUTS_STATUS = 'BEZAHLT' then 'fa-check-circle u-success-text'
                            when g.GUTS_STATUS = 'ENTWURF' then 'fa-pencil u-warning-text'
                            when g.GUTS_STATUS = 'GESENDET' then 'fa-paper-plane-o u-info-text'
                            when g.GUTS_FAELLIG_AM < trunc(sysdate) then 'fa-exclamation-triangle u-danger-text'
                            else 'fa-clock-o u-info-text' end as STATUS_ICON,
                       case when g.GUTS_STATUS = 'OFFEN' and g.GUTS_FAELLIG_AM < trunc(sysdate) then 'Ja' else 'Nein' end as UEBERFAELLIG,
                       k.KUND_NUMMER,
                       coalesce(k.KUND_FIRMENNAME, g.GUTS_AUSSTELLER) as AUSSTELLER,
                       g.GUTS_BETRAG,
                       g.GUTS_ZAHLBETRAG,
                       g.GUTS_FAELLIG_AM,
                       g.GUTS_BEZAHLT_AM,
                       g.GUTS_VERWENDUNGSZWECK
                  from FAKT_GUTSCHRIFTEN g
                  left join KUND_KUNDEN k on k.KUND_ID = g.GUTS_KUND_ID
                 where g.GUTS_MAND_ID = :MANDANT_ID   -- nur Gutschriften des im Portal gewaehlten Mandanten
                 order by g.GUTS_DATUM desc nulls first, to_number(regexp_substr(g.GUTS_INTERN_NUMMER, '[0-9]+$')) desc nulls first
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: Keine Gutschriften gefunden.
        }

        column GUTS_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
                alignment: center
            }
            columnFormatting {
                htmlExpression: <span class="fa #STATUS_ICON#" title="#STATUS#" aria-label="#STATUS#" style="font-size:16px"></span>
            }
            layout {
                columnAlignment: center
                sequence: 15
            }
            sorting {
                sortable: false
            }
        )

        column NUMMER (
            type: link
            heading {
                heading: Gutschrift
            }
            layout {
                sequence: 20
            }
            link {
                target: {
                    page: 41
                    items: {
                        P41_GUTS_ID: #GUTS_ID#
                    }
                    clearCache: 41
                }
                linkText: <span class="thg-kundennr">#NUMMER#</span>
            }
            sorting {
                sortable: false
            }
        )

        column STATUS_ICON (
            type: hidden
            layout {
                sequence: 16
            }
        )

        column GUTS_DATUM (
            type: plainText
            heading {
                heading: Datum
            }
            appearance {
                formatMask: DD.MM.YYYY
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column JAHR (
            type: hidden
            layout {
                sequence: 35
            }
        )

        column MONAT (
            type: hidden
            layout {
                sequence: 36
            }
        )

        column UEBERFAELLIG (
            type: hidden
            layout {
                sequence: 37
            }
        )

        column AUSSTELLER_NR (
            type: plainText
            heading {
                heading: Nr. beim Aussteller
            }
            layout {
                sequence: 38
            }
            sorting {
                sortable: false
            }
        )

        column KUND_NUMMER (
            type: plainText
            heading {
                heading: Kundennr.
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column AUSSTELLER (
            type: plainText
            heading {
                heading: Aussteller
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column GUTS_BETRAG (
            type: plainText
            heading {
                heading: Betrag
                alignment: end
            }
            appearance {
                formatMask: FML999G999G990D00
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column GUTS_ZAHLBETRAG (
            type: plainText
            heading {
                heading: Zahlbetrag
                alignment: end
            }
            appearance {
                formatMask: FML999G999G990D00
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column GUTS_FAELLIG_AM (
            type: plainText
            heading {
                heading: Fällig am
            }
            appearance {
                formatMask: DD.MM.YYYY
            }
            layout {
                sequence: 80
            }
            sorting {
                sortable: false
            }
        )

        column GUTS_BEZAHLT_AM (
            type: plainText
            heading {
                heading: Bezahlt am
            }
            appearance {
                formatMask: DD.MM.YYYY
            }
            layout {
                sequence: 90
            }
            sorting {
                sortable: false
            }
        )

        column GUTS_VERWENDUNGSZWECK (
            type: plainText
            heading {
                heading: Verwendungszweck
            }
            layout {
                sequence: 100
            }
            sorting {
                sortable: false
            }
        )

    )

    button up (
        buttonName: UP
        label: Zurück zum Dashboard
        layout {
            sequence: 10
            region: @breadcrumb
            slot: up
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-arrow-up
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset (
        buttonName: RESET
        label: Zurücksetzen
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                t-Button--noUI
                t-Button--iconLeft
                t-Button--gapRight
            ]
            icon: fa-undo-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 40
                clearCache: 40
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button neue-gutschrift (
        buttonName: CREATE
        label: Neue Gutschrift
        layout {
            sequence: 20
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconRight
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 41
                clearCache: 41
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)
