    region positionen (
        name: 3. Artikel (Positionen)
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select RPOS_ID, RPOS_POSITION, RPOS_KAPITEL, RPOS_UNTERKAPITEL, RPOS_ARTI_ID, RPOS_NAME,
                       RPOS_MENGE, RPOS_EINHEIT, RPOS_EINZELPREIS, RPOS_RABATT_PROZENT, RPOS_MWST_PROZENT,
                       RPOS_IST_OPTIONAL, RPOS_SUMME, RPOS_BESCHREIBUNG
                  from FAKT_RECHNUNGSPOSITIONEN
                 where RPOS_RECH_ID = :P11_RECH_ID
                 order by RPOS_POSITION
                ```
            pageItemsToSubmit: [
                P11_RECH_ID
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                actionsMenu
                saveButton
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_RECH_ID
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )
            displayColumn (
                column: @RPOS_POSITION
                layout {
                    sequence: 1
                }
            )
            displayColumn (
                column: @RPOS_KAPITEL
                layout {
                    sequence: 2
                }
            )
            displayColumn (
                column: @RPOS_ARTI_ID
                layout {
                    sequence: 3
                }
            )
            displayColumn (
                column: @RPOS_NAME
                layout {
                    sequence: 4
                }
            )
            displayColumn (
                column: @RPOS_MENGE
                layout {
                    sequence: 5
                }
            )
            displayColumn (
                column: @RPOS_EINHEIT
                layout {
                    sequence: 6
                }
            )
            displayColumn (
                column: @RPOS_EINZELPREIS
                layout {
                    sequence: 7
                }
            )
            displayColumn (
                column: @RPOS_RABATT_PROZENT
                layout {
                    sequence: 8
                }
            )
            displayColumn (
                column: @RPOS_MWST_PROZENT
                layout {
                    sequence: 9
                }
            )
            displayColumn (
                column: @RPOS_IST_OPTIONAL
                layout {
                    sequence: 10
                }
            )
            displayColumn (
                column: @RPOS_SUMME
                layout {
                    sequence: 11
                }
            )
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 5
            }
        )

        column RPOS_ID (
            type: hidden
            layout {
                sequence: 10
            }
            source {
                databaseColumn: RPOS_ID
                dataType: number
                primaryKey: true
