                        items: ["heading", "|", "bold", "italic", "|", "bulletedList", "numberedList", "|", "undo", "redo"]
                    };
                    return options;
                }
                ```
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select TXVL_TEXT from ALLG_TEXTVORLAGEN where TXVL_ART = 'SCHLUSSTEXT' and TXVL_IST_STANDARD = 'Y'
                ```
        }
    )

