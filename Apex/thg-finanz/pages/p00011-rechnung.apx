    pageItem P11_RECH_VORTEXT (
        type: richTextEditor
        label {
            label: Vortext
            alignment: left
        }
        layout {
            sequence: 10
            region: @vortext
            slot: regionBody
            columnSpan: 12
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @rechnung
            column: RECH_VORTEXT
            dataType: clob
        }
        settings {
            format: html
            toolbar: full
        }
        advanced {
            initJavaScriptFunction:
                ```javascript-browser
                function (options) {
                    options.editorOptions = options.editorOptions || {};
                    options.editorOptions.toolbar = {
                        items: ["heading", "|", "bold", "italic", "|", "bulletedList", "numberedList", "|", "undo", "redo"]
                    };
                    return options;
                }
                ```
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select TXVL_TEXT from ALLG_TEXTVORLAGEN where TXVL_ART = 'VORTEXT' and TXVL_IST_STANDARD = 'Y'
                ```
        }
    )

