    region summen (
        name: Summen
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 1 as SORT, 'Netto' as ZEILE, sum(NETTO) as BETRAG from FAKT_RECHNUNG_MWST_V where RECH_ID = :P11_RECH_ID
                union all
                select 2, to_char(MWST_PROZENT, 'FM990') || ' % MwSt.', MWST from FAKT_RECHNUNG_MWST_V where RECH_ID = :P11_RECH_ID
                union all
                select 3, 'Gesamtbetrag', sum(NETTO + MWST) from FAKT_RECHNUNG_MWST_V where RECH_ID = :P11_RECH_ID
                union all
                select 4, 'Bezahlt', BEZAHLT from FAKT_RECHNUNGEN_V where RECH_ID = :P11_RECH_ID and RECH_STATUS <> 'ENTWURF'
                union all
                select 5, 'Offen', OFFEN from FAKT_RECHNUNGEN_V where RECH_ID = :P11_RECH_ID and RECH_STATUS <> 'ENTWURF'
                order by 1, 2
                ```
            pageItemsToSubmit: [
                P11_RECH_ID
            ]
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Noch keine Positionen.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_RECH_ID
        }

        column SORT (
            type: hidden
            heading {
                heading: Sort
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column ZEILE (
            type: plainText
            heading {
                heading: Position
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column BETRAG (
            type: plainText
            heading {
                heading: Betrag
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            appearance {
                formatMask: FML999G999G990D00
            }
        )

    )

    region zahlungen (
        name: Zahlungen
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ZAHL_ID, ZAHL_RECH_ID, ZAHL_DATUM, ZAHL_BETRAG, ZAHL_SKONTO, ZAHL_MAHNSPESEN, ZAHL_BEMERKUNG
                  from FAKT_ZAHLUNGEN
                 where ZAHL_RECH_ID = :P11_RECH_ID
                 order by ZAHL_DATUM
                ```
            pageItemsToSubmit: [
                P11_RECH_ID
            ]
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                actionsMenu
                saveButton
            ]
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :P11_RECH_STATUS in ('OFFEN', 'BEZAHLT')
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
