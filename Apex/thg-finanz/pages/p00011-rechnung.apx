page 11 (
    name: Rechnung
    alias: RECHNUNG
    title: &P11_TITEL.
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        title: &P11_TITEL.
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region rechnung (
        name: Rechnung
        type: form
        source {
            location: localDatabase
            tableName: FAKT_RECHNUNGEN
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region allgemein (
        name: 1. Allgemein
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @rechnung
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region kunde (
        name: 2. Kunde
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @rechnung
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region details (
        name: Texte
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @rechnung
            slot: subRegions
        }
        appearance {
            template: @/tabs-container
            templateOptions: #DEFAULT#
        }
    )

    region tab-zahlungsbed (
        name: Zahlungsbedingungen
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @details
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region tab-vortext (
        name: Vortext
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @details
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region tab-schlusstext (
        name: Schlusstext
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @details
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region tab-lieferadresse (
        name: Lieferadresse
        type: staticContent
        layout {
            sequence: 40
            parentRegion: @details
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P11_RECH_ID (
        type: hidden
        layout {
            sequence: 1
            region: @allgemein
            slot: regionBody
        }
        source {
            formRegion: @rechnung
            column: RECH_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P11_TITEL (
        type: hidden
        layout {
            sequence: 2
            region: @allgemein
            slot: regionBody
        }
    )

