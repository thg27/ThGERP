            templateOptions: #DEFAULT#
        }
    )

    region pos-baum-region (
        name: Rechnungsübersicht
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="thg-pos-leiste">
                    <button type="button" id="pos-neu-haupt" class="t-Button t-Button--small t-Button--icon t-Button--iconLeft "><span class="t-Icon t-Icon--left fa fa-plus" aria-hidden="true"></span><span class="t-Button-label">Hauptposition</span></button>
                    <button type="button" id="pos-neu-unter" class="t-Button t-Button--small t-Button--icon t-Button--iconLeft "><span class="t-Icon t-Icon--left fa fa-plus" aria-hidden="true"></span><span class="t-Button-label">Unterposition</span></button>
                    <button type="button" id="pos-loeschen" class="t-Button t-Button--small t-Button--icon t-Button--iconLeft t-Button--danger t-Button--simple"><span class="t-Icon t-Icon--left fa fa-trash-o" aria-hidden="true"></span><span class="t-Button-label">Löschen</span></button>
                </div>
                <div id="pos-baum" class="thg-pos-baum" role="tree" aria-label="Positionen"></div>
                <div id="pos-ende" class="thg-pos-ende"></div>
                ```
        }
        layout {
            sequence: 5
            parentRegion: @pos-links
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

