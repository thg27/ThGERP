    region positionen (
        name: Unterpositionen
        type: interactiveGrid
        advanced {
            htmlDomId: positionen
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression: :P11_RECH_STATUS <> 'ENTWURF' and nvl(:P11_BEARBEITEN, 'N') <> 'Y'
        }
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select RPOS_ID, RPOS_ARTI_ID, RPOS_NAME,
                       RPOS_MENGE, RPOS_EINHEIT, RPOS_EINZELPREIS, RPOS_RABATT_PROZENT, RPOS_MWST_PROZENT,
                       RPOS_IST_OPTIONAL, RPOS_SUMME, RPOS_BESCHREIBUNG
                  from FAKT_RECHNUNGSPOSITIONEN
                 where RPOS_RECH_ID = :P11_RECH_ID
                   and RPOS_HAUPT_RPOS_ID = to_number(:P11_HAUPT_ID)
                 order by RPOS_POSITION
                ```
            pageItemsToSubmit: [
                P11_RECH_ID
                P11_HAUPT_ID
            ]
        }
        layout {
            sequence: 40
            parentRegion: @pos-rechts
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                actionsMenu
                saveButton
            ]
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )
            displayColumn (
                column: @RPOS_ARTI_ID
                layout {
                    sequence: 1
                }
            )
            displayColumn (
                column: @RPOS_NAME
                layout {
                    sequence: 2
                }
            )
            displayColumn (
                column: @RPOS_MENGE
                layout {
                    sequence: 3
                }
            )
            displayColumn (
                column: @RPOS_EINHEIT
                layout {
                    sequence: 4
                }
            )
            displayColumn (
                column: @RPOS_EINZELPREIS
                layout {
                    sequence: 5
                }
            )
            displayColumn (
                column: @RPOS_RABATT_PROZENT
                layout {
                    sequence: 6
                }
            )
            displayColumn (
                column: @RPOS_MWST_PROZENT
                layout {
                    sequence: 7
                }
            )
            displayColumn (
                column: @RPOS_IST_OPTIONAL
                layout {
                    sequence: 8
                }
            )
            displayColumn (
                column: @RPOS_SUMME
                layout {
                    sequence: 9
                }
            )
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 5
            }
        )

        column RPOS_ID (
            type: hidden
            layout {
                sequence: 10
            }
            source {
                databaseColumn: RPOS_ID
                dataType: number
                primaryKey: true
            }
        )

        column RPOS_ARTI_ID (
            type: popupLov
            heading {
                heading: Artikel
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: RPOS_ARTI_ID
                dataType: number
            }
            lov {
                type: sharedComponent
                lov: @lov-artikel
                displayNullValue: true
            }
        )

        column RPOS_NAME (
            type: textField
            heading {
                heading: Name
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: RPOS_NAME
                dataType: varchar2
            }
        )

        column RPOS_MENGE (
            type: numberField
            heading {
                heading: Menge
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: RPOS_MENGE
                dataType: number
            }
            default {
                type: static
                staticValue: 1
            }
        )

        column RPOS_EINHEIT (
            type: selectList
            heading {
                heading: Einheit
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: RPOS_EINHEIT
                dataType: varchar2
            }
            lov {
                type: sharedComponent
                lov: @lov-einheiten-code
                displayNullValue: true
                displayExtraValues: false
            }
        )

        column RPOS_EINZELPREIS (
            type: numberField
            heading {
                heading: Einzelpreis
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: RPOS_EINZELPREIS
                dataType: number
            }
            appearance {
                formatMask: FML999G999G990D00
            }
        )

        column RPOS_RABATT_PROZENT (
