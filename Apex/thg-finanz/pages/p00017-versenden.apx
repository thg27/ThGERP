page 17 (
    name: Rechnung versenden
    alias: VERSENDEN
    title: Rechnung versenden
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1300
        height: 860
        chained: false
        resizable: true
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 30
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region mail (
        name: E-Mail
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
            columnSpan: 6
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region anhang (
        name: Anhang
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                -- Anhang = abgelegter Druck (Seite 12 mit P12_RDOK_ID, inline); per JavaScript als Blob geladen
                -- (DA "Anhang laden"), da die App das Einbetten eigener Seiten in Frames verbietet
                return '<div class="thg-anhang-titel"><span class="fa fa-paperclip" aria-hidden="true"></span> '
                    || apex_escape.html(FAKT_RECHNUNG_DOKUMENT.dateiname(:P17_RECH_ID, :P17_RDOK_ID)) || '</div>'
                    || '<iframe id="anhang-pdf" title="Anhang" style="width:100%;height:calc(100vh - 150px);border:0;display:block" data-src="'
                    || apex_escape.html_attribute(
                           apex_page.get_url(p_page      => 12,
                                             p_items     => 'P12_RECH_ID,P12_RDOK_ID',
                                             p_values    => :P17_RECH_ID || ',' || :P17_RDOK_ID,
                                             p_plain_url => true))
                    || '"></iframe>';
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P17_RDOK_ID
        }
    )

    pageItem P17_RECH_ID (
        type: hidden
        layout {
            sequence: 1
            region: @mail
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P17_RDOK_ID (
        type: hidden
        layout {
            sequence: 2
            region: @mail
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P17_VON (
        type: displayOnly
        label {
            label: Von
            alignment: left
        }
        layout {
            sequence: 10
            region: @mail
            slot: regionBody
            columnSpan: 12
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P17_AN (
        type: textField
        label {
            label: An
            alignment: left
        }
        layout {
            sequence: 20
            region: @mail
            slot: regionBody
            columnSpan: 12
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 1000
        }
        help {
            helpText: Mehrere Empfänger mit ; trennen.
        }
    )

    pageItem P17_CC (
        type: textField
        label {
            label: Cc
            alignment: left
        }
        layout {
            sequence: 30
            region: @mail
            slot: regionBody
            columnSpan: 12
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 1000
        }
    )

    pageItem P17_BCC (
        type: displayOnly
        label {
            label: Bcc (immer)
            alignment: left
        }
        layout {
            sequence: 40
            region: @mail
            slot: regionBody
            columnSpan: 12
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P17_BETREFF (
        type: textField
        label {
            label: Betreff
            alignment: left
        }
        layout {
            sequence: 50
            region: @mail
            slot: regionBody
            columnSpan: 12
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 500
        }
    )

    pageItem P17_TEXT (
        type: richTextEditor
        label {
            label: Text
            alignment: left
        }
        layout {
            sequence: 60
            region: @mail
            slot: regionBody
            columnSpan: 12
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            format: html
            toolbar: full
        }
        advanced {
            initJavaScriptFunction:
                ```javascript-browser
                function (options) {
                    options.editorOptions = options.editorOptions || {};
                    options.editorOptions.toolbar = {
                        items: ["heading", "|", "bold", "italic", "|", "bulletedList", "numberedList", "|", "undo", "redo"]
                    };
                    return options;
                }
                ```
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Abbrechen
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button senden (
        buttonName: SENDEN
        label: E-Mail senden
        layout {
            sequence: 20
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-paper-plane-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-dialog (
        name: Dialog abbrechen
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction anhang-laden (
        name: Anhang laden
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-js-anhang-laden (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    // PDF holen und als Blob-URL anzeigen (Frame-Sperre der App greift fuer blob: nicht)
                    var f = document.getElementById('anhang-pdf');
                    if (f) {
                        fetch(f.dataset.src, { credentials: 'same-origin', cache: 'no-store' })
                            .then(function (r) {
                                if (!r.ok) { throw new Error('HTTP ' + r.status); }
                                return r.blob();
                            })
                            .then(function (b) {
                                f.src = URL.createObjectURL(new Blob([b], { type: 'application/pdf' })) + '#toolbar=0&navpanes=0&view=FitH';
                            })
                            .catch(function (e) {
                                apex.message.showErrors([{ type: 'error', location: 'page',
                                    message: 'Anhang konnte nicht geladen werden (' + e.message + ').' }]);
                            });
                    }
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    process vorbelegen (
        name: E-Mail aus der Vorlage vorbelegen
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- nur beim Oeffnen (nach einem Fehler beim Senden bleiben die Eingaben erhalten)
                declare
                    l_text clob;
                begin
                    FAKT_RECHNUNG_VERSAND.vorbelegen(:P17_RECH_ID, :P17_VON, :P17_AN, :P17_BCC, :P17_BETREFF, l_text,
                                                     :P17_RDOK_ID);
                    :P17_TEXT := l_text;
                exception
                    when others then
                        if sqlcode between -20299 and -20200 then
                            apex_error.add_error(p_message          => regexp_replace(sqlerrm, '^ORA-\d+: '),
                                                 p_display_location => apex_error.c_on_error_page);
                        else
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNull
            item: P17_VON
        }
    )

    process senden (
        name: E-Mail senden
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    FAKT_RECHNUNG_VERSAND.senden(:P17_RECH_ID, :P17_AN, :P17_CC, :P17_BETREFF, :P17_TEXT, :P17_RDOK_ID);
                exception
                    when others then
                        if sqlcode between -20299 and -20200 then
                            apex_error.add_error(p_message          => regexp_replace(sqlerrm, '^ORA-\d+: '),
                                                 p_display_location => apex_error.c_inline_in_notification);
                        else
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @senden
        }
    )

    process close-dialog (
        name: Dialog schließen
        type: closeDialog
        execution {
            sequence: 20
        }
        serverSideCondition {
            whenButtonPressed: @senden
        }
    )

)
