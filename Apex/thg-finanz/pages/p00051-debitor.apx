        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: Noch keine Zahlungen – Zahlungseingänge kommen aus der Bankdatei (Menüpunkt Bankdatei hochladen).
        }

        column DATUM (
