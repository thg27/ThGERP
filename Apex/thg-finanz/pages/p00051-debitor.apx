page 51 (
    name: Debitor
    alias: DEBITOR
    title: Debitor
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        title: &P51_TITEL.
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region debitor (
        name: Debitor
        type: form
        source {
            location: localDatabase
            tableName: FAKT_DEBITOREN
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region rds (
        name: Bereiche
        type: regionDisplaySelector
        layout {
            sequence: 5
            slot: fullWidthContent
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
            cssClasses: [
                u-padding-inline-dynamic
                thg-rds
            ]
        }
        settings {
            includeShowAll: true
            rememberSelection: false
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P51_DEBI_ID
        }
    )

    region stammdaten (
        name: Stammdaten
        type: staticContent
        advanced {
            regionDisplaySelector: true
        }
        layout {
            sequence: 10
            parentRegion: @debitor
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
            ]
        }
    )

    pageItem P51_DEBI_ID (
        type: hidden
        layout {
            sequence: 1
            region: @stammdaten
            slot: regionBody
        }
        source {
            formRegion: @debitor
            column: DEBI_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P51_DEBI_MAND_ID (
        type: hidden
        layout {
            sequence: 2
            region: @stammdaten
            slot: regionBody
        }
        source {
            formRegion: @debitor
            column: DEBI_MAND_ID
            dataType: number
        }
        default {
            type: item
            item: MANDANT_ID
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P51_TITEL (
        type: hidden
