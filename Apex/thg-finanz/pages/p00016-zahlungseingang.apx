page 16 (
    name: Zahlungseingang
    alias: ZAHLUNGSEINGANG
    title: Zahlungseingang
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 600
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region zahlung (
        name: Zahlung
        type: form
        source {
            location: localDatabase
            tableName: FAKT_ZAHLUNGEN
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P16_ZAHL_ID (
        type: hidden
        layout {
            sequence: 1
            region: @zahlung
            slot: regionBody
        }
        source {
            formRegion: @zahlung
            column: ZAHL_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P16_RECH_ID (
        type: hidden
        layout {
            sequence: 2
            region: @zahlung
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P16_ZAHL_RECH_ID (
        type: hidden
        layout {
            sequence: 3
            region: @zahlung
            slot: regionBody
        }
        source {
            formRegion: @zahlung
            column: ZAHL_RECH_ID
            dataType: number
        }
        default {
            type: item
            item: P16_RECH_ID
        }
    )

    pageItem P16_ZAHL_DATUM (
        type: datePicker
        label {
            label: Datum
            alignment: left
        }
        layout {
            sequence: 10
            region: @zahlung
            slot: regionBody
            columnSpan: 6
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @zahlung
            column: ZAHL_DATUM
            dataType: date
        }
        validation {
            valueRequired: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select trunc(cast(systimestamp at time zone 'Europe/Vienna' as date)) from dual
                ```
        }
    )

    pageItem P16_ZAHL_BETRAG (
        type: numberField
        label {
            label: Eingegangener Betrag
            alignment: left
        }
        layout {
            sequence: 20
            region: @zahlung
            slot: regionBody
            startNewRow: false
            columnSpan: 6
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            formatMask: 999G999G990D00
        }
        source {
            formRegion: @zahlung
            column: ZAHL_BETRAG
            dataType: number
        }
        validation {
            valueRequired: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select greatest(r.RECH_SUMME_BRUTTO - nvl((select sum(ZAHL_BETRAG) from FAKT_ZAHLUNGEN where ZAHL_RECH_ID = r.RECH_ID), 0), 0) from FAKT_RECHNUNGEN r where RECH_ID = :P16_RECH_ID
                ```
        }
    )

    pageItem P16_ZAHL_REFERENZ (
        type: textField
        label {
            label: Zahlungsreferenz
            alignment: left
        }
        layout {
            sequence: 50
            region: @zahlung
            slot: regionBody
            columnSpan: 12
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @zahlung
            column: ZAHL_REFERENZ
            dataType: varchar2
        }
        validation {
            maxLength: 140
        }
    )

    pageItem P16_ZAHL_BEMERKUNG (
        type: textField
        label {
            label: Bemerkung
            alignment: left
        }
        layout {
            sequence: 60
            region: @zahlung
            slot: regionBody
            columnSpan: 12
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @zahlung
            column: ZAHL_BEMERKUNG
            dataType: varchar2
        }
        validation {
            maxLength: 500
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Abbrechen
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Löschen
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P16_ZAHL_ID
        }
        confirmation {
            message: Zahlung wirklich löschen?
            style: danger
        }
    )

    button save (
        buttonName: SAVE
        label: Speichern
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P16_ZAHL_ID
        }
    )

    button create (
        buttonName: CREATE
        label: Zahlung erfassen
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P16_ZAHL_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Dialog abbrechen
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form-zahlung (
        name: Formular Zahlung initialisieren
        type: formInitialization
        formRegion: @zahlung
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process rechnung-pruefen (
        name: Rechnung gehört zum Mandanten und nimmt Zahlungen an
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_anz pls_integer;
                begin
                    select count(*) into l_anz
                      from FAKT_RECHNUNGEN
                     where RECH_ID = :P16_RECH_ID
                       and RECH_MAND_ID = :MANDANT_ID
                       and RECH_STATUS in ('GEDRUCKT', 'GESENDET', 'TEILBEZAHLT', 'BEZAHLT')
                       and (:P16_ZAHL_ID is null
                            or exists (select 1 from FAKT_ZAHLUNGEN where ZAHL_ID = :P16_ZAHL_ID and ZAHL_RECH_ID = :P16_RECH_ID));
                    if l_anz = 0 then
                        raise_application_error(-20250, 'Zahlungen können nur zu abgeschlossenen Rechnungen des gewählten Mandanten erfasst werden.');
                    end if;
                end;
                ```
        }
        execution {
            sequence: 15
            point: beforeHeader
        }
    )

    process process-form-zahlung (
        name: Formular Zahlung verarbeiten
        type: formAutoRowProcessing
        formRegion: @zahlung
        execution {
            sequence: 10
        }
    )

    process close-dialog (
        name: Dialog schließen
        type: closeDialog
        execution {
            sequence: 20
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

)
