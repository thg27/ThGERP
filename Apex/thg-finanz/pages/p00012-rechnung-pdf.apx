page 12 (
    name: Rechnung PDF
    alias: RECHNUNG-PDF
    title: Rechnung
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region rechnung-pdf (
        name: Rechnung PDF
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P12_RECH_ID (
        type: hidden
        layout {
            sequence: 10
            region: @rechnung-pdf
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    process pdf-herunterladen (
        name: Rechnung als PDF ausliefern (inline, fuer die Vorschau auf Seite 13)
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_pdf blob := FAKT_RECHNUNG_PDF.pdf(:P12_RECH_ID);
                begin
                    apex_http.download(
                        p_blob         => l_pdf,
                        p_content_type => 'application/pdf',
                        p_filename     => FAKT_RECHNUNG_PDF.dateiname(:P12_RECH_ID),
                        p_is_inline    => true);
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P12_RECH_ID
        }
    )
)
