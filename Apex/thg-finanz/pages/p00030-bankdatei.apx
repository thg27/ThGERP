page 30 (
    name: Bankdatei hochladen
    alias: BANKDATEI
    title: Bankdatei hochladen
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        title: Bankdatei hochladen
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region upload (
        name: Bankdatei hochladen
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Kontoauszug als CAMT-Datei (XML, z.&nbsp;B. ELBA-Export „camt.052“ oder „camt.053“) des Kontos von
                &MANDANT_NAME. hochladen. Die Zahlungseingänge werden automatisch den offenen Rechnungen zugeordnet –
                über die Zahlungsreferenz, die Rechnungsnummer im Verwendungszweck oder den offenen Betrag und den Kunden –,
                sonst den Debitoren (z.&nbsp;B. Mieter) über die IBAN bzw. den Namen des Zahlers.</p>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P30_DATEI (
        type: fileUpload
        label {
            label: Bankdatei (XML)
            alignment: left
        }
        display {
            displayAs: inlineDropzone
            dropzoneTitle: Bankdatei hierher ziehen
            dropzoneDesc: oder klicken zum Auswählen
        }
        storage {
            type: appTempFiles
        }
        layout {
            sequence: 10
            region: @upload
            slot: regionBody
            columnSpan: 12
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P30_MELDUNG (
        type: hidden
        layout {
            sequence: 20
            region: @upload
            slot: regionBody
        }
    )

    button hochladen (
        buttonName: HOCHLADEN
        label: Hochladen und abgleichen
        layout {
            sequence: 10
            region: @upload
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-upload
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button abgleichen (
        buttonName: ABGLEICHEN
        label: Erneut abgleichen
        layout {
            sequence: 20
            region: @upload
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    region eingaenge (
        name: Zahlungseingänge
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- Eingaenge des Mandanten, neueste zuerst; Beleg als Link (Rechnung, Gutschrift bzw. Debitor)
                select u.BKUM_ID,
                       u.BKUM_BUCHUNGSDATUM as DATUM,
                       u.BKUM_BETRAG as BETRAG,
                       u.BKUM_GEGEN_NAME as AUFTRAGGEBER,
                       FAKT_RECHNUNG.referenz_anzeige(u.BKUM_GEGEN_IBAN) as IBAN,
                       trim(u.BKUM_REFERENZ || ' ' || u.BKUM_VERWENDUNGSZWECK) as VERWENDUNGSZWECK,
                       FAKT_BANK.status_text(u.BKUM_STATUS) as STATUS,
                       case u.BKUM_STATUS when 'ZUGEORDNET' then 'u-success-text'
                                          when 'DEBITOR' then 'u-success-text'
                                          when 'BEREITS_BEZAHLT' then 'u-info-text'
                                          when 'OFFEN' then 'u-warning-text' end as STATUS_KLASSE,
                       case when d.DEBI_ID is not null then 'Debitor ' || d.DEBI_NAME
                            when g.GUTS_ID is not null then 'Gutschrift ' || coalesce(g.GUTS_INTERN_NUMMER, g.GUTS_NUMMER, g.GUTS_AUSSTELLER)
                            when r.RECH_ID is not null then 'Rechnung ' || r.RECH_NUMMER
                       end as BELEG,
                       case when d.DEBI_ID is not null then
                                apex_page.get_url(p_page => 51, p_clear_cache => '51', p_items => 'P51_DEBI_ID', p_values => d.DEBI_ID)
                            when g.GUTS_ID is not null then
                                apex_page.get_url(p_page => 41, p_clear_cache => '41', p_items => 'P41_GUTS_ID', p_values => g.GUTS_ID)
                            when r.RECH_ID is not null then
                                apex_page.get_url(p_page => 11, p_clear_cache => '11', p_items => 'P11_RECH_ID', p_values => r.RECH_ID)
                       end as BELEG_URL,
                       coalesce(u.BKUM_ZUORDNUNG,
                                case when k.KUNDE is not null then 'Auftraggeber ist Kunde ' || k.KUNDE
                                                                   || ' – passende Rechnung bzw. Gutschrift fehlt' end) as ZUORDNUNG,
                       -- von Hand einer Rechnung/Gutschrift zuordnen bzw. Zuordnung aendern (Dialog Seite 31)
                       '<a class="t-Button t-Button--small t-Button--icon t-Button--iconLeft" href="'
                       || apex_escape.html_attribute(apex_page.get_url(p_page => 31, p_clear_cache => '31',
                                                                       p_items => 'P31_BKUM_ID', p_values => u.BKUM_ID))
                       || '" title="Von Hand einer Rechnung bzw. Gutschrift zuordnen"><span class="t-Icon t-Icon--left fa '
                       || case when u.BKUM_STATUS = 'OFFEN' then 'fa-link" aria-hidden="true"></span>Zuordnen'
                               else 'fa-pencil" aria-hidden="true"></span>Ändern' end || '</a> ' ||
                       -- nicht zuordenbarer Eingang eines Nicht-Kunden: Debitor daraus anlegen (Seite 51, Request ANLEGEN)
                       case when u.BKUM_STATUS = 'OFFEN' and u.BKUM_RECH_ID is null and u.BKUM_GUTS_ID is null
                             and k.KUNDE is null then
                           '<a class="t-Button t-Button--small t-Button--icon t-Button--iconLeft" href="'
                           || apex_escape.html_attribute(apex_page.get_url(p_page => 51, p_clear_cache => '51',
                                                                           p_items => 'P51_BKUM_ID', p_values => u.BKUM_ID,
                                                                           p_request => 'ANLEGEN'))
                           || '" title="Debitor aus dieser Buchung anlegen und zuweisen"><span class="t-Icon t-Icon--left fa fa-user-plus" aria-hidden="true"></span>'
                           || 'Debitor anlegen</a>'
                       end as AKTION
                  from FAKT_BANKUMSAETZE u
                  left join FAKT_RECHNUNGEN r on r.RECH_ID = u.BKUM_RECH_ID
                  left join FAKT_GUTSCHRIFTEN g on g.GUTS_ID = u.BKUM_GUTS_ID
                  left join FAKT_DEBITOREN d on d.DEBI_ID = u.BKUM_DEBI_ID
                  -- Auftraggeber ist ein Kunde (Name passt): kein Debitor, sondern Rechnung/Gutschrift fehlt
                  outer apply (select max(c.KUND_NUMMER || ' ' || c.KUND_FIRMENNAME) as KUNDE
                                 from KUND_KUNDEN c
                                where u.BKUM_STATUS = 'OFFEN' and u.BKUM_RECH_ID is null and u.BKUM_GUTS_ID is null
                                  and c.KUND_FIRMENNAME is not null
                                  and FAKT_DEBITOR.ist_kunde(c.KUND_FIRMENNAME, u.BKUM_GEGEN_NAME) = 'Y') k
                 where u.BKUM_MAND_ID = :MANDANT_ID
                   and u.BKUM_RICHTUNG = 'CRDT'
                 order by u.BKUM_BUCHUNGSDATUM desc, u.BKUM_ID desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Noch keine Zahlungseingänge – bitte eine Bankdatei hochladen.
        }

        column BKUM_ID (
            type: hidden
            heading {
                heading: BKUM_ID
            }
            layout {
                sequence: 5
            }
            source {
                dataType: NUMBER
            }
        )

        column DATUM (
            type: plainText
            heading {
                heading: Datum
            }
            layout {
                sequence: 10
            }
            appearance {
                formatMask: DD.MM.YYYY
            }
            source {
                dataType: DATE
            }
        )

        column BETRAG (
            type: plainText
            heading {
                heading: Betrag
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G990D00
            }
            source {
                dataType: NUMBER
            }
        )

        column AUFTRAGGEBER (
            type: plainText
            heading {
                heading: Auftraggeber
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column IBAN (
            type: plainText
            heading {
                heading: IBAN
            }
            layout {
                sequence: 35
            }
            source {
                dataType: STRING
            }
        )

        column VERWENDUNGSZWECK (
            type: plainText
            heading {
                heading: Verwendungszweck
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 50
            }
            columnFormatting {
                htmlExpression: <span class="#STATUS_KLASSE#">#STATUS#</span>
            }
            source {
                dataType: STRING
            }
        )

        column STATUS_KLASSE (
            type: hidden
            heading {
                heading: STATUS_KLASSE
            }
            layout {
                sequence: 55
            }
            source {
                dataType: STRING
            }
        )

        column BELEG (
            type: plainText
            heading {
                heading: Rechnung / Gutschrift / Debitor
            }
            layout {
                sequence: 60
            }
            columnFormatting {
                htmlExpression: <a href="#BELEG_URL#">#BELEG#</a>
            }
            source {
                dataType: STRING
            }
        )

        column BELEG_URL (
            type: hidden
            heading {
                heading: BELEG_URL
            }
            layout {
                sequence: 65
            }
            source {
                dataType: STRING
            }
        )

        column ZUORDNUNG (
            type: plainText
            heading {
                heading: Zuordnung
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

        column AKTION (
            type: plainText
            heading {
                heading: Aktion
            }
            layout {
                sequence: 80
            }
            security {
                escapeSpecialChars: false
            }
            source {
                dataType: STRING
            }
        )

    )

    region dateien (
        name: Hochgeladene Bankdateien
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(from_tz(d.BKDT_CREATED_ON, 'UTC') at time zone 'Europe/Vienna', 'DD.MM.YYYY HH24:MI') as HOCHGELADEN,
                       d.BKDT_CREATED_BY as VON,
                       d.BKDT_DATEINAME as DATEI,
                       FAKT_RECHNUNG.referenz_anzeige(d.BKDT_IBAN) as KONTO,
                       d.BKDT_FORMAT as FORMAT,
                       d.BKDT_ANZ_UMSAETZE as BUCHUNGEN,
                       d.BKDT_ANZ_NEU as NEU,
                       d.BKDT_ANZ_ZUGEORDNET as ZUGEORDNET
                  from FAKT_BANKDATEIEN d
                 where d.BKDT_MAND_ID = :MANDANT_ID
                 order by d.BKDT_CREATED_ON desc
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 50
        }
        messages {
            whenNoDataFound: Noch keine Bankdatei hochgeladen.
        }

        column HOCHGELADEN (
            type: plainText
            heading {
                heading: Hochgeladen
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column VON (
            type: plainText
            heading {
                heading: Von
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column DATEI (
            type: plainText
            heading {
                heading: Datei
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column KONTO (
            type: plainText
            heading {
                heading: Konto
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column FORMAT (
            type: plainText
            heading {
                heading: Format
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column BUCHUNGEN (
            type: plainText
            heading {
                heading: Buchungen
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column NEU (
            type: plainText
            heading {
                heading: Davon neu
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column ZUGEORDNET (
            type: plainText
            heading {
                heading: Zugeordnet
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

    )

    dynamicAction nach-dialog (
        name: Nach dem Zuordnen die Zahlungseingänge aktualisieren
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: jQuerySelector
            jquerySelector: body
        }

        action refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @eingaenge
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process bankdatei-einlesen (
        name: Bankdatei einlesen und abgleichen
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_blob  blob;
                    l_name  varchar2(400);
                    l_id    number;
                begin
                    if :P30_DATEI is null then
                        raise_application_error(-20263, 'Bitte eine Bankdatei auswählen.');
                    end if;
                    select blob_content, filename into l_blob, l_name
                      from apex_application_temp_files where name = :P30_DATEI;
                    l_id := FAKT_BANK.einlesen(:MANDANT_ID, l_name, l_blob);
                    -- neu eingelesen bzw. "bereits hochgeladen – Zuordnung erneut geprueft"
                    :P30_MELDUNG := FAKT_BANK.meldung;
                exception
                    when others then
                        if sqlcode between -20299 and -20200 then
                            apex_error.add_error(p_message          => regexp_replace(sqlerrm, '^ORA-\d+: '),
                                                 p_display_location => apex_error.c_inline_in_notification);
                        else
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @hochladen
        }
        successMessage {
            successMessage: &P30_MELDUNG.
        }
    )

    process erneut-abgleichen (
        name: Offene Eingänge erneut abgleichen
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P30_MELDUNG := FAKT_BANK.abgleichen(:MANDANT_ID) || ' Zahlungseingänge zugeordnet.';
                ```
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            whenButtonPressed: @abgleichen
        }
        successMessage {
            successMessage: &P30_MELDUNG.
        }
    )

)
