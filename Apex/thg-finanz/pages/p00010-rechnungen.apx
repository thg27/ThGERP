page 10 (
    name: Rechnungen
    alias: RECHNUNGEN
    title: Rechnungen
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        title: Rechnungen
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region facets (
        name: Facetten
        type: facetedSearch
        source {
            filteredRegion: @rechnungen
        }
        layout {
            sequence: 20
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            compactNosThreshold: 10000
            displayChartForTopNValues: 10
        }

        facet P10_SEARCH (
            type: search
            label {
                label: Suche
            }
            layout {
                sequence: 10
            }
        )

        facet P10_STATUS (
            type: checkboxGroup
            label {
                label: Status
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 20
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: STATUS
            }
        )

        facet P10_UEBERFAELLIG (
            type: checkboxGroup
            label {
                label: Überfällig
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 25
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: UEBERFAELLIG
            }
        )

        facet P10_JAHR (
            type: checkboxGroup
            label {
                label: Jahr
            }
            lov {
                type: distinctValues
                sortDirection: desc
            }
            layout {
                sequence: 30
            }
            listEntries {
                maxDisplayedEntries: 7
                sortByTopCounts: false
            }
            source {
                databaseColumn: JAHR
            }
        )

        facet P10_MONAT (
            type: checkboxGroup
            label {
                label: Monat
            }
            lov {
                type: distinctValues
                sortDirection: desc
            }
            layout {
                sequence: 35
            }
            listEntries {
                maxDisplayedEntries: 7
                sortByTopCounts: false
            }
            source {
                databaseColumn: MONAT
            }
            appearance {
                display: addFilterDialog
            }
        )

        facet P10_KUNDE (
            type: checkboxGroup
            label {
                label: Kunde
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 40
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: KUNDE
            }
        )

    )

    region rechnungen (
        name: Rechnungen
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.RECH_ID,
                       coalesce(r.RECH_NUMMER, '(Entwurf)') as NUMMER,
                       r.RECH_DATUM,
                       to_char(r.RECH_DATUM, 'YYYY') as JAHR,
                       to_char(r.RECH_DATUM, 'YYYY-MM') as MONAT,
                       FAKT_RECHNUNG.status_text(r.RECH_STATUS) as STATUS,
                       case r.RECH_STATUS when 'ENTWURF' then 'fa-pencil u-warning-text'
                                          when 'GEDRUCKT' then 'fa-print u-info-text'
                                          when 'GESENDET' then 'fa-paper-plane-o u-info-text'
                                          when 'IN_BEARBEITUNG' then 'fa-unlock u-warning-text'
                                          when 'TEILBEZAHLT' then 'fa-adjust u-warning-text'
                                          when 'BEZAHLT' then 'fa-check-circle u-success-text'
                                          else 'fa-ban u-danger-text' end as STATUS_ICON,
                       case r.IST_UEBERFAELLIG when 'Y' then 'Ja' else 'Nein' end as UEBERFAELLIG,
                       case r.IST_UEBERFAELLIG when 'Y' then 'überfällig' end as UEBERFAELLIG_TEXT,
                       r.RECH_FAELLIG_AM,
                       r.KUND_NUMMER,
                       r.KUNDE,
                       r.RECH_BETREFF,
                       r.RECH_LEISTUNGSZEITRAUM,
                       r.RECH_SUMME_NETTO,
                       r.RECH_SUMME_BRUTTO,
                       r.OFFEN
                  from FAKT_RECHNUNGEN_V r
                 where r.RECH_MAND_ID = :MANDANT_ID   -- nur Rechnungen des im Portal gewaehlten Mandanten
                 order by r.RECH_DATUM desc nulls first, to_number(regexp_substr(r.RECH_NUMMER, '\d+$')) desc nulls first
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: Keine Rechnungen gefunden.
        }

        column RECH_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
                alignment: center
            }
            columnFormatting {
                htmlExpression: <span class="fa #STATUS_ICON#" title="#STATUS#" aria-label="#STATUS#" style="font-size:16px"></span>
            }
            layout {
                columnAlignment: center
                sequence: 15
            }
            sorting {
                sortable: false
            }
        )

        column STATUS_ICON (
            type: hidden
            layout {
                sequence: 16
            }
        )

        column NUMMER (
            type: link
            heading {
                heading: Nummer
            }
            layout {
                sequence: 20
            }
            link {
                target: {
                    page: 11
                    items: {
                        P11_RECH_ID: #RECH_ID#
                    }
                    clearCache: 11
                }
                linkText: <span class="thg-kundennr">#NUMMER#</span>
            }
            sorting {
                sortable: false
            }
        )

        column RECH_DATUM (
            type: plainText
            heading {
                heading: Datum
            }
            appearance {
                formatMask: DD.MM.YYYY
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column JAHR (
            type: hidden
            layout {
                sequence: 35
            }
        )

        column MONAT (
            type: hidden
            layout {
                sequence: 36
            }
        )

        column KUND_NUMMER (
            type: plainText
            heading {
                heading: Kundennr.
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column KUNDE (
            type: plainText
            heading {
                heading: Kunde
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column RECH_BETREFF (
            type: hidden
            layout {
                sequence: 60
            }
        )

        column RECH_LEISTUNGSZEITRAUM (
            type: plainText
            heading {
                heading: Leistungszeitraum
            }
            layout {
                sequence: 65
            }
            sorting {
                sortable: false
            }
        )

        column RECH_SUMME_NETTO (
            type: plainText
            heading {
                heading: Netto
                alignment: end
            }
            appearance {
                formatMask: FML999G999G990D00
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column RECH_SUMME_BRUTTO (
            type: hidden
            layout {
                sequence: 80
            }
        )

        column OFFEN (
            type: plainText
            heading {
                heading: Offen
                alignment: end
            }
            appearance {
                formatMask: FML999G999G990D00
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column RECH_FAELLIG_AM (
            type: plainText
            heading {
                heading: Fällig am
            }
            appearance {
                formatMask: DD.MM.YYYY
            }
            layout {
                sequence: 100
            }
            sorting {
                sortable: false
            }
        )

        column UEBERFAELLIG (
            type: hidden
            layout {
                sequence: 105
            }
        )

        column UEBERFAELLIG_TEXT (
            type: hidden
            layout {
                sequence: 110
            }
        )

    )

    button up (
        buttonName: UP
        label: Zurück zum Dashboard
        layout {
            sequence: 10
            region: @breadcrumb
            slot: up
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-arrow-up
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset (
        buttonName: RESET
        label: Zurücksetzen
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                t-Button--noUI
                t-Button--iconLeft
                t-Button--gapRight
            ]
            icon: fa-undo-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
                clearCache: 10
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button neue-rechnung (
        buttonName: CREATE
        label: Neue Rechnung
        layout {
            sequence: 20
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconRight
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 11
                clearCache: 11
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)
