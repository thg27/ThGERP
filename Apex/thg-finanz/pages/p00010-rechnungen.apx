page 10 (
    name: Rechnungen
    alias: RECHNUNGEN
    title: Rechnungen
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        title: Rechnungen
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region rechnungen (
        name: Rechnungen
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select RECH_ID,
                       MAND_KURZNAME as MANDANT,
                       RECH_NUMMER,
                       initcap(RECH_STATUS) as STATUS,
                       RECH_DATUM,
                       RECH_FAELLIG_AM,
                       KUND_NUMMER,
                       KUNDE,
                       RECH_BETREFF,
                       RECH_LEISTUNGSZEITRAUM,
                       RECH_SUMME_NETTO,
                       RECH_SUMME_BRUTTO,
                       OFFEN,
                       case IST_UEBERFAELLIG when 'Y' then 'überfällig' end as UEBERFAELLIG
                  from FAKT_RECHNUNGEN_V
                 order by RECH_DATUM desc, RECH_NUMMER desc nulls first
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 11
                items: {
                    P11_RECH_ID: #RECH_ID#
                }
                clearCache: 11
            }
            linkIcon: <span role="img" aria-label="Bearbeiten" class="fa fa-edit" title="Bearbeiten"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Keine Rechnungen vorhanden.
        }

        column RECH_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column MANDANT (
            type: plainText
            heading {
                heading: Mandant
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column RECH_NUMMER (
            type: plainText
            heading {
                heading: Nummer
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column RECH_DATUM (
            type: plainText
            heading {
                heading: Datum
            }
            layout {
                sequence: 50
            }
            source {
                dataType: DATE
            }
        )

        column RECH_FAELLIG_AM (
            type: plainText
            heading {
                heading: Fällig am
            }
            layout {
                sequence: 60
            }
            source {
                dataType: DATE
            }
        )

        column KUND_NUMMER (
            type: plainText
            heading {
                heading: Kundennr.
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

        column KUNDE (
            type: plainText
            heading {
                heading: Kunde
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
        )

        column RECH_BETREFF (
            type: plainText
            heading {
                heading: Betreff
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
        )

        column RECH_LEISTUNGSZEITRAUM (
            type: plainText
            heading {
                heading: Leistungszeitraum
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
        )

        column RECH_SUMME_NETTO (
            type: plainText
            heading {
                heading: Netto
                alignment: end
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            appearance {
                formatMask: FML999G999G990D00
            }
        )

        column RECH_SUMME_BRUTTO (
            type: plainText
            heading {
                heading: Brutto
                alignment: end
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            appearance {
                formatMask: FML999G999G990D00
            }
        )

        column OFFEN (
            type: plainText
            heading {
                heading: Offen
                alignment: end
            }
            layout {
                sequence: 130
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            appearance {
                formatMask: FML999G999G990D00
            }
        )

        column UEBERFAELLIG (
            type: plainText
            heading {
                heading: Überfällig
            }
            layout {
                sequence: 140
            }
            source {
                dataType: STRING
            }
        )

    )

    button reset-report (
        buttonName: RESET_REPORT
        label: Zurücksetzen
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                t-Button--noUI
                t-Button--iconLeft
                t-Button--gapRight
            ]
            icon: fa-undo-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: &APP_PAGE_ID.
                clearCache: &APP_PAGE_ID.
                action: resetRegions
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button neue-rechnung (
        buttonName: CREATE
        label: Neue Rechnung
        layout {
            sequence: 20
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 11
                clearCache: 11
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)
