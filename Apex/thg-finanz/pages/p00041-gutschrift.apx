page 41 (
    name: Gutschrift
    alias: GUTSCHRIFT
    title: Gutschrift
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        title: &P41_TITEL.
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region gutschrift (
        name: Gutschrift
        type: form
        source {
            location: localDatabase
            tableName: FAKT_GUTSCHRIFTEN
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region rds (
        name: Bereiche
        type: regionDisplaySelector
        layout {
            sequence: 5
            slot: fullWidthContent
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
            cssClasses: [
                u-padding-inline-dynamic
                thg-rds
            ]
        }
        settings {
            includeShowAll: true
            rememberSelection: false
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P41_GUTS_ID
        }
    )

    region angaben (
        name: Gutschrift
        type: staticContent
        advanced {
            regionDisplaySelector: true
        }
        layout {
            sequence: 10
            parentRegion: @gutschrift
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
            ]
        }
    )

    region pdf (
        name: PDF der Gutschrift
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>PDF der Gutschrift hochladen: Aussteller, Gutschriftnummer, Datum, fällig am, Betrag und Verwendungszweck
                werden ausgelesen und vorbelegt – bitte prüfen und speichern. Ist die Gutschrift schon vorhanden, kommt nur ein
                Hinweis.</p>
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P41_GUTS_ID
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P41_GUTS_ID (
        type: hidden
        layout {
            sequence: 1
            region: @gutschrift
            slot: regionBody
        }
        source {
            formRegion: @gutschrift
            column: GUTS_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P41_GUTS_MAND_ID (
        type: hidden
        layout {
            sequence: 2
            region: @gutschrift
            slot: regionBody
        }
        source {
            formRegion: @gutschrift
            column: GUTS_MAND_ID
            dataType: number
        }
        default {
            type: item
            item: MANDANT_ID
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P41_TITEL (
        type: hidden
        layout {
            sequence: 3
            region: @gutschrift
            slot: regionBody
        }
    )

    pageItem P41_DATEI (
        type: fileUpload
        label {
            label: Gutschrift (PDF)
            alignment: left
        }
        display {
            displayAs: inlineDropzone
            dropzoneTitle: PDF der Gutschrift hierher ziehen
            dropzoneDesc: oder klicken zum Auswählen
        }
        storage {
            type: appTempFiles
        }
        layout {
            sequence: 10
            region: @pdf
            slot: regionBody
            columnSpan: 12
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P41_GUTS_KUND_ID (
        type: selectList
        label {
            label: Kunde (Aussteller)
            alignment: left
        }
        layout {
            sequence: 10
            region: @angaben
            slot: regionBody
            columnSpan: 6
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
