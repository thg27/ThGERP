            }
            sorting {
                sortable: false
            }
        )

        column EVENT_TYPE (
            type: plainText
            heading {
                heading: EVENT_TYPE
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column EVENT_ICON (
            type: plainText
            heading {
                heading: EVENT_ICON
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column EVENT_STATUS (
            type: plainText
            heading {
                heading: EVENT_STATUS
            }
            layout {
                sequence: 70
            }
            sorting {
                sortable: false
            }
        )

        column EVENT_TITLE (
            type: plainText
            heading {
                heading: EVENT_TITLE
            }
            layout {
                sequence: 80
            }
            sorting {
                sortable: false
            }
        )

        column EVENT_DESC (
            type: plainText
            heading {
                heading: EVENT_DESC
            }
            layout {
                sequence: 90
            }
            sorting {
                sortable: false
            }
        )

        column EVENT_MODIFIERS (
            type: plainText
            heading {
                heading: EVENT_MODIFIERS
            }
            layout {
                sequence: 100
            }
            sorting {
