    button up (
        buttonName: UP
        label: Zurück zu den Gutschriften
        layout {
            sequence: 10
            region: @breadcrumb
            slot: up
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-arrow-up
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 40
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button auslesen (
        buttonName: AUSLESEN
        label: PDF hochladen und auslesen
        layout {
            sequence: 10
            region: @pdf
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-upload
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P41_GUTS_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Löschen
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P41_GUTS_ID
        }
        confirmation {
            message: Gutschrift wirklich löschen? Nur ein Entwurf ohne Nummer oder die zuletzt vergebene Gutschrift kann gelöscht werden.
            style: danger
        }
    )

    button gesendet (
        buttonName: GESENDET
        label: An Aussteller gesendet
        layout {
            sequence: 15
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-paper-plane-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :P41_GUTS_STATUS = 'ENTWURF' and :P41_GUTS_INTERN_NUMMER is not null
        }
    )

    button save (
        buttonName: SAVE
        label: Speichern
        layout {
            sequence: 20
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P41_GUTS_ID
        }
    )

    button create (
        buttonName: CREATE
        label: Anlegen
        layout {
            sequence: 30
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P41_GUTS_ID
        }
    )

    process initialize-form-gutschrift (
        name: Formular Gutschrift initialisieren
        type: formInitialization
        formRegion: @gutschrift
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process kopf (
        name: Mandant prüfen, Titel
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P41_GUTS_ID is not null and :P41_GUTS_MAND_ID <> :MANDANT_ID then
                    raise_application_error(-20240, 'Diese Gutschrift gehört zu einem anderen Mandanten. Bitte den Mandanten im Portal wechseln.');
                end if;
                :P41_TITEL := case when :P41_GUTS_ID is null then 'Neue Gutschrift'
                                   when :P41_GUTS_INTERN_NUMMER is null then 'Gutschrift (Entwurf)'
                                   else 'Gutschrift ' || :P41_GUTS_INTERN_NUMMER end;
                :P41_HAT_PDF := null;
                for g in (select 'Y' as J from FAKT_GUTSCHRIFTEN where GUTS_ID = :P41_GUTS_ID and GUTS_DATEI is not null) loop
                    :P41_HAT_PDF := g.J;
                end loop;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
    )

    process pdf-auslesen (
        name: Neue Gutschrift aus dem PDF des Ausstellers
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_blob blob;
                    l_name varchar2(400);
                    l_mime varchar2(255);
                begin
                    if :P41_DATEI is null then
                        raise_application_error(-20274, 'Bitte eine Datei auswählen.');
                    end if;
                    select blob_content, filename, mime_type into l_blob, l_name, l_mime
                      from apex_application_temp_files where name = :P41_DATEI;
                    :P41_GUTS_ID := FAKT_GUTSCHRIFT.aus_pdf(:MANDANT_ID, l_name, l_mime, l_blob);
                exception
                    when others then
                        if sqlcode between -20299 and -20200 then
                            apex_error.add_error(p_message          => regexp_replace(sqlerrm, '^ORA-\d+: '),
                                                 p_display_location => apex_error.c_inline_in_notification);
                        else
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 5
        }
        serverSideCondition {
            whenButtonPressed: @auslesen
        }
        successMessage {
            successMessage: PDF ausgelesen – bitte die Angaben prüfen und speichern.
        }
    )

    process aussteller-hochladen (
        name: Gutschrift des Ausstellers hochladen
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_blob blob;
                    l_name varchar2(400);
                    l_mime varchar2(255);
                begin
                    if :P41_DOKUMENT is null then
                        raise_application_error(-20274, 'Bitte eine Datei auswählen.');
                    end if;
                    select blob_content, filename, mime_type into l_blob, l_name, l_mime
                      from apex_application_temp_files where name = :P41_DOKUMENT;
                    :P41_GUTS_ID := FAKT_GUTSCHRIFT.aus_pdf(:MANDANT_ID, l_name, l_mime, l_blob, :P41_GUTS_ID);
                exception
                    when others then
                        if sqlcode between -20299 and -20200 then
                            apex_error.add_error(p_message          => regexp_replace(sqlerrm, '^ORA-\d+: '),
                                                 p_display_location => apex_error.c_inline_in_notification);
                        else
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 6
        }
        serverSideCondition {
            whenButtonPressed: @aussteller
        }
        successMessage {
            successMessage: Gutschrift des Ausstellers übernommen – bitte die Angaben prüfen.
        }
    )

    process stundenzettel-hochladen (
        name: Stundenzettel hochladen
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_blob blob;
                    l_name varchar2(400);
                    l_mime varchar2(255);
                begin
                    if :P41_DOKUMENT is null then
                        raise_application_error(-20274, 'Bitte eine Datei auswählen.');
                    end if;
                    select blob_content, filename, mime_type into l_blob, l_name, l_mime
                      from apex_application_temp_files where name = :P41_DOKUMENT;
                    FAKT_GUTSCHRIFT.dokument_ablegen(:P41_GUTS_ID, 'STUNDENZETTEL', l_name, l_mime, l_blob);
                exception
                    when others then
                        if sqlcode between -20299 and -20200 then
                            apex_error.add_error(p_message          => regexp_replace(sqlerrm, '^ORA-\d+: '),
                                                 p_display_location => apex_error.c_inline_in_notification);
                        else
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 7
        }
        serverSideCondition {
            whenButtonPressed: @stundenzettel
        }
        successMessage {
            successMessage: Stundenzettel abgelegt.
        }
    )

    process sonstiges-hochladen (
        name: Sonstiges Dokument hochladen
