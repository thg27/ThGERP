page 41 (
    name: Gutschrift
    alias: GUTSCHRIFT
    title: Gutschrift
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        title: &P41_TITEL.
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region gutschrift (
        name: Gutschrift
        type: form
        source {
            location: localDatabase
            tableName: FAKT_GUTSCHRIFTEN
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region rds (
        name: Bereiche
        type: regionDisplaySelector
        layout {
            sequence: 5
            slot: fullWidthContent
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
            cssClasses: [
                u-padding-inline-dynamic
                thg-rds
            ]
        }
        settings {
            includeShowAll: true
            rememberSelection: false
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P41_GUTS_ID
        }
    )

    region pdf (
        name: Gutschrift des Ausstellers direkt hochladen
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Üblicher Ablauf: Kunde wählen und <b>Anlegen</b>, dann unter <b>Dokumente</b> den Stundenzettel hochladen
                (vergibt Gutschriftnummer und -datum), an den Aussteller senden und dessen Gutschrift hochladen. Liegt die
                Gutschrift des Ausstellers schon vor, kann sie hier direkt hochgeladen werden – die Angaben werden ausgelesen.</p>
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P41_GUTS_ID
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region angaben (
        name: Gutschrift
        type: staticContent
        advanced {
            regionDisplaySelector: true
        }
        layout {
            sequence: 10
            parentRegion: @gutschrift
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
            ]
        }
    )

    pageItem P41_GUTS_ID (
        type: hidden
        layout {
            sequence: 1
            region: @angaben
            slot: regionBody
        }
        source {
            formRegion: @gutschrift
            column: GUTS_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P41_GUTS_MAND_ID (
