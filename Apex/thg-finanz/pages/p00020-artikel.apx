page 20 (
    name: Artikel
    alias: ARTIKEL
    title: Artikel
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        title: Artikel
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region facets (
        name: Facetten
        type: facetedSearch
        source {
            filteredRegion: @artikel
        }
        layout {
            sequence: 20
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            compactNosThreshold: 10000
            displayChartForTopNValues: 10
        }

        facet P20_SEARCH (
            type: search
            label {
                label: Suche
            }
            layout {
                sequence: 10
            }
        )

        facet P20_AKTIV (
            type: checkboxGroup
            label {
                label: Aktiv
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 20
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: AKTIV
            }
        )

        facet P20_GRUPPE (
            type: checkboxGroup
            label {
                label: Gruppe
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 30
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: GRUPPE
            }
        )

        facet P20_EINHEIT (
            type: checkboxGroup
            label {
                label: Einheit
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 40
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: EINHEIT
            }
        )

        facet P20_MWST (
            type: checkboxGroup
            label {
                label: MwSt.
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 50
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: MWST
            }
        )

    )

    region artikel (
        name: Artikel
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.ARTI_ID,
                       case a.ARTI_IST_AKTIV when 'Y' then 'Ja' else 'Nein' end as AKTIV,
                       case a.ARTI_IST_AKTIV when 'Y' then 'fa-check-circle u-success-text'
                                             else 'fa-times-circle u-danger-text' end as AKTIV_ICON,
                       a.ARTI_NUMMER,
                       a.ARTI_NAME,
                       coalesce(g.AGRP_BEZEICHNUNG, 'ohne Gruppe') as GRUPPE,
                       a.ARTI_VK_PREIS,
                       case a.ARTI_IST_BRUTTO when 'Y' then 'brutto' else 'netto' end as PREISBASIS,
                       coalesce(e.EINH_CODE, '-') as EINHEIT,
                       m.MWST_PROZENT || ' %' as MWST,
                       a.ARTI_EAN
                  from ARTI_ARTIKEL a
                  left join ARTI_ARTIKELGRUPPEN g on g.AGRP_ID = a.ARTI_AGRP_ID
                  left join ALLG_EINHEITEN e on e.EINH_ID = a.ARTI_EINH_ID
                  join ALLG_MWST_SAETZE m on m.MWST_ID = a.ARTI_MWST_ID
                 order by case a.ARTI_IST_AKTIV when 'Y' then 0 else 1 end,
                          to_number(regexp_substr(a.ARTI_NUMMER, '^\d+')) nulls last, a.ARTI_NUMMER
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: Keine Artikel gefunden.
        }

        column ARTI_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column AKTIV (
            type: plainText
            heading {
                heading: Aktiv
                alignment: center
            }
            columnFormatting {
                htmlExpression: <span class="fa #AKTIV_ICON#" title="Aktiv: #AKTIV#" aria-label="Aktiv: #AKTIV#" style="font-size:16px"></span>
            }
            layout {
                columnAlignment: center
                sequence: 15
            }
            sorting {
                sortable: false
            }
        )

        column AKTIV_ICON (
            type: hidden
            layout {
                sequence: 16
            }
        )

        column ARTI_NUMMER (
            type: link
            heading {
                heading: Nummer
            }
            layout {
                sequence: 20
            }
            link {
                target: {
                    page: 21
                    items: {
                        P21_ARTI_ID: #ARTI_ID#
                    }
                    clearCache: 21
                }
                linkText: <span class="thg-kundennr">#ARTI_NUMMER#</span>
            }
            sorting {
                sortable: false
            }
        )

        column ARTI_NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column GRUPPE (
            type: plainText
            heading {
                heading: Gruppe
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column ARTI_VK_PREIS (
            type: plainText
            heading {
                heading: Verkaufspreis
                alignment: end
            }
            appearance {
                formatMask: FML999G999G990D00
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column PREISBASIS (
            type: plainText
            heading {
                heading: Preis
            }
            layout {
                sequence: 55
            }
            sorting {
                sortable: false
            }
        )

        column EINHEIT (
            type: plainText
            heading {
                heading: Einheit
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column MWST (
            type: plainText
            heading {
                heading: MwSt.
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column ARTI_EAN (
            type: hidden
            layout {
                sequence: 80
            }
        )

    )

    button up (
        buttonName: UP
        label: Zurück zum Dashboard
        layout {
            sequence: 10
            region: @breadcrumb
            slot: up
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-arrow-up
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset (
        buttonName: RESET
        label: Zurücksetzen
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                t-Button--noUI
                t-Button--iconLeft
                t-Button--gapRight
            ]
            icon: fa-undo-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 20
                clearCache: 20
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button hinzufuegen (
        buttonName: CREATE
        label: Artikel hinzufügen
        layout {
            sequence: 20
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconRight
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 21
                clearCache: 21
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)
