page 21 (
    name: Artikel bearbeiten
    alias: ARTIKEL-BEARBEITEN
    title: &P21_TITEL.
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        title: &P21_TITEL.
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region rds (
        name: Bereiche
        type: regionDisplaySelector
        layout {
            sequence: 6
            slot: fullWidthContent
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
            cssClasses: [
                u-padding-inline-dynamic
                thg-rds
            ]
        }
        settings {
            includeShowAll: true
            rememberSelection: false
        }
    )

    region artikel (
        name: Artikel
        type: form
        source {
            location: localDatabase
            tableName: ARTI_ARTIKEL
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
        }
    )

    region stammdaten (
        name: Stammdaten
        type: staticContent
        advanced {
            regionDisplaySelector: true
        }
        layout {
            sequence: 10
            parentRegion: @artikel
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
            ]
        }
    )

    region tab-kommentar (
        name: Kommentar
        type: staticContent
        advanced {
            regionDisplaySelector: true
        }
        layout {
            sequence: 20
            parentRegion: @artikel
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
            ]
        }
    )

    region audit (
        name: Änderungsinformationen
        type: staticContent
        layout {
            sequence: 90
            parentRegion: @artikel
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
                t-Form--slimPadding
            ]
            cssClasses: [
                thg-kompakt
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P21_ARTI_ID
        }
    )

    pageItem P21_ANGELEGT_AM (
        type: displayOnly
        label {
            label: Angelegt am
            alignment: left
        }
        layout {
            sequence: 10
            region: @audit
            slot: regionBody
            alignment: left
            columnSpan: 2
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
    )

    pageItem P21_ANGELEGT_VON (
        type: displayOnly
        label {
            label: Angelegt von
            alignment: left
        }
        layout {
            sequence: 20
            region: @audit
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
    )

    pageItem P21_GEAENDERT_AM (
        type: displayOnly
        label {
            label: Geändert am
            alignment: left
        }
        layout {
            sequence: 30
            region: @audit
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
    )

    pageItem P21_GEAENDERT_VON (
        type: displayOnly
        label {
            label: Geändert von
            alignment: left
        }
        layout {
            sequence: 40
            region: @audit
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
    )

    pageItem P21_ARTI_ID (
        type: hidden
        layout {
            sequence: 1
            region: @stammdaten
            slot: regionBody
        }
        source {
            formRegion: @artikel
            column: ARTI_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P21_TITEL (
        type: hidden
        layout {
            sequence: 2
            region: @stammdaten
            slot: regionBody
        }
    )

    pageItem P21_ARTI_NUMMER (
        type: textField
        label {
            label: Nummer
            alignment: left
        }
        layout {
            sequence: 5
            region: @stammdaten
            slot: regionBody
            columnSpan: 3
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @artikel
            column: ARTI_NUMMER
            dataType: varchar2
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select to_char(nvl(max(to_number(ARTI_NUMMER default null on conversion error)), 0) + 1)
                  from ARTI_ARTIKEL
                ```
        }
    )

    pageItem P21_ARTI_IST_AKTIV (
        type: switch
        label {
            label: Aktiv
            alignment: left
        }
        layout {
            sequence: 7
            region: @stammdaten
            slot: regionBody
            startNewRow: false
            columnSpan: 2
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @artikel
            column: ARTI_IST_AKTIV
            dataType: varchar2
        }
        settings {
            useDefaults: false
            onValue: Y
            onLabel: Ja
            offValue: N
            offLabel: Nein
        }
        default {
            type: static
            staticValue: Y
        }
    )

    pageItem P21_ARTI_NAME (
        type: textField
        label {
            label: Name
            alignment: left
        }
        layout {
            sequence: 10
            region: @stammdaten
            slot: regionBody
            columnSpan: 6
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @artikel
            column: ARTI_NAME
            dataType: varchar2
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
    )

    pageItem P21_ARTI_VK_PREIS (
        type: numberField
        label {
            label: Verkaufspreis
            alignment: left
        }
        layout {
            sequence: 20
            region: @stammdaten
            slot: regionBody
            startNewRow: false
            columnSpan: 2
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            formatMask: FML999G999G990D00
        }
        source {
            formRegion: @artikel
            column: ARTI_VK_PREIS
            dataType: number
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: 0
        }
    )

    pageItem P21_ARTI_IST_BRUTTO (
        type: switch
        label {
            label: brutto
            alignment: left
        }
        layout {
            sequence: 30
            region: @stammdaten
            slot: regionBody
            startNewRow: false
            columnSpan: 1
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @artikel
            column: ARTI_IST_BRUTTO
            dataType: varchar2
        }
        settings {
            useDefaults: false
            onValue: Y
            onLabel: Ja
            offValue: N
            offLabel: Nein
        }
        default {
            type: static
            staticValue: N
        }
    )

    pageItem P21_ARTI_EINH_ID (
        type: selectList
        label {
            label: Einheit
            alignment: left
        }
        layout {
            sequence: 60
            region: @stammdaten
            slot: regionBody
            columnSpan: 3
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @artikel
            column: ARTI_EINH_ID
            dataType: number
        }
        lov {
            type: sharedComponent
            lov: @lov-einheiten
            displayNullValue: true
            nullDisplayValue: -
            displayExtraValues: false
        }
    )

    pageItem P21_ARTI_AGRP_ID (
        type: selectList
        label {
            label: Gruppe
            alignment: left
        }
        layout {
            sequence: 6
            region: @stammdaten
            slot: regionBody
            startNewRow: false
            columnSpan: 4
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @artikel
            column: ARTI_AGRP_ID
            dataType: number
        }
        lov {
            type: sharedComponent
            lov: @lov-artikelgruppen
            displayNullValue: true
            nullDisplayValue: - keine -
            displayExtraValues: false
        }
    )

    pageItem P21_ARTI_MWST_ID (
        type: selectList
        label {
            label: MwSt. in %
            alignment: left
        }
        layout {
            sequence: 80
            region: @stammdaten
            slot: regionBody
            startNewRow: false
            columnSpan: 3
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @artikel
            column: ARTI_MWST_ID
            dataType: number
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @lov-mwst-saetze
            displayNullValue: false
            displayExtraValues: false
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select MWST_ID from ALLG_MWST_SAETZE where MWST_IST_STANDARD = 'Y'
                ```
        }
    )

    pageItem P21_ARTI_BESCHREIBUNG (
        type: richTextEditor
        label {
            label: Beschreibung (wird in die Belegposition übernommen)
            alignment: left
        }
        layout {
            sequence: 90
            region: @stammdaten
            slot: regionBody
            columnSpan: 12
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @artikel
            column: ARTI_BESCHREIBUNG
            dataType: clob
        }
    )

    pageItem P21_ARTI_KOMMENTAR (
        type: textarea
        label {
            label: Kommentar (intern)
            alignment: left
        }
        layout {
            sequence: 10
            region: @tab-kommentar
            slot: regionBody
            columnSpan: 12
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @artikel
            column: ARTI_KOMMENTAR
            dataType: clob
        }
    )

    button save (
        buttonName: SAVE
        label: Speichern & Schließen
        layout {
            sequence: 20
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P21_ARTI_ID
        }
    )

    button create (
        buttonName: CREATE
        label: Anlegen
        layout {
            sequence: 30
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P21_ARTI_ID
        }
    )

    button up (
        buttonName: UP
        label: Zurück zur Artikelliste
        layout {
            sequence: 10
            region: @breadcrumb
            slot: up
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-arrow-up
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 20
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation nummer-eindeutig (
        name: Artikelnummer eindeutig
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 from ARTI_ARTIKEL
                 where ARTI_NUMMER = :P21_ARTI_NUMMER
                   and ARTI_ID <> nvl(:P21_ARTI_ID, -1)
                ```
        }
        error {
            errorMessage: Diese Artikelnummer ist bereits vergeben.
            associatedItem: @P21_ARTI_NUMMER
        }
    )

    process initialize-form-artikel (
        name: Formular Artikel initialisieren
        type: formInitialization
        formRegion: @artikel
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process titel-setzen (
        name: Seitentitel und Änderungsinformationen
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P21_TITEL := case when :P21_ARTI_ID is null then 'Neuer Artikel'
                                   else :P21_ARTI_NUMMER || ' – ' || :P21_ARTI_NAME end;
                -- angelegt/geaendert in Wiener Zeit (Server = UTC; Umrechnung in der Abfrage, nicht in der Zuweisung)
                for l in (select to_char(from_tz(ARTI_CREATED_ON, 'UTC') at time zone 'Europe/Vienna', 'DD.MM.YYYY HH24:MI:SS') as AM_A,
                                 ARTI_CREATED_BY,
                                 to_char(from_tz(ARTI_UPDATED_ON, 'UTC') at time zone 'Europe/Vienna', 'DD.MM.YYYY HH24:MI:SS') as AM_G,
                                 ARTI_UPDATED_BY
                            from ARTI_ARTIKEL where ARTI_ID = :P21_ARTI_ID) loop
                    :P21_ANGELEGT_AM   := l.AM_A;
                    :P21_ANGELEGT_VON  := l.ARTI_CREATED_BY;
                    :P21_GEAENDERT_AM  := l.AM_G;
                    :P21_GEAENDERT_VON := l.ARTI_UPDATED_BY;
                end loop;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
    )

    process process-form-artikel (
        name: Formular Artikel verarbeiten
        type: formAutoRowProcessing
        formRegion: @artikel
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Artikel gespeichert.
        }
    )

    branch nach-anlegen (
        name: Nach dem Anlegen im Artikel bleiben
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 21
                items: {
                    P21_ARTI_ID: &P21_ARTI_ID.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    branch zur-artikelliste (
        name: Zur Artikelliste
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 20
            }
        }
    )

)
