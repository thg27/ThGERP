list navigation-bar (
    name: Navigation Bar

    entry mandant (
        label: &MANDANT_NAME.
        icon {
            imageIconCssClasses: fa-building-o
        }
        layout {
            sequence: 5
        }
        link {
            target: {
                type: url
                url: #
            }
            linkAttributes: tabindex="-1" aria-disabled="true" style="pointer-events:none;cursor:default" title="Mandant (Wechsel nur im Portal)"
        }
    )

    entry --- (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry sign-out (
        label: Abmelden
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry portal (
        label: Portal
        icon {
            imageIconCssClasses: fa-th-large
        }
        layout {
            sequence: 5
        }
        link {
            target: {
                type: url
                url: f?p=THG-PORTAL:HOME:&SESSION.::&DEBUG.
            }
        }
    )

    entry home (
        label: Dashboard
        icon {
            imageIconCssClasses: fa-dashboard
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )


    entry rechnungen (
        label: Rechnungen
        icon {
            imageIconCssClasses: fa-file-text-o
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 10
            }
        }
        isCurrent {
            type: pages
            pages: [
                10
                11
            ]
        }
    )

    entry gutschriften (
        label: Gutschriften
        icon {
            imageIconCssClasses: fa-money
        }
        layout {
            sequence: 22
        }
        link {
            target: {
                page: 40
            }
        }
        isCurrent {
            type: pages
            pages: [
                40
                41
            ]
        }
    )

    entry bankdatei (
        label: Bankdatei hochladen
        icon {
            imageIconCssClasses: fa-bank
        }
        layout {
            sequence: 25
        }
        link {
            target: {
                page: 30
            }
        }
        isCurrent {
            type: pages
            pages: [
                30
            ]
        }
    )

    entry artikel (
        label: Artikel
        icon {
            imageIconCssClasses: fa-cube
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 20
            }
        }
        isCurrent {
            type: pages
            pages: [
                20
                21
            ]
        }
    )

    entry wertelisten (
        label: Wertelisten
        icon {
            imageIconCssClasses: fa-list-ul
        }
        layout {
            sequence: 90
        }
        link {
            target: {
                page: 100
            }
        }
        isCurrent {
            type: pages
            pages: [
                100
                110
                111
                120
                121
            ]
        }
    )
)

list wertelisten-finanz (
    name: Wertelisten - Finanz
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select 1 as the_level,
                   label,
                   apex_page.get_url(p_page => seite, p_clear_cache => seite) as target,
                   null as is_current_list_entry,
                   image,
                   null as image_attribute,
                   null as image_alt_attribute,
                   beschreibung as attribute1,
                   to_char(anzahl) as attribute2
              from (
                    select 'Nummernkreise' as label, 110 as seite, 'fa-sort-numeric-asc' as image, 'Belegnummern je Mandant, Belegart und Jahr (Format mit {JAHR} und {NR})' as beschreibung,
                           (select count(*) from FAKT_NUMMERNKREISE) as anzahl
                      from dual
                    union all
                    select 'Artikelgruppen' as label, 120 as seite, 'fa-tags' as image, 'Gruppen der Artikel (Dienstleistung, Office 365 …)' as beschreibung,
                           (select count(*) from ARTI_ARTIKELGRUPPEN) as anzahl
                      from dual
                   )
             order by seite
            ```
    }
)


