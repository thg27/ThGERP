app THG-FINANZ (
    name: ThG – Finanz
    version: 1.0.0
    logo {
        type: imageAndText
        imageUrl: #WORKSPACE_FILES#thg-logo.svg
        text: Finanz
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            js-defaultCollapsed
            js-navCollapsed--hidden
            t-TreeNav--classic
        ]
        list: @navigation-menu
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    authentication {
        scheme: @oracle-apex-accounts
    }
    authorization {
        sourceForRoleOrGroupSchemes: authenticationScheme
    }
    sessionManagement {
        maxSessionIdleTime: 3600
        maxSessionLength: 28800
    }
    sessionStateProtection {
        checksumSalt: 15C170F080E0CC5FB24D9D65177A8D88CEB1EAC52302CD7834989FF3C7AC6FB2
    }
    globalization {
        primaryLanguage: de
        documentDirection: leftToRight
    }
    runtime {
        allowFeedback: true
        compatibilityMode: 24.2
    }
)
