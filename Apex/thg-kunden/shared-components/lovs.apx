lov lov-rechtsformen (
    name: LOV_RECHTSFORMEN
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select RFRM_KURZ || ' – ' || RFRM_BEZEICHNUNG as d,
                   RFRM_ID as r
              from KUND_RECHTSFORMEN
             order by RFRM_KURZ
            ```
    }
    subscription {
        master: @/20000/lov-rechtsformen
    }
    columnMapping {
        return: R
        display: D
    }
)

lov lov-zahlungsbedingungen (
    name: LOV_ZAHLUNGSBEDINGUNGEN
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select ZBED_BEZEICHNUNG as d,
                   ZBED_ID as r
              from ALLG_ZAHLUNGSBEDINGUNGEN
             order by ZBED_ZIEL_TAGE, ZBED_BEZEICHNUNG
            ```
    }
    subscription {
        master: @/20000/lov-zahlungsbedingungen
    }
    columnMapping {
        return: R
        display: D
    }
)

lov lov-kunden (
    name: LOV_KUNDEN
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select KUND_NUMMER || ' – ' ||
                   case KUND_TYP when 'FIRMA' then KUND_FIRMENNAME
                                 else KUND_NACHNAME || nvl2(KUND_VORNAME, ' ' || KUND_VORNAME, null) end as d,
                   KUND_ID as r
              from KUND_KUNDEN
             order by KUND_NUMMER
            ```
    }
    subscription {
        master: @/20000/lov-kunden
    }
    columnMapping {
        return: R
        display: D
    }
)

lov lov-abteilungen (
    name: LOV_ABTEILUNGEN
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select ABTE_BEZEICHNUNG || case when ABTE_IST_AKTIV = 'N' then ' – inaktiv' end as d,
                   ABTE_ID as r
              from KUND_ABTEILUNGEN
             order by ABTE_SORTIERUNG nulls last, ABTE_BEZEICHNUNG
            ```
    }
    subscription {
        master: @/20000/lov-abteilungen
    }
    columnMapping {
        return: R
        display: D
    }
)

