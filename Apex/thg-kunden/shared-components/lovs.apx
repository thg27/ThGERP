lov lov-kunden-standorte (
    name: LOV_KUNDEN_STANDORTE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select t.STYP_BEZEICHNUNG || ': '
                   || trim(a.ADRE_STRASSE || ' ' || a.ADRE_HAUSNUMMER) || nvl2(a.ADRE_ORT, ', ' || trim(a.ADRE_PLZ || ' ' || a.ADRE_ORT), null)
                   || case when trunc(sysdate) not between nvl(s.KSTO_GUELTIG_VON, trunc(sysdate)) and nvl(s.KSTO_GUELTIG_BIS, trunc(sysdate))
                           then ' – inaktiv' end as d,
                   s.KSTO_ID as r
              from KUND_STANDORTE s
              join KUND_STANDORT_TYPEN t on t.STYP_ID = s.KSTO_STYP_ID
              join ALLG_ADRESSEN a on a.ADRE_ID = s.KSTO_ADRE_ID
             where s.KSTO_KUND_ID = :P15_KUND_ID
             order by case s.KSTO_IST_HAUPTSITZ when 'Y' then 0 else 1 end, t.STYP_BEZEICHNUNG, a.ADRE_PLZ
            ```
    }
    subscription {
        master: @/20000/lov-kunden-standorte
    }
    columnMapping {
        return: R
        display: D
    }
)

lov lov-laender (
    name: LOV_LAENDER
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select LAND_BEZEICHNUNG || ' (' || LAND_CODE || ')' as d,
                   LAND_CODE as r
              from ALLG_LAENDER
             where LAND_CODE <> 'XX'
             order by case LAND_CODE when 'AT' then 0 when 'DE' then 1 when 'CH' then 2 else 3 end, LAND_BEZEICHNUNG
            ```
    }
    subscription {
        master: @/20000/lov-laender
    }
    columnMapping {
        return: R
        display: D
    }
)

