        layout {
            sequence: 60
            region: @anschrift
            slot: regionBody
            startNewRow: false
            columnSpan: 3
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @lov-laender
            displayNullValue: false
            displayExtraValues: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Abbrechen
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Löschen
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: Adresse wirklich löschen? Adressen mit Ansprechpartnern und der Hauptsitz können nicht gelöscht werden – bitte stattdessen „Gültig bis“ setzen.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P14_KSTO_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Speichern
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P14_KSTO_ID
        }
    )

    button create (
        buttonName: CREATE
        label: Anlegen
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P14_KSTO_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Dialog abbrechen
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Formular Adresse initialisieren
        type: formInitialization
        formRegion: @standort
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process adresse-laden (
        name: Anschrift laden
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Anschrift der Adresse in die Eingabefelder
                for a in (select * from ALLG_ADRESSEN where ADRE_ID = :P14_KSTO_ADRE_ID) loop
                    :P14_ADRE_STRASSE    := a.ADRE_STRASSE;
                    :P14_ADRE_HAUSNUMMER := a.ADRE_HAUSNUMMER;
                    :P14_ADRE_ZUSATZ     := a.ADRE_ZUSATZ;
                    :P14_ADRE_PLZ        := a.ADRE_PLZ;
                    :P14_ADRE_ORT        := a.ADRE_ORT;
                    :P14_ADRE_LAND_CODE  := a.ADRE_LAND_CODE;
                end loop;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P14_KSTO_ADRE_ID
        }
    )

    process vorbelegen (
        name: Neue Adresse vorbelegen
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Neue Adresse: Lieferadresse in Oesterreich, gueltig ab heute
                select max(STYP_ID) into :P14_KSTO_STYP_ID from KUND_STANDORT_TYPEN where STYP_BEZEICHNUNG = 'Lieferadresse';
                :P14_ADRE_LAND_CODE := 'AT';
                :P14_KSTO_GUELTIG_VON := to_char(sysdate, 'DD.MM.YYYY');
                ```
        }
        execution {
            sequence: 25
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNull
            item: P14_KSTO_ID
        }
    )

    process adresse-speichern (
        name: Hauptsitz-Regel und Anschrift speichern
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- vor dem Speichern des Standorts: Kennzeichen und Bezeichnung aus dem Standorttyp, Hauptsitz-Regel pruefen,
                -- Anschrift in ALLG_ADRESSEN anlegen bzw. aendern
                declare
                    l_typ    KUND_STANDORT_TYPEN.STYP_BEZEICHNUNG%type;
                    l_hs     KUND_STANDORTE.KSTO_IST_HAUPTSITZ%type;
                    l_anz    pls_integer;
                    l_quelle ALLG_ADRESSEN.ADRE_QUELLE%type;
                begin
                    select STYP_BEZEICHNUNG into l_typ from KUND_STANDORT_TYPEN where STYP_ID = :P14_KSTO_STYP_ID;
                    if :P14_KSTO_ID is not null then
                        select KSTO_IST_HAUPTSITZ into l_hs from KUND_STANDORTE where KSTO_ID = :P14_KSTO_ID;
                        if l_hs = 'Y' and l_typ <> 'Hauptsitz' then
                            raise_application_error(-20120, 'Der Hauptsitz kann keinen anderen Standorttyp erhalten. Bitte zuerst eine neue Adresse als Hauptsitz anlegen.');
                        end if;
                    end if;
                    -- nur eine gueltige Rechnungsadresse je Kunde: Gueltigkeitszeitraeume duerfen sich nicht ueberschneiden (Lieferadressen, Baustellen usw. beliebig viele;
                    -- der Hauptsitz zaehlt nicht, er gilt nur ersatzweise als Rechnungsadresse)
                    if l_typ = 'Rechnungsadresse' then
                        select count(*)
                          into l_anz
                          from KUND_STANDORTE s
                         where s.KSTO_KUND_ID = :P14_KSTO_KUND_ID
                           and s.KSTO_IST_RECHNUNGSADR = 'Y'
                           and s.KSTO_IST_HAUPTSITZ = 'N'
                           and (:P14_KSTO_ID is null or s.KSTO_ID <> :P14_KSTO_ID)
                           and nvl(s.KSTO_GUELTIG_VON, date '1900-01-01')
                               <= nvl(to_date(:P14_KSTO_GUELTIG_BIS, 'DD.MM.YYYY'), date '9999-12-31')
                           and nvl(s.KSTO_GUELTIG_BIS, date '9999-12-31')
                               >= nvl(to_date(:P14_KSTO_GUELTIG_VON, 'DD.MM.YYYY'), date '1900-01-01');
                        if l_anz > 0 then
                            raise_application_error(-20123, 'Der Kunde hat in diesem Zeitraum bereits eine Rechnungsadresse. '
                                                            || 'Bitte die bestehende ändern oder mit „Gültig bis“ beenden.');
                        end if;
                    end if;
                    -- Kennzeichen aus dem Standorttyp; Rechnungs-/Lieferkennzeichen des Hauptsitzes setzt der Prozess nach dem Speichern
                    :P14_KSTO_IST_HAUPTSITZ    := case l_typ when 'Hauptsitz' then 'Y' else 'N' end;
                    :P14_KSTO_IST_RECHNUNGSADR := case l_typ when 'Rechnungsadresse' then 'Y' else 'N' end;
                    :P14_KSTO_IST_LIEFERADR    := case l_typ when 'Lieferadresse' then 'Y' else 'N' end;
                    -- Bezeichnung = Standorttyp; eigene Bezeichnungen aus dem Altsystem bleiben erhalten
                    select count(*) into l_anz from KUND_STANDORT_TYPEN where STYP_BEZEICHNUNG = :P14_KSTO_BEZEICHNUNG;
                    if :P14_KSTO_BEZEICHNUNG is null or l_anz > 0 then
                        :P14_KSTO_BEZEICHNUNG := l_typ;
                    end if;
                    -- neuer Hauptsitz: bisheriger Hauptsitz endet am Tag vor dem Beginn des neuen (nur ein gueltiger Hauptsitz)
                    if l_typ = 'Hauptsitz' then
                        select count(*)
                          into l_anz
                          from KUND_STANDORTE
                         where KSTO_KUND_ID = :P14_KSTO_KUND_ID and KSTO_IST_HAUPTSITZ = 'Y'
                           and (:P14_KSTO_ID is null or KSTO_ID <> :P14_KSTO_ID)
                           and KSTO_GUELTIG_VON >= nvl(to_date(:P14_KSTO_GUELTIG_VON, 'DD.MM.YYYY'), trunc(sysdate));
                        if l_anz > 0 then
                            raise_application_error(-20124, 'Der bisherige Hauptsitz beginnt nicht vor dem neuen. '
                                                            || 'Bitte beim neuen Hauptsitz ein späteres „Gültig von“ eintragen oder den bisherigen ändern.');
                        end if;
                        update KUND_STANDORTE
                           set KSTO_IST_HAUPTSITZ = 'N', KSTO_IST_RECHNUNGSADR = 'N', KSTO_IST_LIEFERADR = 'N',
                               KSTO_GUELTIG_BIS = least(nvl(KSTO_GUELTIG_BIS, date '9999-12-31'),
                                                        nvl(to_date(:P14_KSTO_GUELTIG_VON, 'DD.MM.YYYY'), trunc(sysdate)) - 1)
                         where KSTO_KUND_ID = :P14_KSTO_KUND_ID and KSTO_IST_HAUPTSITZ = 'Y'
                           and (:P14_KSTO_ID is null or KSTO_ID <> :P14_KSTO_ID);
                    end if;
                    if :P14_KSTO_ADRE_ID is not null then
                        update ALLG_ADRESSEN
                           set ADRE_STRASSE    = :P14_ADRE_STRASSE,
                               ADRE_HAUSNUMMER = :P14_ADRE_HAUSNUMMER,
                               ADRE_ZUSATZ     = :P14_ADRE_ZUSATZ,
                               ADRE_PLZ        = :P14_ADRE_PLZ,
                               ADRE_ORT        = :P14_ADRE_ORT,
                               ADRE_LAND_CODE  = :P14_ADRE_LAND_CODE,
                               ADRE_LAT        = null,   -- Position kommt wieder aus der PLZ (Kundenkarte)
                               ADRE_LON        = null
                         where ADRE_ID = :P14_KSTO_ADRE_ID;
                    else
                        -- MANUELL nur fuer Laender ohne Adressregister, sonst MIGRATION (Register AT noch nicht importiert;
                        -- Trigger ADRE_BIU laesst MANUELL fuer AT nicht zu) - wie beim Lieferanten
                        select case LAND_HAT_REGISTER when 'Y' then 'MIGRATION' else 'MANUELL' end
                          into l_quelle
                          from ALLG_LAENDER
                         where LAND_CODE = :P14_ADRE_LAND_CODE;
                        insert into ALLG_ADRESSEN (ADRE_LAND_CODE, ADRE_QUELLE, ADRE_STRASSE, ADRE_HAUSNUMMER, ADRE_ZUSATZ, ADRE_PLZ, ADRE_ORT)
                        values (:P14_ADRE_LAND_CODE, l_quelle, :P14_ADRE_STRASSE, :P14_ADRE_HAUSNUMMER, :P14_ADRE_ZUSATZ,
                                :P14_ADRE_PLZ, :P14_ADRE_ORT)
                        returning ADRE_ID into :P14_KSTO_ADRE_ID;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 5
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    process adresse-loeschen-pruefen (
        name: Löschen prüfen
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Loeschen nur ohne Hauptsitz-Kennzeichen und ohne Ansprechpartner/Kommunikation am Standort
                declare
                    l_hs  KUND_STANDORTE.KSTO_IST_HAUPTSITZ%type;
                    l_anz pls_integer;
                begin
                    select KSTO_IST_HAUPTSITZ into l_hs from KUND_STANDORTE where KSTO_ID = :P14_KSTO_ID;
                    if l_hs = 'Y' then
                        raise_application_error(-20121, 'Der Hauptsitz kann nicht gelöscht werden. Bitte zuerst eine neue Adresse als Hauptsitz anlegen.');
                    end if;
                    select (select count(*) from KUND_ANSPRECHPARTNER where ANSP_KSTO_ID = :P14_KSTO_ID)
                         + (select count(*) from KUND_STANDORT_KOMMUNIKATION where SKOM_KSTO_ID = :P14_KSTO_ID)
                      into l_anz from dual;
                    if l_anz > 0 then
                        raise_application_error(-20122, 'An dieser Adresse hängen Ansprechpartner oder Kommunikationsdaten. '
                                                        || 'Bitte die Adresse stattdessen mit „Gültig bis“ beenden.');
                    end if;
                end;
                ```
        }
        execution {
            sequence: 6
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE
        }
    )

    process hauptsitz-verwendung (
        name: Hauptsitz als Rechnungs-/Lieferadresse
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Hauptsitz gilt als Rechnungs- bzw. Lieferadresse, solange der Kunde keine eigene (gueltige) hat
                update KUND_STANDORTE h
                   set h.KSTO_IST_RECHNUNGSADR = case when exists (select 1 from KUND_STANDORTE s
                                                                   where s.KSTO_KUND_ID = h.KSTO_KUND_ID and s.KSTO_ID <> h.KSTO_ID
                                                                     and s.KSTO_IST_RECHNUNGSADR = 'Y'
                                                                     and trunc(sysdate) between nvl(s.KSTO_GUELTIG_VON, trunc(sysdate)) and nvl(s.KSTO_GUELTIG_BIS, trunc(sysdate)))
                                                      then 'N' else 'Y' end,
                       h.KSTO_IST_LIEFERADR    = case when exists (select 1 from KUND_STANDORTE s
                                                                   where s.KSTO_KUND_ID = h.KSTO_KUND_ID and s.KSTO_ID <> h.KSTO_ID
                                                                     and s.KSTO_IST_LIEFERADR = 'Y'
                                                                     and trunc(sysdate) between nvl(s.KSTO_GUELTIG_VON, trunc(sysdate)) and nvl(s.KSTO_GUELTIG_BIS, trunc(sysdate)))
                                                      then 'N' else 'Y' end
                 where h.KSTO_KUND_ID = :P14_KSTO_KUND_ID
                   and h.KSTO_IST_HAUPTSITZ = 'Y';
                ```
        }
        execution {
            sequence: 30
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process anschrift-loeschen (
        name: Anschrift löschen
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Anschrift des geloeschten Standorts entfernen, sofern sie nirgends sonst verwendet wird
                begin
                    delete from ALLG_ADRESSEN where ADRE_ID = :P14_KSTO_ADRE_ID;
                exception
                    when others then
                        if sqlcode <> -2292 then   -- noch verwendet (Fremdschluessel): Anschrift bleibt
                            raise;
                        end if;
                end;
                ```
        }
        execution {
            sequence: 35
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE
        }
    )

    process process-form (
        name: Formular Adresse verarbeiten
        type: formAutoRowProcessing
        formRegion: @standort
        execution {
            sequence: 10
        }
    )

    process close-dialog (
        name: Dialog schließen
        type: closeDialog
        execution {
            sequence: 90
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

)
