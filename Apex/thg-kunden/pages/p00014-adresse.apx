    pageItem P14_KSTO_STYP_ID (
        type: selectList
        label {
            label: Standorttyp
            alignment: left
        }
        layout {
            sequence: 20
            region: @allgemein
            slot: regionBody
            columnSpan: 6
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @standort
            column: KSTO_STYP_ID
            dataType: number
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @lov-standorttypen
            displayNullValue: false
            displayExtraValues: false
        }
    )

    pageItem P14_KSTO_GUELTIG_VON (
        type: datePicker
        label {
            label: Gültig von
            alignment: left
        }
        layout {
            sequence: 60
            region: @allgemein
            slot: regionBody
            startNewRow: false
            columnSpan: 3
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @standort
            column: KSTO_GUELTIG_VON
            dataType: date
        }
    )

    pageItem P14_KSTO_GUELTIG_BIS (
        type: datePicker
        label {
            label: Gültig bis
            alignment: left
        }
        layout {
            sequence: 70
            region: @allgemein
            slot: regionBody
            startNewRow: false
            columnSpan: 3
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @standort
            column: KSTO_GUELTIG_BIS
            dataType: date
        }
    )

