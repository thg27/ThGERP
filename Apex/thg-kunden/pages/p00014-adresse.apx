page 14 (
    name: Adresse
    alias: ADRESSE
    title: Adresse
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        width: 760
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region standort (
        name: Standort
        type: form
        source {
            location: localDatabase
            tableName: KUND_STANDORTE
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region allgemein (
        name: Adresse
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @standort
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
            ]
        }
    )

    region anschrift (
        name: Anschrift
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
            ]
        }
    )

    pageItem P14_KSTO_ID (
        type: hidden
        layout {
            sequence: 1
            region: @allgemein
            slot: regionBody
        }
        source {
            formRegion: @standort
            column: KSTO_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P14_KSTO_KUND_ID (
        type: hidden
        layout {
            sequence: 2
            region: @allgemein
            slot: regionBody
        }
        source {
            formRegion: @standort
            column: KSTO_KUND_ID
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P14_KSTO_ADRE_ID (
        type: hidden
        layout {
            sequence: 3
            region: @allgemein
            slot: regionBody
        }
        source {
            formRegion: @standort
            column: KSTO_ADRE_ID
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P14_KSTO_BEZEICHNUNG (
        type: hidden
        layout {
            sequence: 4
            region: @allgemein
            slot: regionBody
        }
        source {
            formRegion: @standort
            column: KSTO_BEZEICHNUNG
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P14_KSTO_IST_HAUPTSITZ (
        type: hidden
        layout {
            sequence: 5
            region: @allgemein
            slot: regionBody
        }
        source {
            formRegion: @standort
            column: KSTO_IST_HAUPTSITZ
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P14_KSTO_IST_RECHNUNGSADR (
        type: hidden
        layout {
            sequence: 6
            region: @allgemein
            slot: regionBody
        }
        source {
            formRegion: @standort
            column: KSTO_IST_RECHNUNGSADR
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
