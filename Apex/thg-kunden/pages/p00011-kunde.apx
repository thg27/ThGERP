    region kontakte (
        name: Kontakte
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.ANSP_ID,
                       trim(a.ANSP_TITEL || ' ' || a.ANSP_VORNAME || ' ' || a.ANSP_NACHNAME) as NAME,
                       f.FUNK_BEZEICHNUNG as FUNKTION,
                       ab.ABTE_BEZEICHNUNG as ABTEILUNG,
                       (select max(x.AKOM_WERT) keep (dense_rank first order by x.AKOM_IST_BEVORZUGT desc, k.KART_SORTIERUNG, x.AKOM_ID)
                          from KUND_ANSPRECHPARTNER_KOMMUNIKATION x
                          join ALLG_KOMMUNIKATIONSARTEN k on k.KART_ID = x.AKOM_KART_ID
                         where x.AKOM_ANSP_ID = a.ANSP_ID and k.KART_CODE in ('TEL', 'MOBIL')) as TELEFON,
                       (select max(x.AKOM_WERT) keep (dense_rank first order by x.AKOM_IST_BEVORZUGT desc, x.AKOM_ID)
                          from KUND_ANSPRECHPARTNER_KOMMUNIKATION x
                          join ALLG_KOMMUNIKATIONSARTEN k on k.KART_ID = x.AKOM_KART_ID
                         where x.AKOM_ANSP_ID = a.ANSP_ID and k.KART_CODE = 'EMAIL') as EMAIL,
                       t.STYP_BEZEICHNUNG || nvl2(ad.ADRE_ORT, ' ' || ad.ADRE_ORT, null) as STANDORT,
                       case a.ANSP_IST_HAUPTKONTAKT when 'Y' then 'fa-star u-warning-text' end as HAUPT_ICON,
                       case a.ANSP_IST_HAUPTKONTAKT when 'Y' then 'Hauptkontakt' end as HAUPT
                  from KUND_ANSPRECHPARTNER a
                  join KUND_STANDORTE s on s.KSTO_ID = a.ANSP_KSTO_ID
                  join KUND_STANDORT_TYPEN t on t.STYP_ID = s.KSTO_STYP_ID
                  left join ALLG_ADRESSEN ad on ad.ADRE_ID = s.KSTO_ADRE_ID
                  left join KUND_FUNKTIONEN f on f.FUNK_ID = a.ANSP_FUNK_ID
                  left join KUND_ABTEILUNGEN ab on ab.ABTE_ID = a.ANSP_ABTE_ID
                 where s.KSTO_KUND_ID = :P11_KUND_ID
                 order by case a.ANSP_IST_HAUPTKONTAKT when 'Y' then 0 else 1 end, a.ANSP_NACHNAME, a.ANSP_VORNAME
                ```
            pageItemsToSubmit: [
                P11_KUND_ID
            ]
        }
