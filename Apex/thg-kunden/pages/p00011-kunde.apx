    dynamicAction typ-firma-privat (
        name: Felder je nach Typ ein-/ausblenden
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P11_KUND_TYP
        }
        clientSideCondition {
            type: item=value
            item: P11_KUND_TYP
            value: FIRMA
        }

        action firma-zeigen (
            action: show
            affectedElements {
                selectionType: items
                items: P11_KUND_FIRMENNAME,P11_KUND_RFRM_ID,P11_KUND_FIRMENBUCHNR
            }
            execution {
                sequence: 10
            }
        )

        action privat-verbergen (
            action: hide
            affectedElements {
                selectionType: items
                items: P11_KUND_ANREDE,P11_KUND_VORNAME,P11_KUND_NACHNAME
            }
            execution {
                sequence: 20
            }
        )

        action firma-verbergen (
            action: hide
            affectedElements {
                selectionType: items
                items: P11_KUND_FIRMENNAME,P11_KUND_RFRM_ID,P11_KUND_FIRMENBUCHNR
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
            }
        )

        action privat-zeigen (
            action: show
            affectedElements {
                selectionType: items
                items: P11_KUND_ANREDE,P11_KUND_VORNAME,P11_KUND_NACHNAME
            }
            execution {
                sequence: 40
                fireWhenEventResultIs: false
            }
        )

    )

