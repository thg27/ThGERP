page 11 (
    name: Kunde
    alias: KUNDE
    title: Kunde
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: true
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        title: &P11_TITEL.
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region kopfinfo (
        name: Kennzahlen
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select k.ANZAHL, k.UMSATZ, k.OFFEN, k.LETZTE, k.LETZTE_URL,
                       -- aktuelle Kundenbetreuer (Rolle KB, ohne "gueltig bis"), Hauptverantwortlicher zuerst - ausserhalb der
                       -- Aggregation der Rechnungen (sonst ORA-00937)
                       nvl((select listagg(m.MITA_NAME, ', ') within group (order by case z.KMIT_IST_HAUPTVERANTW when 'Y' then 0 else 1 end,
                                                                                   m.MITA_NAME)
                              from KUND_KUNDEN_MITARBEITER z
                              join KUND_BETREUUNGSROLLEN r on r.BROL_ID = z.KMIT_BROL_ID and r.BROL_CODE = 'KB'
                              join ALLG_MITARBEITER m on m.MITA_ID = z.KMIT_MITA_ID
                             where z.KMIT_KUND_ID = :P11_KUND_ID
                               and z.KMIT_GUELTIG_BIS is null), '–') as BETREUER
                  from (select count(*) as ANZAHL,
                               to_char(nvl(sum(RECH_SUMME_NETTO), 0), 'FM999G999G990D00', 'NLS_NUMERIC_CHARACTERS='',.''') || ' €' as UMSATZ,
                               to_char(nvl(sum(OFFEN), 0), 'FM999G999G990D00', 'NLS_NUMERIC_CHARACTERS='',.''') || ' €' as OFFEN,
                               case when count(*) = 0 then '–'
                                    else to_char(max(RECH_DATUM), 'DD.MM.YYYY')
                                         || ' (' || max(RECH_NUMMER) keep (dense_rank last order by RECH_DATUM, RECH_NUMMER) || ')' end as LETZTE,
                               -- Link auf die letzte Rechnung (App 20050 Seite 11, mit Pruefsumme)
                               case when count(*) > 0 then
                                   apex_page.get_url(p_application => '20050', p_page => 11, p_clear_cache => 11, p_items => 'P11_RECH_ID',
                                                     p_values => max(RECH_ID) keep (dense_rank last order by RECH_DATUM, RECH_NUMMER))
                               end as LETZTE_URL
                          from FAKT_RECHNUNGEN_V
                         where RECH_KUND_ID = :P11_KUND_ID
                           and RECH_MAND_ID = :MANDANT_ID
                           and RECH_STATUS in ('OFFEN', 'BEZAHLT')) k
                ```
            pageItemsToSubmit: [
                P11_KUND_ID
            ]
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--noPadding
                margin-left-md
            ]
        }
        componentAppearance {
            template: @/contextual-info
            templateOptions: [
                #DEFAULT#
                t-ContextualInfo-label--stacked
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_KUND_ID
        }
        messages {
            whenNoDataFound: keine Rechnungen
        }

        column ANZAHL (
            type: plainText
            heading {
                heading: Rechnungen
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column UMSATZ (
            type: plainText
            heading {
                heading: Umsatz (netto)
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column OFFEN (
            type: plainText
            heading {
                heading: Offen
            }
            layout {
                sequence: 22
            }
            sorting {
                sortable: false
            }
        )

        column LETZTE_URL (
            type: hidden
            layout {
                sequence: 25
            }
        )

        column LETZTE (
            type: plainText
            heading {
                heading: Letzte Rechnung
            }
            columnFormatting {
                htmlExpression: <a href="#LETZTE_URL#" title="Letzte Rechnung öffnen">#LETZTE#</a>
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column BETREUER (
            type: plainText
            heading {
                heading: Kundenbetreuer
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

    )

