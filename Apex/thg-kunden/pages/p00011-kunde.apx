    validation konzernmutter-nicht-selbst (
        name: Konzernmutter nicht der Kunde selbst
        execution {
            sequence: 40
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 from dual where :P11_KUND_PARENT_KUND_ID = :P11_KUND_ID
                ```
        }
        error {
            errorMessage: Ein Kunde kann nicht seine eigene Konzernmutter sein.
            associatedItem: @P11_KUND_PARENT_KUND_ID
        }
    )

    process initialize-form-kunde (
        name: Formular Kunde initialisieren
        type: formInitialization
        formRegion: @kunde
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process titel-setzen (
        name: Seitentitel setzen
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P11_TITEL := case
                                  when :P11_KUND_ID is null then 'Neuer Kunde'
                                  else :P11_KUND_NUMMER || ' – ' ||
                                       case :P11_KUND_TYP
                                            when 'FIRMA' then :P11_KUND_FIRMENNAME
                                            else :P11_KUND_NACHNAME || nvl2(:P11_KUND_VORNAME, ' ' || :P11_KUND_VORNAME, null)
                                       end
                              end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
    )

    process kundenbetreuer-laden (
        name: Kundenbetreuer laden
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- aktuelle Kundenbetreuer (Rolle KB, ohne "gueltig bis")
                select listagg(z.KMIT_MITA_ID, ':') within group (order by z.KMIT_GUELTIG_VON, z.KMIT_ID)
                  into :P11_KUNDENBETREUER
                  from KUND_KUNDEN_MITARBEITER z
                  join KUND_BETREUUNGSROLLEN r on r.BROL_ID = z.KMIT_BROL_ID and r.BROL_CODE = 'KB'
                 where z.KMIT_KUND_ID = :P11_KUND_ID
                   and z.KMIT_GUELTIG_BIS is null;
                ```
        }
        execution {
            sequence: 31
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_KUND_ID
        }
    )

    process letzte-aenderung (
        name: Letzte Änderung am Kunden und seinen Detaildaten
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Angelegt am in Wiener Zeit (Zeitstempel sind Serverzeit UTC)
                select to_char(from_tz(cast(KUND_CREATED_ON as timestamp), 'UTC') at time zone 'Europe/Vienna',
                               'DD.MM.YYYY HH24:MI:SS')
                  into :P11_ANGELEGT_AM
                  from KUND_KUNDEN
                 where KUND_ID = :P11_KUND_ID;
                -- juengste Aenderung (geaendert oder neu angelegt) am Kunden und an allen Detaildaten;
                -- Detaildaten, die zusammen mit dem Kunden angelegt wurden, zaehlen nicht als Aenderung
                for r in (
                    with k as (select KUND_ID, KUND_CREATED_ON from KUND_KUNDEN where KUND_ID = :P11_KUND_ID),
                    s as (select x.* from KUND_STANDORTE x join k on x.KSTO_KUND_ID = k.KUND_ID),
                    p as (select a.* from KUND_ANSPRECHPARTNER a join s on a.ANSP_KSTO_ID = s.KSTO_ID),
                    alle (AM, VON, NEU) as (
                        select KUND_UPDATED_ON, KUND_UPDATED_BY, 'N' from KUND_KUNDEN where KUND_ID = :P11_KUND_ID
                        union all select KSTO_UPDATED_ON, KSTO_UPDATED_BY, 'N' from s
                        union all select KSTO_CREATED_ON, KSTO_CREATED_BY, 'Y' from s
                        union all select a.ADRE_UPDATED_ON, a.ADRE_UPDATED_BY, 'N' from ALLG_ADRESSEN a join s on s.KSTO_ADRE_ID = a.ADRE_ID
                        union all select x.SKOM_UPDATED_ON, x.SKOM_UPDATED_BY, 'N' from KUND_STANDORT_KOMMUNIKATION x join s on x.SKOM_KSTO_ID = s.KSTO_ID
                        union all select x.SKOM_CREATED_ON, x.SKOM_CREATED_BY, 'Y' from KUND_STANDORT_KOMMUNIKATION x join s on x.SKOM_KSTO_ID = s.KSTO_ID
                        union all select ANSP_UPDATED_ON, ANSP_UPDATED_BY, 'N' from p
                        union all select ANSP_CREATED_ON, ANSP_CREATED_BY, 'Y' from p
                        union all select x.AKOM_UPDATED_ON, x.AKOM_UPDATED_BY, 'N' from KUND_ANSPRECHPARTNER_KOMMUNIKATION x join p on x.AKOM_ANSP_ID = p.ANSP_ID
                        union all select x.AKOM_CREATED_ON, x.AKOM_CREATED_BY, 'Y' from KUND_ANSPRECHPARTNER_KOMMUNIKATION x join p on x.AKOM_ANSP_ID = p.ANSP_ID
                        union all select x.KMIT_UPDATED_ON, x.KMIT_UPDATED_BY, 'N' from KUND_KUNDEN_MITARBEITER x join k on x.KMIT_KUND_ID = k.KUND_ID
                        union all select x.KMIT_CREATED_ON, x.KMIT_CREATED_BY, 'Y' from KUND_KUNDEN_MITARBEITER x join k on x.KMIT_KUND_ID = k.KUND_ID
                        -- Dokumente nur des angemeldeten Mandanten
                        union all select x.KDOK_UPDATED_ON, x.KDOK_UPDATED_BY, 'N' from KUND_KUNDEN_DOKUMENTE x join k on x.KDOK_KUND_ID = k.KUND_ID where x.KDOK_MAND_ID = :MANDANT_ID
                        union all select x.KDOK_CREATED_ON, x.KDOK_CREATED_BY, 'Y' from KUND_KUNDEN_DOKUMENTE x join k on x.KDOK_KUND_ID = k.KUND_ID where x.KDOK_MAND_ID = :MANDANT_ID
                    )
                    -- Zeitstempel sind Serverzeit (UTC) - Anzeige in Wiener Zeit
                    select to_char(from_tz(cast(alle.AM as timestamp), 'UTC') at time zone 'Europe/Vienna',
                                   'DD.MM.YYYY HH24:MI:SS') as AM, alle.VON
                      from alle cross join k
                     where alle.AM is not null
                       and (alle.NEU = 'N' or alle.AM > k.KUND_CREATED_ON + interval '1' minute)
                     order by alle.AM desc
                     fetch first 1 row only)
                loop
                    :P11_GEAENDERT_AM  := r.AM;
                    :P11_GEAENDERT_VON := r.VON;
                end loop;
                ```
        }
        execution {
            sequence: 33
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_KUND_ID
        }
    )

    process kurzname-pruefen (
        name: Kurzname auf Eindeutigkeit prüfen
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Kurzname eindeutig (ohne Gross-/Kleinschreibung; in der Datenbank zusaetzlich KUND_KURZNAME_UK)
                declare
                    l_anz pls_integer;
                begin
                    :P11_KUND_KURZNAME := trim(:P11_KUND_KURZNAME);
                    select count(*)
                      into l_anz
                      from KUND_KUNDEN
                     where upper(KUND_KURZNAME) = upper(:P11_KUND_KURZNAME)
                       and (:P11_KUND_ID is null or KUND_ID <> :P11_KUND_ID)
                       and :P11_KUND_KURZNAME is not null;
                    if l_anz > 0 then
                        raise_application_error(-20126, 'Der Kurzname „' || :P11_KUND_KURZNAME
                                                        || '“ ist bereits bei einem anderen Kunden vergeben.');
                    end if;
                end;
                ```
        }
        execution {
            sequence: 5
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    process process-form-kunde (
        name: Formular Kunde verarbeiten
        type: formAutoRowProcessing
        formRegion: @kunde
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Kunde gespeichert.
        }
    )

    process kundenbetreuer-speichern (
        name: Kundenbetreuer speichern
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Mehrfachauswahl mit KUND_KUNDEN_MITARBEITER (Rolle KB) abgleichen, mit Historie:
                -- entfernte Betreuer erhalten "gueltig bis" heute, neue beginnen heute; genau ein Hauptverantwortlicher
                declare
                    l_kb number;
                begin
                    select BROL_ID into l_kb from KUND_BETREUUNGSROLLEN where BROL_CODE = 'KB';
                    update KUND_KUNDEN_MITARBEITER
                       set KMIT_GUELTIG_BIS = trunc(sysdate), KMIT_IST_HAUPTVERANTW = 'N'
                     where KMIT_KUND_ID = :P11_KUND_ID and KMIT_BROL_ID = l_kb and KMIT_GUELTIG_BIS is null
                       and KMIT_MITA_ID not in (select column_value from table(apex_string.split_numbers(:P11_KUNDENBETREUER, ':')));
                    for m in (select column_value as MITA_ID from table(apex_string.split_numbers(:P11_KUNDENBETREUER, ':'))
                               where column_value not in (select KMIT_MITA_ID from KUND_KUNDEN_MITARBEITER
                                                           where KMIT_KUND_ID = :P11_KUND_ID and KMIT_BROL_ID = l_kb
                                                             and KMIT_GUELTIG_BIS is null))
                    loop
                        -- heute beendet und wieder gewaehlt: Zuordnung wieder oeffnen, sonst neu ab heute
                        update KUND_KUNDEN_MITARBEITER
                           set KMIT_GUELTIG_BIS = null
                         where KMIT_KUND_ID = :P11_KUND_ID and KMIT_MITA_ID = m.MITA_ID and KMIT_BROL_ID = l_kb
                           and KMIT_GUELTIG_VON = trunc(sysdate);
                        if sql%rowcount = 0 then
                            insert into KUND_KUNDEN_MITARBEITER (KMIT_KUND_ID, KMIT_MITA_ID, KMIT_BROL_ID, KMIT_IST_HAUPTVERANTW,
                                                                 KMIT_GUELTIG_VON)
                            values (:P11_KUND_ID, m.MITA_ID, l_kb, 'N', trunc(sysdate));
                        end if;
                    end loop;
                    -- ohne Hauptverantwortlichen: der am laengsten zugeordnete Betreuer
                    update KUND_KUNDEN_MITARBEITER
                       set KMIT_IST_HAUPTVERANTW = 'Y'
                     where KMIT_ID = (select min(KMIT_ID) keep (dense_rank first order by KMIT_GUELTIG_VON, KMIT_ID)
                                        from KUND_KUNDEN_MITARBEITER
                                       where KMIT_KUND_ID = :P11_KUND_ID and KMIT_BROL_ID = l_kb and KMIT_GUELTIG_BIS is null)
                       and not exists (select 1 from KUND_KUNDEN_MITARBEITER
                                        where KMIT_KUND_ID = :P11_KUND_ID and KMIT_BROL_ID = l_kb and KMIT_GUELTIG_BIS is null
                                          and KMIT_IST_HAUPTVERANTW = 'Y');
                end;
                ```
        }
        execution {
            sequence: 16
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    branch zur-kundenliste (
        name: Zur Kundenliste
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 10
            }
        }
    )

)
