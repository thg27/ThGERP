                t-Region--scrollBody
            ]
            cssClasses: [
                thg-ohne-titel
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_KUND_ID
        }
        messages {
            whenNoDataFound: Keine Dokumente hinterlegt.
        }

