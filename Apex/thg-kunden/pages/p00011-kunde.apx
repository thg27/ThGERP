    region kommunikation (
        name: Kommunikation
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.SKOM_ID,
                       k.KART_BEZEICHNUNG as ART,
                       c.SKOM_WERT as WERT,
                       c.SKOM_BEZEICHNUNG as BEZEICHNUNG,
                       case c.SKOM_IST_BEVORZUGT when 'Y' then 'fa-star u-warning-text' end as BEVORZUGT_ICON,
                       case c.SKOM_IST_BEVORZUGT when 'Y' then 'bevorzugt' end as BEVORZUGT,
                       t.STYP_BEZEICHNUNG || nvl2(a.ADRE_ORT, ' ' || a.ADRE_ORT, null)
                       || case when trunc(sysdate) not between nvl(s.KSTO_GUELTIG_VON, trunc(sysdate)) and nvl(s.KSTO_GUELTIG_BIS, trunc(sysdate))
                               then ' (nicht gültig)' end as ADRESSE
                  from KUND_STANDORT_KOMMUNIKATION c
                  join KUND_STANDORTE s on s.KSTO_ID = c.SKOM_KSTO_ID
                  join KUND_STANDORT_TYPEN t on t.STYP_ID = s.KSTO_STYP_ID
                  left join ALLG_ADRESSEN a on a.ADRE_ID = s.KSTO_ADRE_ID
                  join ALLG_KOMMUNIKATIONSARTEN k on k.KART_ID = c.SKOM_KART_ID
                 where s.KSTO_KUND_ID = :P11_KUND_ID
                 order by case s.KSTO_IST_HAUPTSITZ when 'Y' then 0 else 1 end, s.KSTO_ID, k.KART_SORTIERUNG,
                          case c.SKOM_IST_BEVORZUGT when 'Y' then 0 else 1 end, c.SKOM_ID
                ```
            pageItemsToSubmit: [
                P11_KUND_ID
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        layout {
            sequence: 15
            parentRegion: @kunde
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
            cssClasses: [
                thg-ohne-titel
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_KUND_ID
        }
        messages {
            whenNoDataFound: Keine Telefonnummern, E-Mail-Adressen oder Homepage erfasst.
        }

        column SKOM_ID (
            type: link
            heading {
                heading: Bearbeiten
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 19
                    items: {
                        P19_SKOM_ID: #SKOM_ID#
