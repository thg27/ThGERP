    dynamicAction aenderung-nach-dialog (
        name: Änderungsinformationen nach Dialog aktualisieren
        execution {
            sequence: 60
        }
        when {
            event: apexafterclosedialog
            selectionType: jQuerySelector
            jquerySelector: body
        }

        action letzte-aenderung-laden (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    select to_char(from_tz(cast(KUND_CREATED_ON as timestamp), 'UTC') at time zone 'Europe/Vienna',
                    'DD.MM.YYYY HH24:MI:SS')
                    into :P11_ANGELEGT_AM
                    from KUND_KUNDEN
                    where KUND_ID = :P11_KUND_ID;
                    for r in (
                    with k as (select KUND_ID, KUND_CREATED_ON from KUND_KUNDEN where KUND_ID = :P11_KUND_ID),
                    s as (select x.* from KUND_STANDORTE x join k on x.KSTO_KUND_ID = k.KUND_ID),
                    p as (select a.* from KUND_ANSPRECHPARTNER a join s on a.ANSP_KSTO_ID = s.KSTO_ID),
                    alle (AM, VON, NEU) as (
                    select KUND_UPDATED_ON, KUND_UPDATED_BY, 'N' from KUND_KUNDEN where KUND_ID = :P11_KUND_ID
                    union all select KSTO_UPDATED_ON, KSTO_UPDATED_BY, 'N' from s
                    union all select KSTO_CREATED_ON, KSTO_CREATED_BY, 'Y' from s
                    union all select a.ADRE_UPDATED_ON, a.ADRE_UPDATED_BY, 'N' from ALLG_ADRESSEN a join s on s.KSTO_ADRE_ID = a.ADRE_ID
                    union all select x.SKOM_UPDATED_ON, x.SKOM_UPDATED_BY, 'N' from KUND_STANDORT_KOMMUNIKATION x join s on x.SKOM_KSTO_ID = s.KSTO_ID
                    union all select x.SKOM_CREATED_ON, x.SKOM_CREATED_BY, 'Y' from KUND_STANDORT_KOMMUNIKATION x join s on x.SKOM_KSTO_ID = s.KSTO_ID
                    union all select ANSP_UPDATED_ON, ANSP_UPDATED_BY, 'N' from p
                    union all select ANSP_CREATED_ON, ANSP_CREATED_BY, 'Y' from p
                    union all select x.AKOM_UPDATED_ON, x.AKOM_UPDATED_BY, 'N' from KUND_ANSPRECHPARTNER_KOMMUNIKATION x join p on x.AKOM_ANSP_ID = p.ANSP_ID
                    union all select x.AKOM_CREATED_ON, x.AKOM_CREATED_BY, 'Y' from KUND_ANSPRECHPARTNER_KOMMUNIKATION x join p on x.AKOM_ANSP_ID = p.ANSP_ID
                    union all select x.KMIT_UPDATED_ON, x.KMIT_UPDATED_BY, 'N' from KUND_KUNDEN_MITARBEITER x join k on x.KMIT_KUND_ID = k.KUND_ID
                    union all select x.KMIT_CREATED_ON, x.KMIT_CREATED_BY, 'Y' from KUND_KUNDEN_MITARBEITER x join k on x.KMIT_KUND_ID = k.KUND_ID
                    union all select x.KDOK_UPDATED_ON, x.KDOK_UPDATED_BY, 'N' from KUND_KUNDEN_DOKUMENTE x join k on x.KDOK_KUND_ID = k.KUND_ID where x.KDOK_MAND_ID = :MANDANT_ID
                    union all select x.KDOK_CREATED_ON, x.KDOK_CREATED_BY, 'Y' from KUND_KUNDEN_DOKUMENTE x join k on x.KDOK_KUND_ID = k.KUND_ID where x.KDOK_MAND_ID = :MANDANT_ID
                    )
                    select to_char(from_tz(cast(alle.AM as timestamp), 'UTC') at time zone 'Europe/Vienna',
                    'DD.MM.YYYY HH24:MI:SS') as AM, alle.VON
                    from alle cross join k
                    where alle.AM is not null
                    and (alle.NEU = 'N' or alle.AM > k.KUND_CREATED_ON + interval '1' minute)
                    order by alle.AM desc
                    fetch first 1 row only)
                    loop
                    :P11_GEAENDERT_AM := r.AM;
                    :P11_GEAENDERT_VON := r.VON;
                    end loop;
                    ```
                itemsToSubmit: [
                    P11_KUND_ID
                ]
                itemsToReturn: [
                    P11_GEAENDERT_AM
                    P11_GEAENDERT_VON
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    region dokumente (
        name: Dokumente
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.KDOK_ID,
                       a.DART_BEZEICHNUNG as DOKUMENTART,
                       d.KDOK_BEZEICHNUNG as BEZEICHNUNG,
                       d.KDOK_DATEINAME,
                       d.KDOK_MIME_TYPE,
                       d.KDOK_ID as DOWNLOAD,
                       -- im Browser darstellbar (PDF, Bilder, Text): Anzeige im Modalfenster (Seite 18)
                       case when d.KDOK_MIME_TYPE = 'application/pdf'
                                 or d.KDOK_MIME_TYPE in ('image/png', 'image/jpeg', 'image/gif', 'image/webp', 'image/svg+xml', 'image/bmp')
                                 or d.KDOK_MIME_TYPE like 'text/plain%'
                            then 'fa-eye' else 'u-hidden' end as ANZEIGEN_ICON,
                       d.KDOK_ID as ANZEIGEN,
                       apex_util.filesize_mask(d.KDOK_GROESSE) as GROESSE,
                       -- Zeitstempel sind Serverzeit (UTC) - Anzeige in Wiener Zeit
                       to_char(from_tz(cast(d.KDOK_CREATED_ON as timestamp), 'UTC') at time zone 'Europe/Vienna', 'DD.MM.YYYY HH24:MI')
                       || ' ' || lower(d.KDOK_CREATED_BY) as HOCHGELADEN,
                       d.KDOK_BESCHREIBUNG as BESCHREIBUNG
                  from KUND_KUNDEN_DOKUMENTE d
                  join KUND_DOKUMENTARTEN a on a.DART_ID = d.KDOK_DART_ID
                 where d.KDOK_KUND_ID = :P11_KUND_ID
                   and d.KDOK_MAND_ID = :MANDANT_ID   -- nur Dokumente des im Portal gewaehlten Mandanten
                 order by d.KDOK_CREATED_ON desc
                ```
            pageItemsToSubmit: [
                P11_KUND_ID
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        layout {
            sequence: 39
            parentRegion: @kunde
            slot: regionBody
