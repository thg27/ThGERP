    region adressen (
        name: Adressen
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.KSTO_ID,
                       t.STYP_BEZEICHNUNG as TYP,
                       ltrim(case s.KSTO_IST_HAUPTSITZ when 'Y' then 'Hauptsitz' end
                             || case s.KSTO_IST_RECHNUNGSADR when 'Y' then ' · Rechnung' end
                             || case s.KSTO_IST_LIEFERADR when 'Y' then ' · Lieferung' end, ' ·') as VERWENDUNG,
                       trim(a.ADRE_STRASSE || ' ' || a.ADRE_HAUSNUMMER || nvl2(a.ADRE_ZUSATZ, ', ' || a.ADRE_ZUSATZ, null)) as STRASSE,
                       trim(a.ADRE_PLZ || ' ' || a.ADRE_ORT) as ORT,
                       l.LAND_BEZEICHNUNG as LAND,
                       -- gueltig, wenn das Systemdatum im Gueltigkeitszeitraum liegt (offene Grenzen gelten als erfuellt)
                       case when trunc(sysdate) between nvl(s.KSTO_GUELTIG_VON, trunc(sysdate)) and nvl(s.KSTO_GUELTIG_BIS, trunc(sysdate))
                            then 'fa-check-circle u-success-text' else 'fa-times-circle u-danger-text' end as GUELTIG_ICON,
                       case when trunc(sysdate) between nvl(s.KSTO_GUELTIG_VON, trunc(sysdate)) and nvl(s.KSTO_GUELTIG_BIS, trunc(sysdate))
                            then 'gültig' else 'nicht gültig' end
                       || nvl2(coalesce(s.KSTO_GUELTIG_VON, s.KSTO_GUELTIG_BIS),
                               ' (' || nvl(to_char(s.KSTO_GUELTIG_VON, 'DD.MM.YYYY'), '…') || ' – '
                                    || nvl(to_char(s.KSTO_GUELTIG_BIS, 'DD.MM.YYYY'), '…') || ')', null) as GUELTIG
                  from KUND_STANDORTE s
                  join KUND_STANDORT_TYPEN t on t.STYP_ID = s.KSTO_STYP_ID
                  join ALLG_ADRESSEN a on a.ADRE_ID = s.KSTO_ADRE_ID
                  left join ALLG_LAENDER l on l.LAND_CODE = a.ADRE_LAND_CODE
                 where s.KSTO_KUND_ID = :P11_KUND_ID
                 order by case when trunc(sysdate) between nvl(s.KSTO_GUELTIG_VON, trunc(sysdate)) and nvl(s.KSTO_GUELTIG_BIS, trunc(sysdate))
                               then 0 else 1 end,
                          -- innerhalb gueltig/nicht gueltig: Hauptsitz, Rechnungsadresse, Lieferadressen, dann der Rest
                          case t.STYP_BEZEICHNUNG when 'Hauptsitz' then 1 when 'Rechnungsadresse' then 2 when 'Lieferadresse' then 3 else 4 end,
                          t.STYP_BEZEICHNUNG, a.ADRE_PLZ, a.ADRE_STRASSE
                ```
            pageItemsToSubmit: [
                P11_KUND_ID
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        layout {
            sequence: 35
            parentRegion: @kunde
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
            cssClasses: [
                thg-ohne-titel
