page 1 (
    name: Dashboard
    alias: HOME
    title: Dashboard
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            /* Summe offen rechts im Titel der offenen Rechnungen (rot, nur wenn > 0) */
            .t-Region-title:has(.thg-titel-saldo) { display: flex; align-items: baseline; gap: 1rem; }
            .thg-titel-saldo { margin-left: auto; font-weight: 600; font-variant-numeric: tabular-nums; }
            /* Hinweis "in Bearbeitung" (Rechnung nach "Rechnung bearbeiten", noch nicht neu gedruckt) */
            .thg-badge--IN_BEARBEITUNG { background-color: var(--ut-palette-warning, #ef6c00); color: var(--ut-palette-warning-contrast, #fff); }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            <p>Dashboard der Kundenstammdaten: Kennzahlen zu den Kunden (mandantenübergreifend) und zu den Rechnungen des im Portal gewählten Mandanten.</p>
            ```
    }

    region kennzahlen (
        name: Kennzahlen
        type: themeTemplateComponent/metricCard
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- Kunden sind mandantenuebergreifend, Rechnungen und erhaltene Gutschriften (FAKT_BELEGE_V) gelten fuer den im Portal gewaehlten Mandanten
                -- (Umsatz = Rechnungen OFFEN/TEILBEZAHLT/BEZAHLT netto, ohne Entwuerfe und stornierte)
                with kunden as (
                    select k.KUND_ID, k.KUND_STATUS, k.KUND_KUNDE_SEIT
                      from KUND_KUNDEN k
                ), rechnungen as (
                    select r.RECH_ID, r.RECH_KUND_ID, r.RECH_DATUM, r.RECH_SUMME_NETTO, r.OFFEN_NETTO as OFFEN, r.IST_UEBERFAELLIG
                      from FAKT_BELEGE_V r
                     where r.RECH_MAND_ID = :MANDANT_ID
                       and r.RECH_STATUS in ('GEDRUCKT', 'GESENDET', 'IN_BEARBEITUNG', 'TEILBEZAHLT', 'BEZAHLT')
                )
                select 1 as ID, 'Aktive Kunden' as TITLE,
                       to_char((select count(*) from kunden where KUND_STATUS = 'AKTIV'), 'FM999G999') as METRIC,
                       to_char((select count(*) from kunden), 'FM999G999') || ' Kunden gesamt' as META,
                       apex_page.get_url(p_page => 10, p_clear_cache => 10, p_items => 'P10_STATUS', p_values => 'AKTIV') as LINK
                  from dual
                union all
                select 2, 'Neue Kunden ' || to_char(sysdate, 'YYYY'),
                       to_char((select count(*) from kunden where KUND_KUNDE_SEIT >= trunc(sysdate, 'YYYY')), 'FM999G999'),
                       'Kunde seit ' || to_char(trunc(sysdate, 'YYYY'), 'DD.MM.YYYY'),
                       apex_page.get_url(p_page => 10, p_clear_cache => 10, p_items => 'P10_SEIT_JAHR', p_values => to_char(sysdate, 'YYYY'))
                  from dual
                union all
                select 3, 'Umsatz ' || to_char(sysdate, 'YYYY'),
                       to_char((select nvl(sum(RECH_SUMME_NETTO), 0) from rechnungen where RECH_DATUM >= trunc(sysdate, 'YYYY')),
                               'FM999G999G990', 'NLS_NUMERIC_CHARACTERS='',.''') || ' €',
                       to_char((select nvl(sum(RECH_SUMME_NETTO), 0) from rechnungen
                                 where RECH_DATUM >= add_months(trunc(sysdate, 'YYYY'), -12)
                                   and RECH_DATUM < add_months(trunc(sysdate), -12) + 1),
                               'FM999G999G990', 'NLS_NUMERIC_CHARACTERS='',.''') || ' € im Vorjahr bis heute',
                       apex_page.get_url(p_application => '20050', p_page => 10, p_clear_cache => 10)
                  from dual
                union all
                select 4, 'Kunden mit Umsatz ' || to_char(sysdate, 'YYYY'),
                       to_char((select count(distinct RECH_KUND_ID) from rechnungen where RECH_DATUM >= trunc(sysdate, 'YYYY')), 'FM999G999'),
                       to_char((select count(distinct RECH_KUND_ID) from rechnungen
                                 where RECH_DATUM >= add_months(trunc(sysdate, 'YYYY'), -12)
                                   and RECH_DATUM < trunc(sysdate, 'YYYY')), 'FM999G999') || ' im Vorjahr',
                       apex_page.get_url(p_page => 10, p_clear_cache => 10, p_items => 'P10_STATUS', p_values => 'AKTIV')
                  from dual
                union all
                select 5, 'Offene Rechnungen',
                       to_char((select nvl(sum(OFFEN), 0) from rechnungen where OFFEN > 0),
                               'FM999G999G990', 'NLS_NUMERIC_CHARACTERS='',.''') || ' €',
                       to_char((select count(*) from rechnungen where OFFEN > 0), 'FM999G999') || ' Rechnungen, davon '
                       || to_char((select count(*) from rechnungen where OFFEN > 0 and IST_UEBERFAELLIG = 'Y'), 'FM999G999') || ' überfällig',
                       apex_page.get_url(p_application => '20050', p_page => 10, p_clear_cache => 10)
                  from dual
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: kennzahlen
        }
        componentAppearance {
            display: report
        }
        settings {
            title: &TITLE.
            metric: &METRIC.
            meta: &META.
            layout: 5Columns
        }

        column ID (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
        )

        column TITLE (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: TITLE
                dataType: varchar2
            }
        )

        column METRIC (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: METRIC
                dataType: varchar2
            }
        )

        column META (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: META
                dataType: varchar2
            }
        )

        column LINK (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: LINK
                dataType: varchar2
            }
        )

        action karte-oeffnen (
            position: link
            layout {
                sequence: 10
            }
            behavior {
                type: redirectUrl
                targetUrl: &LINK.
            }
        )
    )

    region offene-rechnungen (
        name: Offene Rechnungen<span class="thg-titel-saldo u-danger-text">&P1_OFFEN_SUMME.</span>
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.RECH_ID,
                       r.RECH_NUMMER,
                       r.RECH_DATUM,
                       r.RECH_FAELLIG_AM,
                       case when r.RECH_STATUS = 'IN_BEARBEITUNG' then 'IN_BEARBEITUNG'
                            when r.IST_UEBERFAELLIG = 'Y' then 'UEBERFAELLIG'
                            when r.RECH_FAELLIG_AM <= trunc(sysdate) + 7 then 'FAELLIG'
                            else 'OFFEN' end as HINWEIS_CODE,
                       case when r.RECH_STATUS = 'IN_BEARBEITUNG' then 'in Bearbeitung'
                            when r.IST_UEBERFAELLIG = 'Y' then 'überfällig'
                            when r.RECH_FAELLIG_AM <= trunc(sysdate) + 7 then 'fällig in 7 Tagen'
                            else 'offen' end as HINWEIS,
                       r.KUNDE,
                       r.RECH_BETREFF,
                       r.OFFEN_NETTO as OFFEN,   -- Dashboards netto
                       -- Rechnung in der Finanz-App (20050 Seite 11), Kunde im Kundendetail (Seite 11), mit Pruefsumme
                       case r.BELEGART
                            when 'GUTSCHRIFT' then apex_page.get_url(p_application => '20050', p_page => 41, p_clear_cache => 41,
                                                                      p_items => 'P41_GUTS_ID', p_values => r.RECH_ID)
                            else apex_page.get_url(p_application => '20050', p_page => 11, p_clear_cache => 11,
                                                   p_items => 'P11_RECH_ID', p_values => r.RECH_ID) end as RECH_URL,
                       apex_page.get_url(p_page => 11, p_clear_cache => 11, p_items => 'P11_KUND_ID', p_values => r.RECH_KUND_ID) as KUND_URL
                  from FAKT_BELEGE_V r
                 where r.RECH_MAND_ID = :MANDANT_ID
                   and r.RECH_STATUS in ('GEDRUCKT', 'GESENDET', 'IN_BEARBEITUNG', 'TEILBEZAHLT')
                   and r.OFFEN > 0
                 order by r.RECH_FAELLIG_AM nulls last, r.RECH_NUMMER
                ```
        }
        layout {
            sequence: 25
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: offene-rechnungen
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 10
        }
        messages {
            whenNoDataFound: Keine offenen Rechnungen.
        }

        column RECH_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column RECH_NUMMER (
            type: plainText
            heading {
                heading: Rechnung
            }
            columnFormatting {
                htmlExpression: <a href="#RECH_URL#" title="Rechnung öffnen"><span class="thg-kundennr">#RECH_NUMMER#</span></a>
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column RECH_DATUM (
            type: plainText
            heading {
                heading: Datum
            }
            appearance {
                formatMask: DD.MM.YYYY
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column KUNDE (
            type: plainText
            heading {
                heading: Kunde
            }
            columnFormatting {
                htmlExpression: <a href="#KUND_URL#" title="Kunde öffnen">#KUNDE#</a>
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column RECH_BETREFF (
            type: plainText
            heading {
                heading: Betreff
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column RECH_FAELLIG_AM (
            type: plainText
            heading {
                heading: Fällig am
            }
            appearance {
                formatMask: DD.MM.YYYY
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column HINWEIS (
            type: plainText
            heading {
                heading: Hinweis
            }
            columnFormatting {
                htmlExpression: <span class="thg-badge thg-badge--#HINWEIS_CODE#">#HINWEIS#</span>
            }
            layout {
                sequence: 70
            }
            sorting {
                sortable: false
            }
        )

        column HINWEIS_CODE (
            type: hidden
            layout {
                sequence: 75
            }
        )

        column OFFEN (
            type: plainText
            heading {
                heading: Offen (netto)
                alignment: end
            }
            appearance {
                formatMask: FML999G999G990D00
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column RECH_URL (
            type: hidden
            layout {
                sequence: 90
            }
        )

        column KUND_URL (
            type: hidden
            layout {
                sequence: 95
            }
        )

    )

    pageItem P1_OFFEN_SUMME (
        type: hidden
        layout {
            sequence: 10
            region: @offene-rechnungen
            slot: regionBody
        }
    )

    process offen-summe (
        name: Summe offen (Titel Offene Rechnungen)
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- gleiche Belege wie die Liste (netto); Summe 0 wird nicht angezeigt
                select case when sum(r.OFFEN_NETTO) > 0
                            then 'Offen per ' || to_char(sysdate, 'DD.MM.YYYY') || ': ' || FAKT_HISTORIE.betrag(sum(r.OFFEN_NETTO)) end
                  into :P1_OFFEN_SUMME
                  from FAKT_BELEGE_V r
                 where r.RECH_MAND_ID = :MANDANT_ID
                   and r.RECH_STATUS in ('GEDRUCKT', 'GESENDET', 'IN_BEARBEITUNG', 'TEILBEZAHLT')
                   and r.OFFEN > 0;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    region umsatz-je-monat (
        name: Umsatz je Monat (netto)
        type: chart
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        chart {
            type: bar
        }
        legend {
            show: true
        }

        series umsatz (
            name: Umsatz
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    -- letzte 12 Monate inkl. Monate ohne Rechnung (Mandant der Sitzung, ohne Entwuerfe/stornierte)
                    select to_char(m.monat, 'YYYY-MM') as LABEL,
                           nvl(sum(r.RECH_SUMME_NETTO), 0) as VALUE,
                           to_char(m.monat, 'MM/YYYY') || ': '
                           || to_char(nvl(sum(r.RECH_SUMME_NETTO), 0), 'FM999G999G990D00', 'NLS_NUMERIC_CHARACTERS='',.''') || ' €' as TOOLTIP
                      from (select add_months(trunc(sysdate, 'MM'), -level + 1) as monat
                              from dual connect by level <= 12) m
                      left join FAKT_BELEGE_V r
                        on r.RECH_MAND_ID = :MANDANT_ID
                       and r.RECH_STATUS in ('GEDRUCKT', 'GESENDET', 'IN_BEARBEITUNG', 'TEILBEZAHLT', 'BEZAHLT')
                       and r.RECH_DATUM >= m.monat
                       and r.RECH_DATUM < add_months(m.monat, 1)
                     group by m.monat
                     order by m.monat
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
                customTooltip: TOOLTIP
            }
        )

        series vorjahr (
            name: Vorjahr
            execution {
                sequence: 20
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    -- Vorjahresmonat auf derselben Kategorie (Monat des aktuellen Zeitraums)
                    select to_char(m.monat, 'YYYY-MM') as LABEL,
                           nvl(sum(r.RECH_SUMME_NETTO), 0) as VALUE,
                           'Vorjahr ' || to_char(add_months(m.monat, -12), 'MM/YYYY') || ': '
                           || to_char(nvl(sum(r.RECH_SUMME_NETTO), 0), 'FM999G999G990D00', 'NLS_NUMERIC_CHARACTERS='',.''') || ' €' as TOOLTIP
                      from (select add_months(trunc(sysdate, 'MM'), -level + 1) as monat
                              from dual connect by level <= 12) m
                      left join FAKT_BELEGE_V r
                        on r.RECH_MAND_ID = :MANDANT_ID
                       and r.RECH_STATUS in ('GEDRUCKT', 'GESENDET', 'IN_BEARBEITUNG', 'TEILBEZAHLT', 'BEZAHLT')
                       and r.RECH_DATUM >= add_months(m.monat, -12)
                       and r.RECH_DATUM < add_months(m.monat, -11)
                     group by m.monat
                     order by m.monat
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
                customTooltip: TOOLTIP
            }
        )

        axis x (
            name: x
            value {
            }
            majorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            majorTicks {
                show: true
            }
        )
    )

    region top-kunden (
        name: Top 10 Kunden (Umsatz letzte 12 Monate)
        type: chart
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        chart {
            type: bar
        }
        legend {
            show: false
        }

        series kunden (
            name: Umsatz
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select coalesce(k.KUND_KURZNAME, k.KUND_FIRMENNAME, k.KUND_NACHNAME) as LABEL,
                           k.KUND_ID,
                           sum(r.RECH_SUMME_NETTO) as VALUE,
                           k.KUND_NUMMER || ' – ' || coalesce(k.KUND_FIRMENNAME, k.KUND_NACHNAME) || ': '
                           || to_char(sum(r.RECH_SUMME_NETTO), 'FM999G999G990D00', 'NLS_NUMERIC_CHARACTERS='',.''') || ' €' as TOOLTIP
                      from FAKT_BELEGE_V r
                      join KUND_KUNDEN k on k.KUND_ID = r.RECH_KUND_ID
                     where r.RECH_MAND_ID = :MANDANT_ID
                       and r.RECH_STATUS in ('GEDRUCKT', 'GESENDET', 'IN_BEARBEITUNG', 'TEILBEZAHLT', 'BEZAHLT')
                       and r.RECH_DATUM >= add_months(trunc(sysdate), -12)
                     group by k.KUND_ID, k.KUND_NUMMER, k.KUND_KURZNAME, k.KUND_FIRMENNAME, k.KUND_NACHNAME
                     order by 3 desc
                     fetch first 10 rows only
                    ```
            }
            link {
                type: redirectThisApp
                target: {
                    page: 11
                    items: {
                        P11_KUND_ID: &KUND_ID.
                    }
                    clearCache: 11
                }
            }
            columnMapping {
                label: LABEL
                value: VALUE
                customTooltip: TOOLTIP
            }
        )

        axis x (
            name: x
            value {
            }
            majorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            majorTicks {
                show: true
            }
        )
    )

    region kunden-land (
        name: Aktive Kunden nach Land
        type: chart
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        chart {
            type: donut
        }
        legend {
            show: true
        }

        series laender (
            name: Aktive Kunden
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    -- Land des Hauptsitzes
                    select coalesce(l.LAND_BEZEICHNUNG, 'unbekannt') as LABEL,
                           count(*) as VALUE
                      from KUND_KUNDEN k
                      left join KUND_STANDORTE s on s.KSTO_KUND_ID = k.KUND_ID and s.KSTO_IST_HAUPTSITZ = 'Y'
                      left join ALLG_ADRESSEN a on a.ADRE_ID = s.KSTO_ADRE_ID
                      left join ALLG_LAENDER l on l.LAND_CODE = a.ADRE_LAND_CODE
                     where k.KUND_STATUS = 'AKTIV'
                     group by coalesce(l.LAND_BEZEICHNUNG, 'unbekannt')
                     order by 2 desc
                    ```
            }
            link {
                type: redirectThisApp
                target: {
                    page: 10
                    items: {
                        P10_STATUS: AKTIV
                        P10_LAND: &LABEL.
                    }
                    clearCache: 10
                }
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
            label {
                show: true
            }
        )
    )

    region kunden-bundesland (
        name: Aktive Kunden nach Bundesland (Österreich)
        type: chart
        layout {
            sequence: 60
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        chart {
            type: bar
        }
        legend {
            show: false
        }

        series bundeslaender (
            name: Aktive Kunden
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    -- Bundesland aus ALLG_ADRESSEN.ADRE_REGION des Hauptsitzes (wie in der Kundenliste)
                    select case upper(a.ADRE_REGION)
                                when 'W' then 'Wien'            when 'N' then 'Niederösterreich' when 'NÖ' then 'Niederösterreich'
                                when 'O' then 'Oberösterreich'  when 'OÖ' then 'Oberösterreich' when 'ST' then 'Steiermark'
                                when 'K' then 'Kärnten'         when 'SA' then 'Salzburg'        when 'T' then 'Tirol'
                                when 'V' then 'Vorarlberg'      when 'B' then 'Burgenland'
                                else 'unbekannt' end as LABEL,
                           count(*) as VALUE
                      from KUND_KUNDEN k
                      join KUND_STANDORTE s on s.KSTO_KUND_ID = k.KUND_ID and s.KSTO_IST_HAUPTSITZ = 'Y'
                      join ALLG_ADRESSEN a on a.ADRE_ID = s.KSTO_ADRE_ID
                     where k.KUND_STATUS = 'AKTIV'
                       and a.ADRE_LAND_CODE = 'AT'
                     group by case upper(a.ADRE_REGION)
                                when 'W' then 'Wien'            when 'N' then 'Niederösterreich' when 'NÖ' then 'Niederösterreich'
                                when 'O' then 'Oberösterreich'  when 'OÖ' then 'Oberösterreich' when 'ST' then 'Steiermark'
                                when 'K' then 'Kärnten'         when 'SA' then 'Salzburg'        when 'T' then 'Tirol'
                                when 'V' then 'Vorarlberg'      when 'B' then 'Burgenland'
                                else 'unbekannt' end
                     order by 2 desc
                    ```
            }
            link {
                type: redirectThisApp
                target: {
                    page: 10
                    items: {
                        P10_STATUS: AKTIV
                        P10_LAND: Österreich
                        P10_BUNDESLAND: &LABEL.
                    }
                    clearCache: 10
                }
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
        )

        axis x (
            name: x
            value {
            }
            majorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            majorTicks {
                show: true
            }
        )
    )

)
