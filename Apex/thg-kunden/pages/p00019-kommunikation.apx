page 19 (
    name: Kommunikation
    alias: KOMMUNIKATION
    title: Kommunikation
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        width: 640
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region kommunikation (
        name: Kommunikation
        type: form
        source {
            location: localDatabase
            tableName: KUND_STANDORT_KOMMUNIKATION
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region eintrag (
        name: Eintrag
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @kommunikation
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
            ]
        }
    )

    pageItem P19_SKOM_ID (
        type: hidden
        layout {
            sequence: 1
            region: @eintrag
            slot: regionBody
        }
        source {
            formRegion: @kommunikation
            column: SKOM_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P19_KUND_ID (
        type: hidden
        layout {
            sequence: 2
            region: @eintrag
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P19_SKOM_KSTO_ID (
        type: selectList
        label {
            label: Adresse
            alignment: left
        }
        layout {
            sequence: 10
            region: @eintrag
            slot: regionBody
            columnSpan: 12
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @kommunikation
            column: SKOM_KSTO_ID
            dataType: number
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @lov-standorte-kommunikation
            displayNullValue: false
            displayExtraValues: false
        }
    )

    pageItem P19_SKOM_KART_ID (
        type: selectList
        label {
            label: Art
            alignment: left
        }
        layout {
            sequence: 20
            region: @eintrag
            slot: regionBody
            columnSpan: 4
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @kommunikation
            column: SKOM_KART_ID
            dataType: number
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @lov-kommunikationsarten
            displayNullValue: false
            displayExtraValues: false
        }
    )

    pageItem P19_SKOM_WERT (
        type: textField
        label {
            label: Telefon / E-Mail / Homepage
            alignment: left
        }
        layout {
            sequence: 30
            region: @eintrag
            slot: regionBody
            startNewRow: false
            columnSpan: 8
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @kommunikation
            column: SKOM_WERT
            dataType: varchar2
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
    )

    pageItem P19_SKOM_BEZEICHNUNG (
        type: textField
        label {
            label: Bezeichnung
            alignment: left
        }
        layout {
            sequence: 40
            region: @eintrag
            slot: regionBody
            columnSpan: 8
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @kommunikation
            column: SKOM_BEZEICHNUNG
            dataType: varchar2
        }
        validation {
            maxLength: 100
        }
    )

    pageItem P19_SKOM_IST_BEVORZUGT (
        type: switch
        label {
            label: Bevorzugt
            alignment: left
        }
        layout {
            sequence: 50
            region: @eintrag
            slot: regionBody
            startNewRow: false
            columnSpan: 4
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @kommunikation
            column: SKOM_IST_BEVORZUGT
            dataType: varchar2
        }
        default {
            type: static
            staticValue: N
        }
        settings {
            useDefaults: false
            onValue: Y
            onLabel: Ja
            offValue: N
            offLabel: Nein
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Abbrechen
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Löschen
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: Eintrag wirklich löschen?
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P19_SKOM_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Speichern
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P19_SKOM_ID
        }
    )

    button create (
        buttonName: CREATE
        label: Anlegen
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P19_SKOM_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Dialog abbrechen
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Formular Kommunikation initialisieren
        type: formInitialization
        formRegion: @kommunikation
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process kunde-ermitteln (
        name: Kunde ermitteln
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Kunde des Eintrags (fuer die Adress-Auswahl), falls nicht uebergeben
                if :P19_KUND_ID is null and :P19_SKOM_ID is not null then
                    select s.KSTO_KUND_ID
                      into :P19_KUND_ID
                      from KUND_STANDORT_KOMMUNIKATION c
                      join KUND_STANDORTE s on s.KSTO_ID = c.SKOM_KSTO_ID
                     where c.SKOM_ID = :P19_SKOM_ID;
                end if;
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
    )

    process vorbelegen (
        name: Neuen Eintrag vorbelegen
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Neuer Eintrag: am gueltigen Hauptsitz des Kunden
                select max(KSTO_ID) keep (dense_rank last order by KSTO_GUELTIG_VON nulls first)
                  into :P19_SKOM_KSTO_ID
                  from KUND_STANDORTE
                 where KSTO_KUND_ID = :P19_KUND_ID
                   and KSTO_IST_HAUPTSITZ = 'Y'
                   and trunc(sysdate) between nvl(KSTO_GUELTIG_VON, trunc(sysdate)) and nvl(KSTO_GUELTIG_BIS, trunc(sysdate));
                ```
        }
        execution {
            sequence: 25
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNull
            item: P19_SKOM_ID
        }
    )

    process bevorzugt (
        name: Bevorzugt nur einmal je Adresse und Art
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- je Standort und Art nur ein bevorzugter Eintrag (eindeutiger Index SKOM_BEVORZUGT_UI): der neue nimmt das
                -- Kennzeichen dem bisherigen
                if :P19_SKOM_IST_BEVORZUGT = 'Y' then
                    update KUND_STANDORT_KOMMUNIKATION
                       set SKOM_IST_BEVORZUGT = 'N'
                     where SKOM_KSTO_ID = :P19_SKOM_KSTO_ID
                       and SKOM_KART_ID = :P19_SKOM_KART_ID
                       and SKOM_IST_BEVORZUGT = 'Y'
                       and SKOM_ID <> nvl(to_number(:P19_SKOM_ID), -1);
                end if;
                ```
        }
        execution {
            sequence: 5
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    process process-form (
        name: Formular Kommunikation verarbeiten
        type: formAutoRowProcessing
        formRegion: @kommunikation
        execution {
            sequence: 10
        }
    )

    process close-dialog (
        name: Dialog schließen
        type: closeDialog
        execution {
            sequence: 90
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

)
