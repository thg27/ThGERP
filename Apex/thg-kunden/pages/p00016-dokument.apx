page 16 (
    name: Dokument
    alias: DOKUMENT
    title: Dokument
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        width: 700
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region dokument (
        name: Dokument
        type: form
        source {
            location: localDatabase
            tableName: KUND_KUNDEN_DOKUMENTE
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region angaben (
        name: Dokument
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @dokument
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
            ]
        }
    )

    pageItem P16_KDOK_ID (
        type: hidden
        layout {
            sequence: 1
            region: @angaben
            slot: regionBody
        }
        source {
            formRegion: @dokument
            column: KDOK_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P16_KUND_ID (
        type: hidden
        layout {
            sequence: 2
            region: @angaben
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P16_KDOK_KUND_ID (
        type: hidden
        layout {
            sequence: 3
            region: @angaben
            slot: regionBody
        }
        source {
            formRegion: @dokument
            column: KDOK_KUND_ID
            dataType: number
        }
        default {
            type: item
            item: P16_KUND_ID
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P16_KDOK_MAND_ID (
        type: hidden
        layout {
            sequence: 4
            region: @angaben
            slot: regionBody
        }
        source {
            formRegion: @dokument
            column: KDOK_MAND_ID
            dataType: number
        }
        default {
            type: item
            item: MANDANT_ID
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P16_KDOK_DATEINAME (
        type: hidden
        layout {
            sequence: 5
            region: @angaben
            slot: regionBody
        }
        source {
            formRegion: @dokument
            column: KDOK_DATEINAME
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P16_KDOK_MIME_TYPE (
        type: hidden
        layout {
            sequence: 6
            region: @angaben
            slot: regionBody
        }
        source {
            formRegion: @dokument
            column: KDOK_MIME_TYPE
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P16_KDOK_DART_ID (
        type: selectList
        label {
            label: Dokumentart
            alignment: left
        }
        layout {
            sequence: 10
            region: @angaben
            slot: regionBody
            columnSpan: 4
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @dokument
            column: KDOK_DART_ID
            dataType: number
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @lov-dokumentarten
            nullDisplayValue: - bitte wählen -
        }
    )

    pageItem P16_KDOK_BEZEICHNUNG (
        type: textField
        label {
            label: Bezeichnung
            alignment: left
        }
        layout {
            sequence: 20
            region: @angaben
            slot: regionBody
            startNewRow: false
            columnSpan: 8
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @dokument
            column: KDOK_BEZEICHNUNG
            dataType: varchar2
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
    )

    pageItem P16_DATEI_AKTUELL (
        type: displayOnly
        label {
            label: Aktuelle Datei
            alignment: left
        }
        layout {
            sequence: 35
            region: @angaben
            slot: regionBody
            columnSpan: 12
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P16_KDOK_ID
        }
    )

    pageItem P16_KDOK_DATEI (
        type: fileUpload
        label {
            label: Datei
            alignment: left
        }
        display {
            displayAs: inlineDropzone
            dropzoneTitle: Datei hierher ziehen
            dropzoneDesc: oder klicken zum Auswählen
        }
        storage {
            mimeTypeColumn: KDOK_MIME_TYPE
            filenameColumn: KDOK_DATEINAME
        }
        layout {
            sequence: 40
            region: @angaben
            slot: regionBody
            columnSpan: 12
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @dokument
            column: KDOK_DATEI
            dataType: blob
        }
        help {
            helpText: Beliebige Datei (PDF, Excel, Word, Bild …). Beim Bearbeiten nur auswählen, wenn die Datei ersetzt werden soll.
        }
    )

    pageItem P16_KDOK_BESCHREIBUNG (
        type: textarea
        label {
            label: Beschreibung
            alignment: left
        }
        layout {
            sequence: 50
            region: @angaben
            slot: regionBody
            columnSpan: 12
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @dokument
            column: KDOK_BESCHREIBUNG
            dataType: varchar2
        }
        validation {
            maxLength: 4000
        }
    )

    validation datei-pflicht (
        name: Datei bei neuem Dokument
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P16_KDOK_DATEI
        }
        error {
            errorMessage: Bitte eine Datei auswählen.
            associatedItem: @P16_KDOK_DATEI
        }
        serverSideCondition {
            type: itemIsNull
            item: P16_KDOK_ID
        }
    )

    dynamicAction bezeichnung-aus-datei (
        name: Bezeichnung aus dem Dateinamen vorschlagen
        execution {
            sequence: 20
        }
        when {
            event: change
            selectionType: items
            items: P16_KDOK_DATEI
        }

        action bezeichnung-vorschlagen (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var datei = apex.item("P16_KDOK_DATEI").getValue() || "";
                    if (Array.isArray(datei)) { datei = datei[0] || ""; }
                    datei = String(datei).split(/[\\/]/).pop();
                    if (datei && !apex.item("P16_KDOK_BEZEICHNUNG").getValue()) {
                        apex.item("P16_KDOK_BEZEICHNUNG").setValue(datei.replace(/\.[^.]+$/, ""));
                    }
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    button cancel (
        buttonName: CANCEL
        label: Abbrechen
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Löschen
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: Dokument wirklich löschen?
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P16_KDOK_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Speichern
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P16_KDOK_ID
        }
    )

    button create (
        buttonName: CREATE
        label: Anlegen
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P16_KDOK_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Dialog abbrechen
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Formular Dokument initialisieren
        type: formInitialization
        formRegion: @dokument
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process kunde-ermitteln (
        name: Kunde und aktuelle Datei ermitteln
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Kunde des Dokuments, falls nicht uebergeben; aktuelle Datei (Name, Groesse) fuer die Anzeige
                if :P16_KDOK_ID is not null then
                    select KDOK_KUND_ID, KDOK_DATEINAME || ' (' || apex_util.filesize_mask(KDOK_GROESSE) || ')'
                      into :P16_KUND_ID, :P16_DATEI_AKTUELL
                      from KUND_KUNDEN_DOKUMENTE
                     where KDOK_ID = :P16_KDOK_ID
                       and KDOK_MAND_ID = :MANDANT_ID;   -- nur Dokumente des Mandanten der Sitzung
                end if;
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
    )

    process process-form (
        name: Formular Dokument verarbeiten
        type: formAutoRowProcessing
        formRegion: @dokument
        execution {
            sequence: 10
        }
    )

    process close-dialog (
        name: Dialog schließen
        type: closeDialog
        execution {
            sequence: 90
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

)
