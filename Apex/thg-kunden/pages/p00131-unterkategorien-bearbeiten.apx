page 131 (
    name: Unterkategorie
    alias: UNTERKATEGORIEN-BEARBEITEN
    title: Unterkategorie
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region formular (
        name: Unterkategorie
        type: form
        source {
            location: localDatabase
            tableName: KUND_UNTERKATEGORIEN
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P131_UKAT_ID (
        type: hidden
        layout {
            sequence: 1
            region: @formular
            slot: regionBody
        }
        source {
            formRegion: @formular
            column: UKAT_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P131_UKAT_BRAN_ID (
        type: selectList
        label {
            label: Branche
            alignment: left
        }
        layout {
            sequence: 10
            region: @formular
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @formular
            column: UKAT_BRAN_ID
            dataType: number
        }
        lov {
            type: sharedComponent
            lov: @lov-branchen
            displayNullValue: true
            nullDisplayValue: - bitte wählen -
        }
    )

    pageItem P131_UKAT_BEZEICHNUNG (
        type: textField
        label {
            label: Bezeichnung
            alignment: left
        }
        layout {
            sequence: 20
            region: @formular
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @formular
            column: UKAT_BEZEICHNUNG
            dataType: varchar2
        }
    )

    pageItem P131_UKAT_BEWERTUNG (
        type: numberField
        label {
            label: Bewertung
            alignment: left
        }
        layout {
            sequence: 30
            region: @formular
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formular
            column: UKAT_BEWERTUNG
            dataType: number
        }
    )

    pageItem P131_UKAT_SORTIERUNG (
        type: numberField
        label {
            label: Sortierung
            alignment: left
        }
        layout {
            sequence: 40
            region: @formular
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formular
            column: UKAT_SORTIERUNG
            dataType: number
        }
    )

    pageItem P131_UKAT_IST_AKTIV (
        type: switch
        label {
            label: Aktiv
            alignment: left
        }
        layout {
            sequence: 50
            region: @formular
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @formular
            column: UKAT_IST_AKTIV
            dataType: varchar2
        }
        settings {
            useDefaults: false
            onValue: Y
            onLabel: Ja
            offValue: N
            offLabel: Nein
        }
        default {
            type: static
            staticValue: Y
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Abbrechen
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Löschen
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: Eintrag wirklich löschen? Bereits verwendete Einträge können nicht gelöscht werden.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P131_UKAT_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Speichern
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P131_UKAT_ID
        }
    )

    button create (
        buttonName: CREATE
        label: Anlegen
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P131_UKAT_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Dialog abbrechen
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Formular initialisieren
        type: formInitialization
        formRegion: @formular
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Formular verarbeiten
        type: formAutoRowProcessing
        formRegion: @formular
        execution {
            sequence: 10
        }
    )

    process close-dialog (
        name: Dialog schließen
        type: closeDialog
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

)
