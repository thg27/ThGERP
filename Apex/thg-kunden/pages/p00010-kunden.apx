page 10 (
    name: Kunden
    alias: KUNDEN
    title: Kunden
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        title: Kunden
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region facets (
        name: Facetten
        type: facetedSearch
        source {
            filteredRegion: @kunden
        }
        layout {
            sequence: 20
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            compactNosThreshold: 10000
            displayChartForTopNValues: 10
        }

        facet P10_SEARCH (
            type: search
            label {
                label: Suche
            }
            layout {
                sequence: 10
            }
        )

        facet P10_STATUS (
            type: checkboxGroup
            label {
                label: Status
            }
            lov {
                type: sharedComponent
                lov: @lov-kunden-status
            }
            layout {
                sequence: 20
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: KUND_STATUS
            }
        )

        facet P10_TYP (
            type: checkboxGroup
            label {
                label: Typ
            }
            lov {
                type: sharedComponent
                lov: @lov-kunden-typ
            }
            layout {
                sequence: 30
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: KUND_TYP
            }
        )

        facet P10_RECHTSFORM (
            type: checkboxGroup
            label {
                label: Rechtsform
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 40
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: RECHTSFORM
            }
        )

        facet P10_LAND (
            type: checkboxGroup
            label {
                label: Land
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 50
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: LAND
            }
        )

        facet P10_ORT (
            type: checkboxGroup
            label {
                label: Ort
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 60
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: ORT
            }
            appearance {
                display: addFilterDialog
            }
        )

        facet P10_KONZERN (
            type: checkboxGroup
            label {
                label: Konzernmutter
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 70
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: KONZERN
            }
            appearance {
                display: addFilterDialog
            }
        )

    )

    region kunden (
        name: Kunden
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select k.KUND_ID,
                       k.KUND_NUMMER,
                       case k.KUND_TYP
                            when 'FIRMA' then k.KUND_FIRMENNAME
                            else k.KUND_NACHNAME || nvl2(k.KUND_VORNAME, ' ' || k.KUND_VORNAME, null)
                       end as KUNDE,
                       k.KUND_TYP,
                       case k.KUND_TYP when 'FIRMA' then 'Firma' else 'Privat' end as TYP,
                       k.KUND_STATUS,
                       initcap(k.KUND_STATUS) as STATUS,
                       r.RFRM_KURZ as RECHTSFORM,
                       k.KUND_UID_NUMMER,
                       a.ADRE_PLZ as PLZ,
                       a.ADRE_ORT as ORT,
                       l.LAND_BEZEICHNUNG as LAND,
                       case when m.KUND_ID is not null then m.KUND_NUMMER || ' – ' || nvl(m.KUND_FIRMENNAME, m.KUND_NACHNAME) end as KONZERN,
                       k.KUND_KUNDE_SEIT
                  from KUND_KUNDEN k
                  left join KUND_RECHTSFORMEN r on r.RFRM_ID = k.KUND_RFRM_ID
                  left join KUND_STANDORTE s on s.KSTO_KUND_ID = k.KUND_ID and s.KSTO_IST_HAUPTSITZ = 'Y'
                  left join ALLG_ADRESSEN a on a.ADRE_ID = s.KSTO_ADRE_ID
                  left join ALLG_LAENDER l on l.LAND_CODE = a.ADRE_LAND_CODE
                  left join KUND_KUNDEN m on m.KUND_ID = k.KUND_PARENT_KUND_ID
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: Keine Kunden gefunden.
        }

        column KUND_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column KUND_NUMMER (
            type: link
            heading {
                heading: Kundennr.
            }
            layout {
                sequence: 20
            }
            link {
                target: {
                    page: 11
                    items: {
                        P11_KUND_ID: #KUND_ID#
                    }
                    clearCache: 11
                }
                linkText: #KUND_NUMMER#
            }
        )

        column KUNDE (
            type: plainText
            heading {
                heading: Kunde
            }
            layout {
                sequence: 30
            }
        )

        column KUND_TYP (
            type: hidden
            layout {
                sequence: 40
            }
        )

        column KUND_STATUS (
            type: hidden
            layout {
                sequence: 50
            }
        )

        column TYP (
            type: plainText
            heading {
                heading: Typ
            }
            layout {
                sequence: 45
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 55
            }
        )

        column RECHTSFORM (
            type: plainText
            heading {
                heading: Rechtsform
            }
            layout {
                sequence: 60
            }
        )

        column KUND_UID_NUMMER (
            type: plainText
            heading {
                heading: UID-Nr.
            }
            layout {
                sequence: 70
            }
        )

        column PLZ (
            type: plainText
            heading {
                heading: PLZ
            }
            layout {
                sequence: 80
            }
        )

        column ORT (
            type: plainText
            heading {
                heading: Ort
            }
            layout {
                sequence: 90
            }
        )

        column LAND (
            type: plainText
            heading {
                heading: Land
            }
            layout {
                sequence: 100
            }
        )

        column KONZERN (
            type: plainText
            heading {
                heading: Konzernmutter
            }
            layout {
                sequence: 110
            }
        )

        column KUND_KUNDE_SEIT (
            type: plainText
            heading {
                heading: Kunde seit
            }
            layout {
                sequence: 120
            }
            appearance {
                formatMask: DD.MM.YYYY
            }
        )

    )

    button up (
        buttonName: UP
        label: Zurück zur Startseite
        layout {
            sequence: 10
            region: @breadcrumb
            slot: up
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-arrow-up
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset (
        buttonName: RESET
        label: Zurücksetzen
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                t-Button--noUI
                t-Button--iconLeft
                t-Button--gapRight
            ]
            icon: fa-undo-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
                clearCache: 10
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button kunde-hinzufuegen (
        buttonName: CREATE
        label: Kunde hinzufügen
        layout {
            sequence: 20
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconRight
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 11
                clearCache: 11
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)
