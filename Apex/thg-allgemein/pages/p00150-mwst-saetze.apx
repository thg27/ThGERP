page 150 (
    name: MwSt.-Sätze
    alias: MWST-SAETZE
    title: MwSt.-Sätze
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        title: MwSt.-Sätze
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region bericht (
        name: MwSt.-Sätze
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select MWST_ID,
                       MWST_PROZENT,
                       MWST_BEZEICHNUNG,
                       case MWST_IST_STANDARD when 'Y' then 'Ja' else 'Nein' end as MWST_IST_STANDARD,
                       MWST_SORTIERUNG,
                       case MWST_IST_AKTIV when 'Y' then 'Ja' else 'Nein' end as MWST_IST_AKTIV,
                       MWST_UPDATED_ON,
                       MWST_UPDATED_BY
                  from ALLG_MWST_SAETZE
                 order by MWST_SORTIERUNG nulls last, MWST_PROZENT desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 151
                items: {
                    P151_MWST_ID: #MWST_ID#
                }
                clearCache: 151
            }
            linkIcon: <span role="img" aria-label="Bearbeiten" class="fa fa-edit" title="Bearbeiten"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Keine Einträge vorhanden.
        }

        column MWST_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column MWST_PROZENT (
            type: plainText
            heading {
                heading: Prozent
            }
            layout {
                sequence: 20
            }
            source {
                dataType: NUMBER
            }
        )

        column MWST_BEZEICHNUNG (
            type: plainText
            heading {
                heading: Bezeichnung
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column MWST_IST_STANDARD (
            type: plainText
            heading {
                heading: Standard
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column MWST_SORTIERUNG (
            type: plainText
            heading {
                heading: Sortierung
            }
            layout {
                sequence: 50
            }
            source {
                dataType: NUMBER
            }
        )

        column MWST_IST_AKTIV (
            type: plainText
            heading {
                heading: Aktiv
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column MWST_UPDATED_ON (
            type: plainText
            heading {
                heading: Geändert am
            }
            layout {
                sequence: 70
            }
            source {
                dataType: TIMESTAMP
            }
        )

        column MWST_UPDATED_BY (
            type: plainText
            heading {
                heading: Geändert von
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
        )

    )

    button up (
        buttonName: UP
        label: Zurück zu Wertelisten
        layout {
            sequence: 10
            region: @breadcrumb
            slot: up
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-arrow-up
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 100
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset-report (
        buttonName: RESET_REPORT
        label: Zurücksetzen
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                t-Button--noUI
                t-Button--iconLeft
                t-Button--gapRight
            ]
            icon: fa-undo-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: &APP_PAGE_ID.
                clearCache: &APP_PAGE_ID.
                action: resetRegions
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button hinzufuegen (
        buttonName: CREATE
        label: MwSt.-Satz hinzufügen
        layout {
            sequence: 20
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconRight
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 151
                clearCache: 151
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh-nach-dialog (
        name: Bericht nach Dialog aktualisieren
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @bericht
        }

        action refresh-bericht (
            action: refresh
            affectedElements {
                selectionType: region
                region: @bericht
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-nach-hinzufuegen (
        name: Bericht nach Hinzufügen aktualisieren
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @hinzufuegen
        }

        action refresh-bericht-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @bericht
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
