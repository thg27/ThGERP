app THG-ALLGEMEIN (
    name: ThG – Allgemein
    version: 1.0.0
    logo {
        type: custom
        customHtml:
            ```
            <span class="thg-mandant-logo" data-mandant="&MANDANT_CODE."><img src="#WORKSPACE_FILES#&MANDANT_LOGO." alt="&MANDANT_NAME."></span><span class="apex-logo-text">Allgemein</span>
            ```
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            js-defaultCollapsed
            js-navCollapsed--hidden
            t-TreeNav--classic
        ]
        list: @navigation-menu
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    authentication {
        scheme: @oracle-apex-accounts
    }
    authorization {
        sourceForRoleOrGroupSchemes: authenticationScheme
    }
    sessionManagement {
        maxSessionIdleTime: 3600
        maxSessionLength: 28800
    }
    sessionStateProtection {
        checksumSalt: 9DD0AD112534A8D54ACE11D7329478BECBE259654217110585A4916A5FF4F397
    }
    globalization {
        primaryLanguage: de
        documentDirection: leftToRight
    }
    runtime {
        allowFeedback: true
        compatibilityMode: 24.2
    }
)
