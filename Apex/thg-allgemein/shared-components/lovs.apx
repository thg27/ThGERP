lov lov-boolean (
    name: LOV_BOOLEAN
    source {
        location: staticValues
    }
    subscription {
        master: @/20000/lov-boolean
    }

    entry false (
        sequence: 2
        display: Nein
        return: FALSE
    )

    entry true (
        sequence: 1
        display: Ja
        return: TRUE
    )

)

lov lov-ja-nein (
    name: LOV_JA_NEIN
    source {
        location: staticValues
    }
    subscription {
        master: @/20000/lov-ja-nein
    }

    entry ja (
        sequence: 1
        display: Ja
        return: Y
    )

    entry nein (
        sequence: 2
        display: Nein
        return: N
    )

)

lov lov-textvorlage-arten (
    name: LOV_TEXTVORLAGE_ARTEN
    source {
        location: staticValues
    }
    subscription {
        master: @/20000/lov-textvorlage-arten
    }

    entry zahlungsbed (
        sequence: 1
        display: Zahlungsbedingungen
        return: ZAHLUNGSBED
    )

    entry vortext (
        sequence: 2
        display: Vortext
        return: VORTEXT
    )

    entry schlusstext (
        sequence: 3
        display: Schlusstext
        return: SCHLUSSTEXT
    )
)
