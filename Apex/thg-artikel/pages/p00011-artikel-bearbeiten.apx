page 11 (
    name: Artikel bearbeiten
    alias: ARTIKEL-BEARBEITEN
    title: &P11_TITEL.
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        title: &P11_TITEL.
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region artikel (
        name: Artikel
        type: form
        source {
            location: localDatabase
            tableName: ARTI_ARTIKEL
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
        }
    )

    region stammdaten (
        name: Stammdaten
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @artikel
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region details (
        name: Details
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @artikel
            slot: subRegions
        }
        appearance {
            template: @/tabs-container
            templateOptions: #DEFAULT#
        }
    )

    region tab-kommentar (
        name: Kommentar
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @details
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region tab-zusatzfelder (
        name: Zusatzfelder
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @details
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region tab-dokumente (
        name: Dokumente
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @details
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_ARTI_ID
        }
    )

    region tab-dateien (
        name: Dateien
        type: staticContent
        layout {
            sequence: 40
            parentRegion: @details
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_ARTI_ID
        }
    )

    pageItem P11_ARTI_ID (
        type: hidden
        layout {
            sequence: 1
            region: @stammdaten
            slot: regionBody
        }
        source {
            formRegion: @artikel
            column: ARTI_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P11_TITEL (
        type: hidden
        layout {
            sequence: 2
            region: @stammdaten
            slot: regionBody
        }
    )

    pageItem P11_ARTI_NAME (
        type: textField
        label {
            label: Name
            alignment: left
        }
        layout {
            sequence: 10
            region: @stammdaten
            slot: regionBody
            columnSpan: 5
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @artikel
            column: ARTI_NAME
            dataType: varchar2
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
    )

    pageItem P11_ARTI_VK_PREIS (
        type: numberField
        label {
            label: Verkaufspreis
            alignment: left
        }
        layout {
            sequence: 20
            region: @stammdaten
            slot: regionBody
            startNewRow: false
            columnSpan: 2
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @artikel
            column: ARTI_VK_PREIS
            dataType: number
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: 0
        }
    )

    pageItem P11_ARTI_IST_BRUTTO (
        type: switch
        label {
            label: brutto
            alignment: left
        }
        layout {
            sequence: 30
            region: @stammdaten
            slot: regionBody
            startNewRow: false
            columnSpan: 1
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @artikel
            column: ARTI_IST_BRUTTO
            dataType: varchar2
        }
        settings {
            useDefaults: false
            onValue: Y
            onLabel: Ja
            offValue: N
            offLabel: Nein
        }
        default {
            type: static
            staticValue: N
        }
    )

    pageItem P11_ARTI_IST_AKTIV (
        type: switch
        label {
            label: Aktiv
            alignment: left
        }
        layout {
            sequence: 35
            region: @stammdaten
            slot: regionBody
            startNewRow: false
            columnSpan: 2
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @artikel
            column: ARTI_IST_AKTIV
            dataType: varchar2
        }
        settings {
            useDefaults: false
            onValue: Y
            onLabel: Ja
            offValue: N
            offLabel: Nein
        }
        default {
            type: static
            staticValue: Y
        }
    )

    pageItem P11_ARTI_BILD (
        type: imageUpload
        label {
            label: Artikelbild
            alignment: left
        }
        layout {
            sequence: 40
            region: @stammdaten
            slot: regionBody
            startNewRow: false
            columnSpan: 2
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @artikel
            column: ARTI_BILD
            dataType: blob
        }
    )

    pageItem P11_ARTI_NUMMER (
        type: textField
        label {
            label: Nummer
            alignment: left
        }
        layout {
            sequence: 50
            region: @stammdaten
            slot: regionBody
            columnSpan: 6
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @artikel
            column: ARTI_NUMMER
            dataType: varchar2
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select to_char(nvl(max(to_number(ARTI_NUMMER default null on conversion error)), 0) + 1)
                  from ARTI_ARTIKEL
                ```
        }
    )

    pageItem P11_ARTI_EINH_ID (
        type: selectList
        label {
            label: Einheit
            alignment: left
        }
        layout {
            sequence: 60
            region: @stammdaten
            slot: regionBody
            startNewRow: false
            columnSpan: 3
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @artikel
            column: ARTI_EINH_ID
            dataType: number
        }
        lov {
            type: sharedComponent
            lov: @lov-einheiten
            displayNullValue: true
            nullDisplayValue: -
            displayExtraValues: false
        }
    )

    pageItem P11_ARTI_AGRP_ID (
        type: selectList
        label {
            label: Gruppe
            alignment: left
        }
        layout {
            sequence: 70
            region: @stammdaten
            slot: regionBody
            columnSpan: 6
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @artikel
            column: ARTI_AGRP_ID
            dataType: number
        }
        lov {
            type: sharedComponent
            lov: @lov-artikelgruppen
            displayNullValue: true
            nullDisplayValue: - keine -
            displayExtraValues: false
        }
    )

    pageItem P11_ARTI_MWST_ID (
        type: selectList
        label {
            label: MwSt. in %
            alignment: left
        }
        layout {
            sequence: 80
            region: @stammdaten
            slot: regionBody
            startNewRow: false
            columnSpan: 3
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @artikel
            column: ARTI_MWST_ID
            dataType: number
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @lov-mwst-saetze
            displayNullValue: false
            displayExtraValues: false
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select MWST_ID from ALLG_MWST_SAETZE where MWST_IST_STANDARD = 'Y'
                ```
        }
    )

    pageItem P11_ARTI_BESCHREIBUNG (
        type: richTextEditor
        label {
            label: Beschreibung (wird in die Belegposition übernommen)
            alignment: left
        }
        layout {
            sequence: 90
            region: @stammdaten
            slot: regionBody
            columnSpan: 12
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @artikel
            column: ARTI_BESCHREIBUNG
            dataType: clob
        }
    )

    pageItem P11_ARTI_KOMMENTAR (
        type: textarea
        label {
            label: Kommentar (intern)
            alignment: left
        }
        layout {
            sequence: 10
            region: @tab-kommentar
            slot: regionBody
            columnSpan: 12
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @artikel
            column: ARTI_KOMMENTAR
            dataType: clob
        }
    )

    pageItem P11_ARTI_EAN (
        type: textField
        label {
            label: Barcode EAN
            alignment: left
        }
        layout {
            sequence: 10
            region: @tab-zusatzfelder
            slot: regionBody
            columnSpan: 3
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @artikel
            column: ARTI_EAN
            dataType: varchar2
        }
        validation {
            maxLength: 20
        }
    )

    pageItem P11_ARTI_AUFGENOMMEN_AM (
        type: datePicker
        label {
            label: Aufgenommen am
            alignment: left
        }
        layout {
            sequence: 20
            region: @tab-zusatzfelder
            slot: regionBody
            startNewRow: false
            columnSpan: 3
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @artikel
            column: ARTI_AUFGENOMMEN_AM
            dataType: date
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: trunc(sysdate)
        }
    )

    pageItem P11_ARTI_EK_PREIS (
        type: numberField
        label {
            label: Einkaufspreis netto
            alignment: left
        }
        layout {
            sequence: 30
            region: @tab-zusatzfelder
            slot: regionBody
            startNewRow: false
            columnSpan: 2
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @artikel
            column: ARTI_EK_PREIS
            dataType: number
        }
    )

    pageItem P11_ARTI_ERLOESKONTO (
        type: textField
        label {
            label: Erlöskonto
            alignment: left
        }
        layout {
            sequence: 40
            region: @tab-zusatzfelder
            slot: regionBody
            startNewRow: false
            columnSpan: 2
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @artikel
            column: ARTI_ERLOESKONTO
            dataType: varchar2
        }
        validation {
            maxLength: 20
        }
    )

    region zusatzwerte (
        name: Zusatzfelder
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select z.ZUSF_ID,
                       z.ZUSF_NUMMER,
                       z.ZUSF_BEZEICHNUNG,
                       (select w.AZUW_WERT
                          from ARTI_ARTIKEL_ZUSATZWERTE w
                         where w.AZUW_ARTI_ID = :P11_ARTI_ID
                           and w.AZUW_ZUSF_ID = z.ZUSF_ID) as AZUW_WERT
                  from ARTI_ZUSATZFELDER z
                 where z.ZUSF_IST_AKTIV = 'Y'
                 order by z.ZUSF_NUMMER
                ```
            pageItemsToSubmit: [
                P11_ARTI_ID
            ]
        }
        layout {
            sequence: 60
            parentRegion: @tab-zusatzfelder
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                update
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_ARTI_ID
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ZUSF_BEZEICHNUNG
                layout {
                    sequence: 1
                }
            )
            displayColumn (
                column: @AZUW_WERT
                layout {
                    sequence: 2
                }
            )
        )

        column ZUSF_ID (
            type: hidden
            layout {
                sequence: 10
            }
            source {
                databaseColumn: ZUSF_ID
                dataType: number
                primaryKey: true
            }
        )

        column ZUSF_NUMMER (
            type: hidden
            layout {
                sequence: 20
            }
            source {
                databaseColumn: ZUSF_NUMMER
                dataType: number
            }
        )

        column ZUSF_BEZEICHNUNG (
            type: displayOnly
            heading {
                heading: Feld
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ZUSF_BEZEICHNUNG
                dataType: varchar2
            }
        )

        column AZUW_WERT (
            type: textField
            heading {
                heading: Wert
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: AZUW_WERT
                dataType: varchar2
            }
        )
    )

    region dokumente (
        name: Dokumente
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.RECH_ID,
                       initcap(r.RECH_STATUS) as STATUS,
                       'Rechnung' as TYP,
                       r.RECH_DATUM,
                       r.RECH_NUMMER,
                       r.RECH_BETREFF,
                       k.KUND_NUMMER,
                       coalesce(k.KUND_FIRMENNAME, k.KUND_NACHNAME || ' ' || k.KUND_VORNAME) as KUNDE,
                       r.RECH_SUMME_NETTO,
                       r.RECH_SUMME_BRUTTO
                  from FAKT_RECHNUNGEN r
                  join KUND_KUNDEN k on k.KUND_ID = r.RECH_KUND_ID
                 where exists (select 1 from FAKT_RECHNUNGSPOSITIONEN p
                                where p.RPOS_RECH_ID = r.RECH_ID and p.RPOS_ARTI_ID = :P11_ARTI_ID)
                 order by r.RECH_DATUM desc
                ```
            pageItemsToSubmit: [
                P11_ARTI_ID
            ]
        }
        layout {
            sequence: 10
            parentRegion: @tab-dokumente
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Der Artikel kommt in keinem Beleg vor.
        }

        column RECH_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column TYP (
            type: plainText
            heading {
                heading: Typ
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column RECH_DATUM (
            type: plainText
            heading {
                heading: Datum
            }
            layout {
                sequence: 40
            }
            source {
                dataType: DATE
            }
        )

        column RECH_NUMMER (
            type: plainText
            heading {
                heading: Nummer
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column RECH_BETREFF (
            type: plainText
            heading {
                heading: Betreff
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column KUND_NUMMER (
            type: plainText
            heading {
                heading: Kundennummer
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

        column KUNDE (
            type: plainText
            heading {
                heading: Kunde
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
        )

        column RECH_SUMME_NETTO (
            type: plainText
            heading {
                heading: Summe netto
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            appearance {
                formatMask: FML999G999G990D00
            }
        )

        column RECH_SUMME_BRUTTO (
            type: plainText
            heading {
                heading: Summe brutto
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            appearance {
                formatMask: FML999G999G990D00
            }
        )

    )

    region dateien (
        name: Dateien
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ADAT_ID,
                       ADAT_DATEINAME,
                       dbms_lob.getlength(ADAT_INHALT) as ADAT_INHALT,
                       ADAT_MIMETYPE,
                       round(ADAT_GROESSE / 1024, 1) as GROESSE_KB,
                       ADAT_BEMERKUNG,
                       ADAT_CREATED_ON,
                       ADAT_CREATED_BY
                  from ARTI_ARTIKEL_DATEIEN
                 where ADAT_ARTI_ID = :P11_ARTI_ID
                 order by ADAT_CREATED_ON desc
                ```
            pageItemsToSubmit: [
                P11_ARTI_ID
            ]
        }
        layout {
            sequence: 10
            parentRegion: @tab-dateien
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 12
                items: {
                    P12_ADAT_ID: #ADAT_ID#
                    P12_ADAT_ARTI_ID: &P11_ARTI_ID.
                }
                clearCache: 12
            }
            linkIcon: <span role="img" aria-label="Bearbeiten" class="fa fa-edit" title="Bearbeiten"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Keine Dateien vorhanden.
        }

        column ADAT_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column ADAT_DATEINAME (
            type: plainText
            heading {
                heading: Dateiname
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column ADAT_INHALT (
            type: downloadBlob
            heading {
                heading: Datei
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            appearance {
                viewFileAs: attachment
                downloadText: Herunterladen
            }
            blobAttributes {
                tableName: ARTI_ARTIKEL_DATEIEN
                blobColumn: ADAT_INHALT
                primaryKeyColumn1: ADAT_ID
                mimeTypeColumn: ADAT_MIMETYPE
                filenameColumn: ADAT_DATEINAME
                lastUpdatedColumn: ADAT_UPDATED_ON
            }
        )

        column ADAT_MIMETYPE (
            type: plainText
            heading {
                heading: Typ
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column GROESSE_KB (
            type: plainText
            heading {
                heading: Größe (KB)
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

        column ADAT_BEMERKUNG (
            type: plainText
            heading {
                heading: Bemerkung
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column ADAT_CREATED_ON (
            type: plainText
            heading {
                heading: Hinzugefügt am
            }
            layout {
                sequence: 70
            }
            source {
                dataType: TIMESTAMP
            }
        )

        column ADAT_CREATED_BY (
            type: plainText
            heading {
                heading: Hinzugefügt von
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
        )

    )

    button cancel (
        buttonName: CANCEL
        label: Abbrechen
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Speichern & Schließen
        layout {
            sequence: 20
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_ARTI_ID
        }
    )

    button create (
        buttonName: CREATE
        label: Anlegen
        layout {
            sequence: 30
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P11_ARTI_ID
        }
    )

    button up (
        buttonName: UP
        label: Zurück zur Artikelliste
        layout {
            sequence: 10
            region: @breadcrumb
            slot: up
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-arrow-up
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button datei-hinzufuegen (
        buttonName: DATEI
        label: Datei hinzufügen
        layout {
            sequence: 10
            region: @tab-dateien
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 12
                items: {
                    P12_ADAT_ARTI_ID: &P11_ARTI_ID.
                }
                clearCache: 12
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction dateien-nach-dialog (
        name: Dateien nach Dialog aktualisieren
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @dateien
        }

        action dateien-nach-dialog-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @dateien
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction dateien-nach-hinzufuegen (
        name: Dateien nach Dialog aktualisieren
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @datei-hinzufuegen
        }

        action dateien-nach-hinzufuegen-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @dateien
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation nummer-eindeutig (
        name: Artikelnummer eindeutig
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 from ARTI_ARTIKEL
                 where ARTI_NUMMER = :P11_ARTI_NUMMER
                   and ARTI_ID <> nvl(:P11_ARTI_ID, -1)
                ```
        }
        error {
            errorMessage: Diese Artikelnummer ist bereits vergeben.
            associatedItem: @P11_ARTI_NUMMER
        }
    )

    process initialize-form-artikel (
        name: Formular Artikel initialisieren
        type: formInitialization
        formRegion: @artikel
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process titel-setzen (
        name: Seitentitel setzen
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P11_TITEL := case when :P11_ARTI_ID is null then 'Neuer Artikel'
                                   else :P11_ARTI_NUMMER || ' – ' || :P11_ARTI_NAME end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
    )

    process process-form-artikel (
        name: Formular Artikel verarbeiten
        type: formAutoRowProcessing
        formRegion: @artikel
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Artikel gespeichert.
        }
    )

    process zusatzwerte-speichern (
        name: Zusatzfelder speichern
        type: executeCode
        editableRegion: @zusatzwerte
        source {
            plsqlCode:
                ```plsql
                -- je Zusatzfeld: Wert speichern bzw. leeren Wert entfernen
                delete from ARTI_ARTIKEL_ZUSATZWERTE
                 where AZUW_ARTI_ID = :P11_ARTI_ID and AZUW_ZUSF_ID = :ZUSF_ID;
                if :AZUW_WERT is not null then
                    insert into ARTI_ARTIKEL_ZUSATZWERTE (AZUW_ARTI_ID, AZUW_ZUSF_ID, AZUW_WERT)
                    values (:P11_ARTI_ID, :ZUSF_ID, :AZUW_WERT);
                end if;
                ```
        }
        execution {
            sequence: 20
        }
    )

    branch nach-anlegen (
        name: Nach dem Anlegen im Artikel bleiben
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 11
                items: {
                    P11_ARTI_ID: &P11_ARTI_ID.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    branch zur-artikelliste (
        name: Zur Artikelliste
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 10
            }
        }
    )

)
