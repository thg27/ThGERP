page 10 (
    name: Artikel
    alias: ARTIKEL
    title: Artikel
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        title: Artikel
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region artikel (
        name: Artikel
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.ARTI_ID,
                       a.ARTI_NUMMER,
                       a.ARTI_NAME,
                       g.AGRP_BEZEICHNUNG as GRUPPE,
                       a.ARTI_VK_PREIS,
                       case a.ARTI_IST_BRUTTO when 'Y' then 'brutto' else 'netto' end as PREISBASIS,
                       e.EINH_CODE as EINHEIT,
                       m.MWST_PROZENT,
                       a.ARTI_EAN,
                       a.ARTI_AUFGENOMMEN_AM,
                       case a.ARTI_IST_AKTIV when 'Y' then 'Ja' else 'Nein' end as ARTI_IST_AKTIV,
                       a.ARTI_UPDATED_ON,
                       a.ARTI_UPDATED_BY
                  from ARTI_ARTIKEL a
                  left join ARTI_ARTIKELGRUPPEN g on g.AGRP_ID = a.ARTI_AGRP_ID
                  left join ALLG_EINHEITEN e on e.EINH_ID = a.ARTI_EINH_ID
                  join ALLG_MWST_SAETZE m on m.MWST_ID = a.ARTI_MWST_ID
                 order by a.ARTI_NUMMER
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 11
                items: {
                    P11_ARTI_ID: #ARTI_ID#
                }
                clearCache: 11
            }
            linkIcon: <span role="img" aria-label="Bearbeiten" class="fa fa-edit" title="Bearbeiten"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Keine Artikel vorhanden.
        }

        column ARTI_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column ARTI_NUMMER (
            type: plainText
            heading {
                heading: Nummer
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column ARTI_NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column GRUPPE (
            type: plainText
            heading {
                heading: Gruppe
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column ARTI_VK_PREIS (
            type: plainText
            heading {
                heading: Verkaufspreis
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            appearance {
                formatMask: FML999G999G990D00
            }
        )

        column PREISBASIS (
            type: plainText
            heading {
                heading: Preis
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column EINHEIT (
            type: plainText
            heading {
                heading: Einheit
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

        column MWST_PROZENT (
            type: plainText
            heading {
                heading: MwSt. %
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

        column ARTI_EAN (
            type: plainText
            heading {
                heading: EAN
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
        )

        column ARTI_AUFGENOMMEN_AM (
            type: plainText
            heading {
                heading: Aufgenommen am
            }
            layout {
                sequence: 100
            }
            source {
                dataType: DATE
            }
        )

        column ARTI_IST_AKTIV (
            type: plainText
            heading {
                heading: Aktiv
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
        )

        column ARTI_UPDATED_ON (
            type: plainText
            heading {
                heading: Geändert am
            }
            layout {
                sequence: 120
            }
            source {
                dataType: TIMESTAMP
            }
        )

        column ARTI_UPDATED_BY (
            type: plainText
            heading {
                heading: Geändert von
            }
            layout {
                sequence: 130
            }
            source {
                dataType: STRING
            }
        )

    )

    button reset-report (
        buttonName: RESET_REPORT
        label: Zurücksetzen
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                t-Button--noUI
                t-Button--iconLeft
                t-Button--gapRight
            ]
            icon: fa-undo-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: &APP_PAGE_ID.
                clearCache: &APP_PAGE_ID.
                action: resetRegions
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button hinzufuegen (
        buttonName: CREATE
        label: Artikel hinzufügen
        layout {
            sequence: 20
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 11
                clearCache: 11
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)
