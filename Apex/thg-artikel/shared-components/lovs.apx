lov lov-boolean (
    name: LOV_BOOLEAN
    source {
        location: staticValues
    }
    subscription {
        master: @/20000/lov-boolean
    }

    entry false (
        sequence: 2
        display: Nein
        return: FALSE
    )

    entry true (
        sequence: 1
        display: Ja
        return: TRUE
    )

)

lov lov-ja-nein (
    name: LOV_JA_NEIN
    source {
        location: staticValues
    }
    subscription {
        master: @/20000/lov-ja-nein
    }

    entry ja (
        sequence: 1
        display: Ja
        return: Y
    )

    entry nein (
        sequence: 2
        display: Nein
        return: N
    )

)

lov lov-artikelgruppen (
    name: LOV_ARTIKELGRUPPEN
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select AGRP_BEZEICHNUNG as d,
                   AGRP_ID as r
              from ARTI_ARTIKELGRUPPEN
             where AGRP_IST_AKTIV = 'Y'
             order by AGRP_SORTIERUNG nulls last, AGRP_BEZEICHNUNG
            ```
    }
    subscription {
        master: @/20000/lov-artikelgruppen
    }
    columnMapping {
        return: R
        display: D
    }
)

lov lov-einheiten (
    name: LOV_EINHEITEN
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select EINH_CODE || ' – ' || EINH_BEZEICHNUNG as d,
                   EINH_ID as r
              from ALLG_EINHEITEN
             where EINH_IST_AKTIV = 'Y'
             order by EINH_SORTIERUNG nulls last, EINH_CODE
            ```
    }
    subscription {
        master: @/20000/lov-einheiten
    }
    columnMapping {
        return: R
        display: D
    }
)

lov lov-mwst-saetze (
    name: LOV_MWST_SAETZE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select to_char(MWST_PROZENT, 'FM990D00') || ' %' as d,
                   MWST_ID as r
              from ALLG_MWST_SAETZE
             where MWST_IST_AKTIV = 'Y'
             order by MWST_SORTIERUNG nulls last, MWST_PROZENT desc
            ```
    }
    subscription {
        master: @/20000/lov-mwst-saetze
    }
    columnMapping {
        return: R
        display: D
    }
)
