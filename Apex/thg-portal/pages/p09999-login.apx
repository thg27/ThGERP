page 9999 (
    name: Login Page
    alias: LOGIN
    title: ThG Portal – Anmeldung
    appearance {
        pageTemplate: @/login
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region firmen (
        name: Firmen
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="thg-login-firmen">
                  <div class="thg-login-firma thg-login-firma--links">
                    <img src="#WORKSPACE_FILES#thg-logo-tg.png" alt="Thomas Geßlbauer GmbH">
                    <div class="thg-login-firma-name">Thomas Geßlbauer GmbH</div>
                    <div>Maierleitn 1, 8661 St. Barbara</div>
                  </div>
                  <div class="thg-login-firma thg-login-firma--rechts">
                    <img src="#WORKSPACE_FILES#thg-logo-edv.png" alt="ThG - edv GmbH">
                    <div class="thg-login-firma-name">ThG - edv GmbH</div>
                    <div>Rosengasse 5, 8650 Kindberg</div>
                  </div>
                </div>
                ```
        }
        layout {
            sequence: 5
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region app-name (
        name: Login
        title: ThG Portal
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/login
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #WORKSPACE_FILES#thg-app-icon.svg
        }
    )

    button anmelden-microsoft (
        buttonName: ANMELDEN_MICROSOFT
        label: Mit Office 365 anmelden
        layout {
            sequence: 10
            region: @app-name
            slot: next
        }
        advanced {
            htmlDomId: thg-anmelden-microsoft
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
            icon: fa-windows
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                request: APEX_AUTHENTICATION=Microsoft Entra ID
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )
)
