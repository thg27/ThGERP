page 20 (
    name: Einstellungen
    alias: EINSTELLUNGEN
    title: Einstellungen
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        title: Einstellungen
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region kein-mitarbeiter (
        name: Kein Mitarbeiter
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Für den Benutzer <strong>&APP_USER.</strong> ist kein Mitarbeiter eingetragen. Bitte an die Administration wenden.</p>
                ```
        }
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/alert
            templateOptions: [
                #DEFAULT#
                t-Alert--warning
            ]
        }
        serverSideCondition {
            type: itemIsNull
            item: P20_MITA_ID
        }
    )

    region mitarbeiter (
        name: Persönliche Daten
        type: form
        source {
            location: localDatabase
            tableName: ALLG_MITARBEITER
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                update
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P20_MITA_ID
        }
    )

    pageItem P20_MITA_ID (
        type: hidden
        layout {
            sequence: 1
            region: @mitarbeiter
            slot: regionBody
        }
        source {
            formRegion: @mitarbeiter
            column: MITA_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P20_MITA_NAME (
        type: textField
        label {
            label: Name
            alignment: left
        }
        layout {
            sequence: 10
            region: @mitarbeiter
            slot: regionBody
            columnSpan: 8
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @mitarbeiter
            column: MITA_NAME
            dataType: varchar2
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
    )

    pageItem P20_MITA_KUERZEL (
        type: displayOnly
        label {
            label: Kürzel
            alignment: left
        }
        layout {
            sequence: 20
            region: @mitarbeiter
            slot: regionBody
            startNewRow: false
            columnSpan: 4
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @mitarbeiter
            column: MITA_KUERZEL
            dataType: varchar2
        }
        settings {
            sendOnPageSubmit: false
        }
    )

    pageItem P20_MITA_MAND_ID (
        type: selectList
        label {
            label: Standard-Mandant beim Login
            alignment: left
        }
        layout {
            sequence: 30
            region: @mitarbeiter
            slot: regionBody
            columnSpan: 4
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @mitarbeiter
            column: MITA_MAND_ID
            dataType: number
        }
        lov {
            type: sharedComponent
            lov: @lov-mandanten
            displayNullValue: true
            nullDisplayValue: - erster aktiver Mandant -
            displayExtraValues: false
        }
    )

    pageItem P20_MITA_BENUTZERNAME (
        type: displayOnly
        label {
            label: Benutzername
            alignment: left
        }
        layout {
            sequence: 40
            region: @mitarbeiter
            slot: regionBody
            startNewRow: false
            columnSpan: 4
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @mitarbeiter
            column: MITA_BENUTZERNAME
            dataType: varchar2
        }
        settings {
            sendOnPageSubmit: false
        }
    )

    region kommunikation (
        name: Kommunikation
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select MKOM_ID, MKOM_MITA_ID, MKOM_KART_ID, MKOM_WERT, MKOM_BEZEICHNUNG, MKOM_IST_BEVORZUGT
                  from ALLG_MITARBEITER_KOMMUNIKATION
                 where MKOM_MITA_ID = :P20_MITA_ID
                ```
            pageItemsToSubmit: [
                P20_MITA_ID
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        messages {
            whenNoDataFound: Keine Kommunikationsdaten erfasst.
        }
        toolbar {
            controls: [
                actionsMenu
                saveButton
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P20_MITA_ID
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )
            displayColumn (
                column: @MKOM_KART_ID
                layout {
                    sequence: 1
                }
            )
            displayColumn (
                column: @MKOM_WERT
                layout {
                    sequence: 2
                }
            )
            displayColumn (
                column: @MKOM_BEZEICHNUNG
                layout {
                    sequence: 3
                }
            )
            displayColumn (
                column: @MKOM_IST_BEVORZUGT
                layout {
                    sequence: 4
                }
            )
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 5
            }
        )

        column MKOM_ID (
            type: hidden
            layout {
                sequence: 10
            }
            source {
                databaseColumn: MKOM_ID
                dataType: number
                primaryKey: true
            }
        )

        column MKOM_MITA_ID (
            type: hidden
            layout {
                sequence: 20
            }
            source {
                databaseColumn: MKOM_MITA_ID
                dataType: number
            }
            default {
                type: item
                item: P20_MITA_ID
            }
        )

        column MKOM_KART_ID (
            type: selectList
            heading {
                heading: Art
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: MKOM_KART_ID
                dataType: number
            }
            validation {
                valueRequired: true
            }
            lov {
                type: sharedComponent
                lov: @lov-kommunikationsarten
                displayNullValue: false
                displayExtraValues: false
            }
        )

        column MKOM_WERT (
            type: textField
            heading {
                heading: Wert
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: MKOM_WERT
                dataType: varchar2
            }
            validation {
                valueRequired: true
                maxLength: 255
            }
        )

        column MKOM_BEZEICHNUNG (
            type: textField
            heading {
                heading: Bezeichnung
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: MKOM_BEZEICHNUNG
                dataType: varchar2
            }
            validation {
                maxLength: 100
            }
        )

        column MKOM_IST_BEVORZUGT (
            type: selectList
            heading {
                heading: Bevorzugt
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: MKOM_IST_BEVORZUGT
                dataType: varchar2
            }
            validation {
                valueRequired: true
            }
            lov {
                type: sharedComponent
                lov: @lov-ja-nein
                displayNullValue: false
                displayExtraValues: false
            }
            default {
                type: static
                staticValue: N
            }
        )
    )

    button save (
        buttonName: SAVE
        label: Speichern
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P20_MITA_ID
        }
    )

    process mitarbeiter-ermitteln (
        name: Eigenen Mitarbeiter ermitteln
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- nur der eigene Datensatz: Mitarbeiter des angemeldeten Benutzers
                select max(MITA_ID)
                  into :P20_MITA_ID
                  from ALLG_MITARBEITER
                 where MITA_BENUTZERNAME = upper(:APP_USER);
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
    )

    process initialize-form-mitarbeiter (
        name: Formular Mitarbeiter initialisieren
        type: formInitialization
        formRegion: @mitarbeiter
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    validation eigener-mitarbeiter (
        name: Nur der eigene Datensatz
        execution {
            sequence: 5
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 from ALLG_MITARBEITER
                 where MITA_ID = :P20_MITA_ID
                   and MITA_BENUTZERNAME = upper(:APP_USER)
                ```
        }
        error {
            errorMessage: Es können nur die eigenen Einstellungen geändert werden.
        }
    )

    process process-form-mitarbeiter (
        name: Formular Mitarbeiter verarbeiten
        type: formAutoRowProcessing
        formRegion: @mitarbeiter
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Einstellungen gespeichert.
        }
    )

    process kommunikation-speichern (
        name: Kommunikation speichern
        type: interactiveGridAutoRowProcessing
        editableRegion: @kommunikation
        execution {
            sequence: 20
        }
    )

    branch zurueck-einstellungen (
        name: Zurück zu den Einstellungen
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 20
            }
        }
    )

)
