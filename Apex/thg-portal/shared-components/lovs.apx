lov lov-rechtsformen (
    name: LOV_RECHTSFORMEN
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select RFRM_KURZ || ' – ' || RFRM_BEZEICHNUNG as d,
                   RFRM_ID as r
              from KUND_RECHTSFORMEN
             order by RFRM_KURZ
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov lov-zahlungsbedingungen (
    name: LOV_ZAHLUNGSBEDINGUNGEN
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select ZBED_BEZEICHNUNG as d,
                   ZBED_ID as r
              from ALLG_ZAHLUNGSBEDINGUNGEN
             order by ZBED_ZIEL_TAGE, ZBED_BEZEICHNUNG
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov lov-kunden (
    name: LOV_KUNDEN
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select KUND_NUMMER || ' – ' ||
                   case KUND_TYP when 'FIRMA' then KUND_FIRMENNAME
                                 else KUND_NACHNAME || nvl2(KUND_VORNAME, ' ' || KUND_VORNAME, null) end as d,
                   KUND_ID as r
              from KUND_KUNDEN
             order by KUND_NUMMER
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov lov-branchen (
    name: LOV_BRANCHEN
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select BRAN_BEZEICHNUNG as d,
                   BRAN_ID as r
              from KUND_BRANCHEN
             where BRAN_IST_AKTIV = 'Y'
             order by BRAN_SORTIERUNG nulls last, BRAN_BEZEICHNUNG
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov lov-kommunikationsarten (
    name: LOV_KOMMUNIKATIONSARTEN
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select KART_BEZEICHNUNG as d,
                   KART_ID as r
              from ALLG_KOMMUNIKATIONSARTEN
             order by KART_SORTIERUNG, KART_BEZEICHNUNG
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov lov-laender (
    name: LOV_LAENDER
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select LAND_BEZEICHNUNG || ' (' || LAND_CODE || ')' as d,
                   LAND_CODE as r
              from ALLG_LAENDER
             where LAND_CODE <> 'XX'
             order by case LAND_CODE when 'AT' then 0 when 'DE' then 1 when 'CH' then 2 else 3 end, LAND_BEZEICHNUNG
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)
