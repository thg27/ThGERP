lov lov-boolean (
    name: LOV_BOOLEAN
    source {
        location: staticValues
    }

    entry false (
        sequence: 2
        display: Nein
        return: FALSE
    )

    entry true (
        sequence: 1
        display: Ja
        return: TRUE
    )

)

lov lov-ja-nein (
    name: LOV_JA_NEIN
    source {
        location: staticValues
    }

    entry ja (
        sequence: 1
        display: Ja
        return: Y
    )

    entry nein (
        sequence: 2
        display: Nein
        return: N
    )

)

