lov lov-apex-benutzer (
    name: LOV_APEX_BENUTZER
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select user_name || nvl2(email, ' (' || email || ')', null) as d,
                   user_name as r
              from apex_workspace_apex_users
             where workspace_name = 'THGERP'
             order by user_name
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov lov-icons (
    name: LOV_ICONS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select d, r, 'fa ' || r as icon
              from (select 'Kacheln' as d, 'fa-th-large' as r, 1 as s from dual
                union all select 'Startseite' as d, 'fa-home' as r, 2 as s from dual
                union all select 'Zahnrad' as d, 'fa-gear' as r, 3 as s from dual
                union all select 'Zahnräder' as d, 'fa-gears' as r, 4 as s from dual
                union all select 'Werkzeug' as d, 'fa-wrench' as r, 5 as s from dual
                union all select 'Adressbuch' as d, 'fa-address-book' as r, 6 as s from dual
                union all select 'Personen' as d, 'fa-users' as r, 7 as s from dual
                union all select 'Person' as d, 'fa-user' as r, 8 as s from dual
                union all select 'Gebäude' as d, 'fa-building-o' as r, 9 as s from dual
                union all select 'Industrie' as d, 'fa-industry' as r, 10 as s from dual
                union all select 'Würfel (Artikel)' as d, 'fa-cube' as r, 11 as s from dual
                union all select 'Würfel (Lager)' as d, 'fa-cubes' as r, 12 as s from dual
                union all select 'Archiv' as d, 'fa-archive' as r, 13 as s from dual
                union all select 'Lieferung' as d, 'fa-truck' as r, 14 as s from dual
                union all select 'Einkaufswagen' as d, 'fa-shopping-cart' as r, 15 as s from dual
                union all select 'Euro' as d, 'fa-eur' as r, 16 as s from dual
                union all select 'Geld' as d, 'fa-money' as r, 17 as s from dual
                union all select 'Kreditkarte' as d, 'fa-credit-card' as r, 18 as s from dual
                union all select 'Rechner' as d, 'fa-calculator' as r, 19 as s from dual
                union all select 'Dokument' as d, 'fa-file-text-o' as r, 20 as s from dual
                union all select 'Ordner' as d, 'fa-folder-open-o' as r, 21 as s from dual
                union all select 'Buch' as d, 'fa-book' as r, 22 as s from dual
                union all select 'Drucker' as d, 'fa-print' as r, 23 as s from dual
                union all select 'Brief' as d, 'fa-envelope-o' as r, 24 as s from dual
                union all select 'Telefon' as d, 'fa-phone' as r, 25 as s from dual
                union all select 'Kalender' as d, 'fa-calendar' as r, 26 as s from dual
                union all select 'Uhr' as d, 'fa-clock-o' as r, 27 as s from dual
                union all select 'Aufgaben' as d, 'fa-tasks' as r, 28 as s from dual
                union all select 'Erledigt' as d, 'fa-check-square-o' as r, 29 as s from dual
                union all select 'Aktentasche' as d, 'fa-briefcase' as r, 30 as s from dual
                union all select 'Balkendiagramm' as d, 'fa-bar-chart' as r, 31 as s from dual
                union all select 'Kreisdiagramm' as d, 'fa-pie-chart' as r, 32 as s from dual
                union all select 'Liniendiagramm' as d, 'fa-line-chart' as r, 33 as s from dual
                union all select 'Tabelle' as d, 'fa-table' as r, 34 as s from dual
                union all select 'Liste' as d, 'fa-list-ul' as r, 35 as s from dual
                union all select 'Etiketten' as d, 'fa-tags' as r, 36 as s from dual
                union all select 'Datenbank' as d, 'fa-database' as r, 37 as s from dual
                union all select 'Server' as d, 'fa-server' as r, 38 as s from dual
                union all select 'Cloud' as d, 'fa-cloud' as r, 39 as s from dual
                union all select 'Globus' as d, 'fa-globe' as r, 40 as s from dual
                union all select 'Ort' as d, 'fa-map-marker' as r, 41 as s from dual
                union all select 'Schloss' as d, 'fa-lock' as r, 42 as s from dual
                union all select 'Schlüssel' as d, 'fa-key' as r, 43 as s from dual)
             order by s
            ```
    }
    columnMapping {
        return: R
        display: D
        icon: ICON
    }
)
