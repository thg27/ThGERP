appProcess mandant-setzen (
    name: Mandant setzen
    type: executeCode
    source {
        plsqlCode:
            ```plsql
            -- Mandant der Sitzung (globale Items MANDANT_*, gelten in allen ThG-Apps):
            --   * Wechsel über die Navigationsleiste (Request MANDANT_<MAND_CODE>)
            --   * sonst beim ersten Aufruf bzw. nach dem Login: Standard-Mandant des Mitarbeiters
            --     (ALLG_MITARBEITER.MITA_MAND_ID), ersatzweise der erste aktive Mandant
            declare
                l_mand_id ADMIN_MANDANTEN.MAND_ID%type;
            begin
                if :REQUEST like 'MANDANT\_%' escape '\' then
                    select max(MAND_ID) into l_mand_id
                      from ADMIN_MANDANTEN
                     where MAND_CODE = substr(:REQUEST, length('MANDANT_') + 1)
                       and MAND_IST_AKTIV = 'Y';
                elsif :MANDANT_ID is null or :MANDANT_BENUTZER is null or :MANDANT_BENUTZER <> :APP_USER then
                    select max(MITA_MAND_ID) into l_mand_id
                      from ALLG_MITARBEITER
                      join ADMIN_MANDANTEN on MAND_ID = MITA_MAND_ID and MAND_IST_AKTIV = 'Y'
                     where MITA_BENUTZERNAME = upper(:APP_USER);
                    if l_mand_id is null then
                        select min(MAND_ID) keep (dense_rank first order by MAND_SORTIERUNG, MAND_NAME) into l_mand_id
                          from ADMIN_MANDANTEN
                         where MAND_IST_AKTIV = 'Y';
                    end if;
                    :MANDANT_BENUTZER := :APP_USER;
                end if;

                if l_mand_id is not null then
                    select MAND_ID, MAND_CODE, MAND_KURZNAME, MAND_LOGO_DATEI
                      into :MANDANT_ID, :MANDANT_CODE, :MANDANT_NAME, :MANDANT_LOGO
                      from ADMIN_MANDANTEN
                     where MAND_ID = l_mand_id;
                end if;
            end;
            ```
    }
    execution {
        sequence: 5
        point: beforeHeader
    }
)

appProcess theme-stil-setzen (
    name: Theme-Stil setzen
    type: executeCode
    source {
        plsqlCode:
            ```plsql
            -- Stilauswahl aus der Navigationsleiste (Request THEME_STYLE_<id>):
            -- setzt den Theme-Stil für alle ThG-Apps aus ADMIN_APPLIKATIONEN (inkl. Portal)
            declare
                l_style_id number;
            begin
                if :REQUEST like 'THEME\_STYLE\_%' escape '\' then
                    l_style_id := to_number(substr(:REQUEST, length('THEME_STYLE_') + 1));
                    for a in (select s.application_id, s.theme_number
                                from apex_application_theme_styles s
                               where s.theme_style_id = l_style_id
                                 and s.is_public = 'Yes'
                                 and s.application_id in (select APPL_APEX_APP_ID from ADMIN_APPLIKATIONEN))
                    loop
                        apex_theme.set_current_style(p_application_id => a.application_id,
                                                     p_theme_number   => a.theme_number,
                                                     p_id             => to_char(l_style_id));
                    end loop;
                end if;
            end;
            ```
    }
    execution {
        sequence: 10
        point: beforeHeader
    }
)
