    dynamicAction cancel-dialog (
        name: Dialog abbrechen
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form-mandant (
        name: Formular Mandant initialisieren
        type: formInitialization
        formRegion: @mandant
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process adresse-laden (
        name: Adresse laden
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                for a in (select * from ALLG_ADRESSEN where ADRE_ID = :P21_MAND_ADRE_ID) loop
                    :P21_ADRE_STRASSE    := a.ADRE_STRASSE;
                    :P21_ADRE_HAUSNUMMER := a.ADRE_HAUSNUMMER;
                    :P21_ADRE_PLZ        := a.ADRE_PLZ;
                    :P21_ADRE_ORT        := a.ADRE_ORT;
                    :P21_ADRE_LAND_CODE  := a.ADRE_LAND_CODE;
                end loop;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P21_MAND_ADRE_ID
        }
    )

    process adresse-speichern (
        name: Adresse speichern
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Firmenadresse in ALLG_ADRESSEN anlegen bzw. aendern (vor dem Speichern des Mandanten).
                -- Neue Adressen: MANUELL nur fuer Laender ohne Adressregister, sonst MIGRATION
                -- (Adressregister AT noch nicht importiert; Trigger ADRE_BIU laesst MANUELL fuer AT nicht zu).
                if :P21_MAND_ADRE_ID is not null then
                    update ALLG_ADRESSEN
                       set ADRE_STRASSE    = :P21_ADRE_STRASSE,
                           ADRE_HAUSNUMMER = :P21_ADRE_HAUSNUMMER,
                           ADRE_PLZ        = :P21_ADRE_PLZ,
                           ADRE_ORT        = :P21_ADRE_ORT,
                           ADRE_LAND_CODE  = :P21_ADRE_LAND_CODE
                     where ADRE_ID = :P21_MAND_ADRE_ID;
                elsif :P21_ADRE_ORT is not null then
                    declare
                        l_quelle ALLG_ADRESSEN.ADRE_QUELLE%type;
                    begin
                        select case LAND_HAT_REGISTER when 'Y' then 'MIGRATION' else 'MANUELL' end
                          into l_quelle
                          from ALLG_LAENDER
                         where LAND_CODE = :P21_ADRE_LAND_CODE;
                        insert into ALLG_ADRESSEN (ADRE_LAND_CODE, ADRE_QUELLE, ADRE_STRASSE, ADRE_HAUSNUMMER, ADRE_PLZ, ADRE_ORT)
                        values (:P21_ADRE_LAND_CODE, l_quelle, :P21_ADRE_STRASSE, :P21_ADRE_HAUSNUMMER, :P21_ADRE_PLZ, :P21_ADRE_ORT)
                        returning ADRE_ID into :P21_MAND_ADRE_ID;
                    end;
                end if;
                ```
        }
        execution {
            sequence: 5
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    process process-form-mandant (
        name: Formular Mandant verarbeiten
        type: formAutoRowProcessing
        formRegion: @mandant
        execution {
            sequence: 10
        }
    )

    process bankverbindungen-speichern (
        name: Bankverbindungen speichern
        type: interactiveGridAutoRowProcessing
        editableRegion: @bankverbindungen
        execution {
            sequence: 20
        }
    )

    process kommunikation-speichern (
        name: Kommunikation speichern
        type: interactiveGridAutoRowProcessing
        editableRegion: @kommunikation
        execution {
            sequence: 30
        }
    )

    process close-dialog (
        name: Dialog schließen
        type: closeDialog
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

)
