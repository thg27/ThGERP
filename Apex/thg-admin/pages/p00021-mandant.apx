                select MBNK_ID, MBNK_MAND_ID, MBNK_BANK, MBNK_IBAN, MBNK_BIC,
                       MBNK_IST_BEVORZUGT, MBNK_IST_AKTIV, MBNK_SORTIERUNG
                  from ADMIN_MANDANT_BANKVERBINDUNGEN
                 where MBNK_MAND_ID = :P21_MAND_ID
                 order by MBNK_SORTIERUNG, MBNK_BANK
