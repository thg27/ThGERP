page 10 (
    name: Applikationen
    alias: APPLIKATIONEN
    title: Applikationen
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        title: Applikationen
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region applikationen (
        name: Applikationen
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select APPL_ID,
                       APPL_SORTIERUNG,
                       APPL_BEZEICHNUNG,
                       APPL_BESCHREIBUNG,
                       APPL_APEX_APP_ID,
                       APPL_APEX_ALIAS,
                       APPL_ZIELSEITE,
                       APPL_ICON,
                       case APPL_IST_AKTIV when 'Y' then 'Ja' else 'Nein' end as APPL_IST_AKTIV,
                       APPL_UPDATED_ON,
                       APPL_UPDATED_BY
                  from ADMIN_APPLIKATIONEN
                 order by APPL_SORTIERUNG, APPL_BEZEICHNUNG
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 11
                items: {
                    P11_APPL_ID: #APPL_ID#
                }
                clearCache: 11
            }
            linkIcon: <span role="img" aria-label="Bearbeiten" class="fa fa-edit" title="Bearbeiten"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Keine Applikationen vorhanden.
        }

        column APPL_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column APPL_SORTIERUNG (
            type: plainText
            heading {
                heading: Sortierung
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

        column APPL_BEZEICHNUNG (
            type: plainText
            heading {
                heading: Bezeichnung
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column APPL_BESCHREIBUNG (
            type: plainText
            heading {
                heading: Beschreibung
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column APPL_APEX_APP_ID (
            type: plainText
            heading {
                heading: App-ID
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

        column APPL_APEX_ALIAS (
            type: plainText
            heading {
                heading: App-Alias
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column APPL_ZIELSEITE (
            type: plainText
            heading {
                heading: Zielseite
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

        column APPL_ICON (
            type: plainText
            heading {
                heading: Icon
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
        )

        column APPL_IST_AKTIV (
            type: plainText
            heading {
                heading: Aktiv
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
        )

        column APPL_UPDATED_ON (
            type: plainText
            heading {
                heading: Geändert am
            }
            layout {
                sequence: 100
            }
            source {
                dataType: TIMESTAMP
            }
        )

        column APPL_UPDATED_BY (
            type: plainText
            heading {
                heading: Geändert von
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
        )

    )

    button up (
        buttonName: UP
        label: Zurück zur Administration
        layout {
            sequence: 10
            region: @breadcrumb
            slot: up
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-arrow-up
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset-report (
        buttonName: RESET_REPORT
        label: Zurücksetzen
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                t-Button--noUI
                t-Button--iconLeft
                t-Button--gapRight
            ]
            icon: fa-undo-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: &APP_PAGE_ID.
                clearCache: &APP_PAGE_ID.
                action: resetRegions
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button hinzufuegen (
        buttonName: CREATE
        label: Applikation hinzufügen
        layout {
            sequence: 20
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconRight
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 11
                clearCache: 11
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh-nach-dialog (
        name: Bericht nach Dialog aktualisieren
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @applikationen
        }

        action refresh-bericht (
            action: refresh
            affectedElements {
                selectionType: region
                region: @applikationen
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-nach-hinzufuegen (
        name: Bericht nach Hinzufügen aktualisieren
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @hinzufuegen
        }

        action refresh-bericht-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @applikationen
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
