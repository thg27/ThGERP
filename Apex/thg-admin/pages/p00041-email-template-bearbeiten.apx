page 41 (
    name: E-Mail-Template bearbeiten
    alias: EMAIL-TEMPLATE-BEARBEITEN
    title: E-Mail-Template
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1100
        chained: false
        resizable: true
    }
    navigation {
        cursorFocus: firstItemOnPage
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region vorlage (
        name: E-Mail-Template
        type: form
        source {
            location: localDatabase
            tableName: FAKT_MAIL_VORLAGEN
        }
        layout {
            sequence: 10
            slot: contentBody
            columnSpan: 8
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region platzhalter (
        name: Platzhalter
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Werden beim Versand durch die Werte der Rechnung ersetzt (in der Vorschau noch änderbar):</p>
                <ul>
                  <li><code>#ANREDE#</code> – Sehr geehrter Herr … / Sehr geehrte Frau … (Ansprechpartner der Rechnung), sonst Sehr geehrte Damen und Herren,</li>
                  <li><code>#RECHNUNGSNUMMER#</code> – Rechnungsnummer (auch im Betreff)</li>
                  <li><code>#RECHNUNGSDATUM#</code> – Rechnungsdatum</li>
                  <li><code>#BETRAG#</code> – Rechnungsbetrag brutto</li>
                  <li><code>#FAELLIG_AM#</code> – Fälligkeit</li>
                  <li><code>#ZAHLUNGSHINWEIS#</code> – Absatz mit offenem Betrag, Fälligkeit, Konto und Zahlungsreferenz (bzw. „bereits beglichen“)</li>
                  <li><code>#KUNDE#</code> – Name des Rechnungsempfängers</li>
                  <li><code>#ABSENDER#</code> – Name des angemeldeten Mitarbeiters</li>
                </ul>
                <p>Absender ist immer der angemeldete Mitarbeiter (Office-365-Adresse), Empfänger die Rechnungs-E-Mail des Kunden.</p>
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P41_MVOR_ID (
        type: hidden
        layout {
            sequence: 1
            region: @vorlage
            slot: regionBody
        }
        source {
            formRegion: @vorlage
            column: MVOR_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P41_MVOR_MAND_ID (
        type: selectList
        label {
            label: Mandant
            alignment: left
        }
        layout {
            sequence: 10
            region: @vorlage
            slot: regionBody
            columnSpan: 6
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @vorlage
            column: MVOR_MAND_ID
            dataType: number
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @lov-mandanten
            displayNullValue: true
            nullDisplayValue: - Mandant wählen -
            displayExtraValues: false
        }
    )

    pageItem P41_MVOR_BELEGART (
        type: selectList
        label {
            label: Typ
            alignment: left
        }
        layout {
            sequence: 20
            region: @vorlage
            slot: regionBody
            startNewRow: false
            columnSpan: 6
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @vorlage
            column: MVOR_BELEGART
            dataType: varchar2
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @lov-mail-typ
            displayNullValue: true
            nullDisplayValue: - Typ wählen -
            displayExtraValues: false
        }
    )

    pageItem P41_MVOR_BCC (
        type: textField
        label {
            label: Bcc (immer)
            alignment: left
        }
        layout {
            sequence: 30
            region: @vorlage
            slot: regionBody
            columnSpan: 12
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @vorlage
            column: MVOR_BCC
            dataType: varchar2
        }
        validation {
            maxLength: 1000
        }
        help {
            helpText: Blindkopie jeder E-Mail dieses Typs, z. B. office@thg-edv.com. Mehrere Adressen mit ; trennen.
        }
    )

    pageItem P41_MVOR_BETREFF (
        type: textField
        label {
            label: Betreff
            alignment: left
        }
        layout {
            sequence: 40
            region: @vorlage
            slot: regionBody
            columnSpan: 12
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @vorlage
            column: MVOR_BETREFF
            dataType: varchar2
        }
        validation {
            valueRequired: true
            maxLength: 500
        }
    )

    pageItem P41_MVOR_TEXT (
        type: richTextEditor
        label {
            label: Text
            alignment: left
        }
        layout {
            sequence: 50
            region: @vorlage
            slot: regionBody
            columnSpan: 12
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @vorlage
            column: MVOR_TEXT
            dataType: clob
        }
        validation {
            valueRequired: true
        }
        settings {
            format: html
            toolbar: full
        }
        advanced {
            initJavaScriptFunction:
                ```javascript-browser
                function (options) {
                    options.editorOptions = options.editorOptions || {};
                    options.editorOptions.toolbar = {
                        items: ["heading", "|", "bold", "italic", "|", "bulletedList", "numberedList", "|", "undo", "redo"]
                    };
                    return options;
                }
                ```
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Abbrechen
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Löschen
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P41_MVOR_ID
        }
        confirmation {
            message: E-Mail-Template wirklich löschen? Ohne Template ist für diesen Mandanten kein Versand dieses Typs möglich.
            style: danger
        }
    )

    button save (
        buttonName: SAVE
        label: Speichern
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P41_MVOR_ID
        }
    )

    button create (
        buttonName: CREATE
        label: Anlegen
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P41_MVOR_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Dialog abbrechen
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation mandant-typ-eindeutig (
        name: Je Mandant und Typ nur ein Template
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 from FAKT_MAIL_VORLAGEN
                 where MVOR_MAND_ID = :P41_MVOR_MAND_ID
                   and MVOR_BELEGART = :P41_MVOR_BELEGART
                   and MVOR_ID <> nvl(:P41_MVOR_ID, -1)
                ```
        }
        error {
            errorMessage: Für diesen Mandanten gibt es bereits ein Template dieses Typs.
            associatedItem: @P41_MVOR_BELEGART
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    process initialize-form-vorlage (
        name: Formular E-Mail-Template initialisieren
        type: formInitialization
        formRegion: @vorlage
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form-vorlage (
        name: Formular E-Mail-Template verarbeiten
        type: formAutoRowProcessing
        formRegion: @vorlage
        execution {
            sequence: 10
        }
    )

    process close-dialog (
        name: Dialog schließen
        type: closeDialog
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

)
