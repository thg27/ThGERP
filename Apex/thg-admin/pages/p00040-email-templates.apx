page 40 (
    name: E-Mail-Templates
    alias: EMAIL-TEMPLATES
    title: E-Mail-Templates
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        title: E-Mail-Templates
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region vorlagen (
        name: E-Mail-Templates
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.MVOR_ID,
                       m.MAND_NAME as MANDANT,
                       case v.MVOR_BELEGART when 'RECHNUNG' then 'Rechnungsversand' else v.MVOR_BELEGART end as TYP,
                       v.MVOR_BETREFF,
                       v.MVOR_BCC,
                       v.MVOR_UPDATED_ON,
                       v.MVOR_UPDATED_BY
                  from FAKT_MAIL_VORLAGEN v
                  join ADMIN_MANDANTEN m on m.MAND_ID = v.MVOR_MAND_ID
                 order by m.MAND_SORTIERUNG, m.MAND_NAME, TYP
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 41
                items: {
                    P41_MVOR_ID: #MVOR_ID#
                }
                clearCache: 41
            }
            linkIcon: <span role="img" aria-label="Bearbeiten" class="fa fa-edit" title="Bearbeiten"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Keine E-Mail-Templates vorhanden.
        }

        column MVOR_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column MANDANT (
            type: plainText
            heading {
                heading: Mandant
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column TYP (
            type: plainText
            heading {
                heading: Typ
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column MVOR_BETREFF (
            type: plainText
            heading {
                heading: Betreff
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column MVOR_BCC (
            type: plainText
            heading {
                heading: Bcc (immer)
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column MVOR_UPDATED_ON (
            type: plainText
            heading {
                heading: Geändert am
            }
            layout {
                sequence: 60
            }
            source {
                dataType: TIMESTAMP
            }
        )

        column MVOR_UPDATED_BY (
            type: plainText
            heading {
                heading: Geändert von
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

    )

    button up (
        buttonName: UP
        label: Zurück zur Administration
        layout {
            sequence: 10
            region: @breadcrumb
            slot: up
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-arrow-up
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button hinzufuegen (
        buttonName: CREATE
        label: E-Mail-Template hinzufügen
        layout {
            sequence: 20
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconRight
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 41
                clearCache: 41
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh-nach-dialog (
        name: Bericht nach Dialog aktualisieren
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @vorlagen
        }

        action refresh-nach-dialog-aktion (
            action: refresh
            affectedElements {
                selectionType: region
                region: @vorlagen
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-nach-hinzufuegen (
        name: Bericht nach Dialog aktualisieren
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @hinzufuegen
        }

        action refresh-nach-hinzufuegen-aktion (
            action: refresh
            affectedElements {
                selectionType: region
                region: @vorlagen
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
