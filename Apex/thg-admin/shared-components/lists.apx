list navigation-bar (
    name: Navigation Bar

    entry --- (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry sign-out (
        label: Abmelden
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry portal (
        label: Portal
        icon {
            imageIconCssClasses: fa-th-large
        }
        layout {
            sequence: 5
        }
        link {
            target: {
                type: url
                url: f?p=THG-PORTAL:HOME:&SESSION.::&DEBUG.
            }
        }
    )

    entry home (
        label: Administration
        icon {
            imageIconCssClasses: fa-gears
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

)

list admin-konfiguration (
    name: Admin - Konfiguration

    entry applikationen (
        label: Applikationen
        icon {
            imageIconCssClasses: fa-th-large
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 10
                clearCache: 10
            }
        }
        userDefinedAttributes {
            1: Module/Apps, die im Portal als Kacheln angezeigt werden (Bezeichnung, Icon, Reihenfolge, aktiv)
        }
    )

    entry mandanten (
        label: Mandanten
        icon {
            imageIconCssClasses: fa-building-o
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 20
                clearCache: 20
            }
        }
        userDefinedAttributes {
            1: Firmen (ThG - edv GmbH, Thomas Geßlbauer GmbH): Firmendaten, Adresse, Bankverbindungen, Kommunikation für Briefkopf und Rechnung
        }
    )

    entry mitarbeiter (
        label: Mitarbeiter
        icon {
            imageIconCssClasses: fa-users
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 30
                clearCache: 30
            }
        }
        userDefinedAttributes {
            1: Eigene Mitarbeiter: Kürzel, Name, Login (APEX-Benutzer), Standard-Mandant, Kommunikation
        }
    )

)

list admin-monitoring (
    name: Admin - Monitoring

    entry aktivitaetsprotokoll (
        label: Aktivitätsprotokoll
        icon {
            imageIconCssClasses: fa-table-clock
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 50
                clearCache: 50
            }
        }
        userDefinedAttributes {
            1: Seitenaufrufe und Fehler der ThG-Apps aus dem APEX-Aktivitätsprotokoll
        }
    )

)
