lov lov-boolean (
    name: LOV_BOOLEAN
    source {
        location: staticValues
    }
    subscription {
        master: @/20000/lov-boolean
    }

    entry false (
        sequence: 2
        display: Nein
        return: FALSE
    )

    entry true (
        sequence: 1
        display: Ja
        return: TRUE
    )

)

lov lov-ja-nein (
    name: LOV_JA_NEIN
    source {
        location: staticValues
    }
    subscription {
        master: @/20000/lov-ja-nein
    }

    entry ja (
        sequence: 1
        display: Ja
        return: Y
    )

    entry nein (
        sequence: 2
        display: Nein
        return: N
    )

)

lov lov-kommunikationsarten (
    name: LOV_KOMMUNIKATIONSARTEN
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select KART_BEZEICHNUNG as d,
                   KART_ID as r
              from ALLG_KOMMUNIKATIONSARTEN
             order by KART_SORTIERUNG, KART_BEZEICHNUNG
            ```
    }
    subscription {
        master: @/20000/lov-kommunikationsarten
    }
    columnMapping {
        return: R
        display: D
    }
)

lov lov-laender (
    name: LOV_LAENDER
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select LAND_BEZEICHNUNG || ' (' || LAND_CODE || ')' as d,
                   LAND_CODE as r
              from ALLG_LAENDER
             where LAND_CODE <> 'XX'
             order by case LAND_CODE when 'AT' then 0 when 'DE' then 1 when 'CH' then 2 else 3 end, LAND_BEZEICHNUNG
            ```
    }
    subscription {
        master: @/20000/lov-laender
    }
    columnMapping {
        return: R
        display: D
    }
)

lov lov-apex-benutzer (
    name: LOV_APEX_BENUTZER
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select user_name || nvl2(email, ' (' || email || ')', null) as d,
                   user_name as r
              from apex_workspace_apex_users
             where workspace_name = 'THGERP'
             order by user_name
            ```
    }
    subscription {
        master: @/20000/lov-apex-benutzer
    }
    columnMapping {
        return: R
        display: D
    }
)

lov lov-mandanten (
    name: LOV_MANDANTEN
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select MAND_NAME as d,
                   MAND_ID as r
              from ADMIN_MANDANTEN
             where MAND_IST_AKTIV = 'Y'
             order by MAND_SORTIERUNG, MAND_NAME
            ```
    }
    subscription {
        master: @/20000/lov-mandanten
    }
    columnMapping {
        return: R
        display: D
    }
)

